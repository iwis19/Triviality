{
  "roles": [
    {
      "id": "coordinator",
      "label": "Coordinator",
      "description": "Plans the investigation and recovers failed assignments."
    },
    {
      "id": "researcher",
      "label": "Researcher",
      "description": "Develops a constructive proof approach."
    },
    {
      "id": "challenger",
      "label": "Counterexample researcher",
      "description": "Challenges assumptions and searches for counterexamples."
    },
    {
      "id": "critic",
      "label": "Critic",
      "description": "Reviews evidence and requests revisions."
    },
    {
      "id": "proof_writer",
      "label": "Proof writer",
      "description": "Writes and repairs the formal proof using Lean feedback."
    }
  ],
  "defaultModel": "openai/gpt-5.6-sol",
