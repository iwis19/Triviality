import Mathlib

/-!
Erdős #677, the case k = 2, with the lcm of the interval {n+1, ..., n+k} defined via
`Finset.Ico`.  `lcmInterval n k = lcm (n+1) ... (n+k)`.
-/


def lcmInterval (n k : ℕ) : ℕ := (Finset.Ico (n + 1) (n + k + 1)).lcm id

lemma Ico_two (n : ℕ) : Finset.Ico (n + 1) (n + 2 + 1) = {n + 1, n + 2} := by
  ext x
  simp only [Finset.mem_Ico, Finset.mem_insert, Finset.mem_singleton]
  omega

lemma coprime_succ_succ (n : ℕ) : Nat.Coprime (n + 1) (n + 2) := by
  have : n + 2 = (n + 1) + 1 := by ring
  rw [this, Nat.coprime_self_add_right]
  exact Nat.coprime_one_right _

lemma lcmInterval_two (n : ℕ) : lcmInterval n 2 = (n + 1) * (n + 2) := by
  unfold lcmInterval
  rw [Ico_two, Finset.lcm_insert, Finset.lcm_singleton]
  simp only [id, normalize_eq]
  exact Nat.Coprime.lcm_eq_mul (coprime_succ_succ n)

theorem erdos_677_k2 (m n : ℕ) (h : m ≥ n + 2) : lcmInterval m 2 ≠ lcmInterval n 2 := by
  rw [lcmInterval_two, lcmInterval_two]
  have : (n + 1) * (n + 2) < (m + 1) * (m + 2) := by nlinarith
  omega

