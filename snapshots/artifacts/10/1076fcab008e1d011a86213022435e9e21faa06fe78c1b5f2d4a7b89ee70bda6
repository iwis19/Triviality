"""Delsarte LP bounds for spherical codes via discretised constraints + scipy linprog.

Bound:  N <= f(1)/f_0 for f = sum_k f_k G_k^{(n)}, f_k>=0, f_0>0, f(t)<=0 on [-1, s].
Variants: 'lines' (only even k; constraint on |t|<=s) gives a bound on the number of
lines with |cos|<=s, so antipodal codes have size <= 2*bound.
"""
import numpy as np
from scipy.optimize import linprog
from scipy.special import eval_gegenbauer


def gegen(n, k, t):
    a = (n - 2) / 2.0
    if abs(a) < 1e-12:  # n=2, Chebyshev
        return np.cos(k * np.arccos(np.clip(t, -1, 1)))
    return eval_gegenbauer(k, a, t) / eval_gegenbauer(k, a, 1.0)


def lp_bound(n, s, deg, mode="code", grid=4001):
    ks = list(range(0, deg + 1)) if mode == "code" else list(range(0, deg + 1, 2))
    lo = -1.0 if mode == "code" else -s
    ts = np.linspace(lo, s, grid)
    # normalise f_0 = 1, minimise f(1) = sum f_k  (since G_k(1)=1)
    A = np.array([[gegen(n, k, t) for k in ks] for t in ts])
    c = np.ones(len(ks))
    bounds = [(1, 1)] + [(0, None)] * (len(ks) - 1)
    res = linprog(c, A_ub=A, b_ub=np.zeros(len(ts)), bounds=bounds, method="highs")
    return res.fun, dict(zip(ks, res.x))


if __name__ == "__main__":
    print("Delsarte LP, n=5, cos<=1/2 (kissing):")
    for d in (8, 10, 12, 14, 16):
        v, _ = lp_bound(5, 0.5, d)
        print(f"  deg {d}: {v:.4f}")
    print("Delsarte LP, n=4, cos<=1/2 (kissing, sanity, known 25.56):")
    v, _ = lp_bound(4, 0.5, 12); print(f"  deg 12: {v:.4f}")
    print("Delsarte LP, n=4, cos<=1/3 (60-deg-neighbour set of a point in a 5-dim kissing config):")
    for d in (8, 12, 16):
        v, _ = lp_bound(4, 1/3, d); print(f"  deg {d}: {v:.4f}")
    print("Lines in R^5 with |cos|<=1/2 (antipodal kissing configs have size <= 2x this):")
    for d in (8, 12, 16, 20):
        v, _ = lp_bound(5, 0.5, d, mode="lines"); print(f"  deg {d}: {v:.4f}  -> antipodal N <= {2*v:.4f}")
    print("Lines in R^4 with |cos|<=1/2 (sanity; D4 gives 12):")
    v, _ = lp_bound(4, 0.5, 16, mode="lines"); print(f"  deg 16: {v:.4f}")
