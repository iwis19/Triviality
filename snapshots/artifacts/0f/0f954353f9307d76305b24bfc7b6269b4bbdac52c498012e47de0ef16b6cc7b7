"""
Critic experiment for idea 8b81b9b7 ("parity-breaking sieve for {N-p}").

Question: if one had a Type II *asymptotic* for the Buchstab terms
    S(A_q, q) = #{p < N : N - p = q m, m has no prime factor < q},   q ~ N^theta,
for theta in a window [theta0, theta1] (this is at least as strong as claim L2,
which only asks for m prime -- the two agree for theta > 1/3), and only
Type I (Bombieri-Vinogradov, level D = N^{1/2}) information elsewhere,
does a one-step Buchstab + Chen switching scheme give r(N) > 0 ?

All quantities are in units of HL(N) = S(N) N / log^2 N.
Model (own reasoning, standard linear-sieve heuristics; each ingredient is a
known theorem when the corresponding Type I input is BV, EXCEPT the Type II
asymptotic which is the hypothesis being tested):

  r(N) = S(A, N^{1/2}) = S(A, z) - sum_{z <= q < N^{1/2}} S(A_q, q),  z = N^{1/(2s)}

  S(A, z)      >= f(s) * 2 s e^{-gamma}                      (linear sieve lower bound, level N^{1/2})
  S(A_q,q), q~N^theta:
     Type II window   : exact value  omega((1-theta)/theta) dtheta / theta^2
     direct upper     : e^{-gamma} F((1/2-theta)/theta) dtheta/theta^2, F(s)=2e^gamma/s for s<=3
                        (for s<1 one sieves only up to D/q, same formula)
     switched upper   : 4 dtheta / (theta (1-theta))   (Chen switching: sieve N - q1 q2 with level N^{1/2}, F(1)=2e^gamma)
     we take min(direct, switched) outside the window.

Buchstab identity check: int_{1/(2s)}^{1/2} omega((1-theta)/theta) dtheta/theta^2 = 2 s omega(2s) - 1.
"""
import math
import numpy as np

EG = math.exp(0.5772156649015329)

# ---- linear sieve functions F, f on a grid via (sF)' = f(s-1), (sf)' = F(s-1) ----
H = 1e-4
SMAX = 40.0
grid = np.arange(0.0, SMAX + H, H)
sF = np.zeros_like(grid)  # s*F(s)
sf = np.zeros_like(grid)  # s*f(s)
for i, s in enumerate(grid):
    if s <= 3:
        sF[i] = 2 * EG if s >= 1 else 2 * EG  # F(s)=2e^g/s for 1<=s<=3; for s<1 use F(1)-type bound (sieve to smaller level)
    else:
        j = int(round((s - 1) / H))
        sF[i] = sF[i - 1] + H * (sf[j] / grid[j])
    if s <= 2:
        sf[i] = 0.0
    else:
        j = int(round((s - 1) / H))
        sf[i] = sf[i - 1] + H * (sF[j] / grid[j])

def F(s):
    if s <= 0:
        return float('inf')
    if s < 1:
        return 2 * EG / s  # sieve only to level (D/q): S(A_q,q) <= S(A_q, D/q) <= F(1) V(D/q) ... = (2e^g/s) V(q)
    i = min(int(round(s / H)), len(grid) - 1)
    return sF[i] / grid[i]

def f(s):
    if s <= 2:
        return 0.0
    i = min(int(round(s / H)), len(grid) - 1)
    return sf[i] / grid[i]

# ---- Buchstab omega on a grid: omega(u)=1/u on [1,2], (u omega)' = omega(u-1) ----
UMAX = 80.0
ug = np.arange(1.0, UMAX + H, H)
uo = np.zeros_like(ug)
for i, u in enumerate(ug):
    if u <= 2:
        uo[i] = 1.0
    else:
        j = int(round((u - 2) / H))  # index of u-1
        uo[i] = uo[i - 1] + H * (uo[j] / ug[j])

def omega(u):
    if u < 1:
        return 0.0
    i = min(int(round((u - 1) / H)), len(ug) - 1)
    return uo[i] / ug[i]

def sanity():
    print("F(1)=%.4f (2e^g=%.4f)  F(2)=%.4f  F(3)=%.4f  f(3)=%.4f (=%.4f)  f(4)=%.4f  f(5)=%.4f  F(5)=%.4f" % (
        F(1), 2 * EG, F(2), F(3), f(3), 2 * EG * math.log(2) / 3, f(4), f(5), F(5)))
    print("omega(2)=%.4f omega(3)=%.4f omega(6)=%.4f omega(20)=%.5f e^-g=%.5f" % (
        omega(2), omega(3), omega(6), omega(20), 1 / EG))
    for s in (2.0, 3.0, 5.0):
        th = np.linspace(1 / (2 * s), 0.5, 20001)
        val = np.trapezoid([omega((1 - t) / t) / t**2 for t in th], th)
        print("Buchstab check s=%.1f: integral=%.5f  2s*omega(2s)-1=%.5f" % (s, val, 2 * s * omega(2 * s) - 1))

def exact_density(t):
    return omega((1 - t) / t) / t**2

def upper_density(t):
    direct = F((0.5 - t) / t) / EG / t**2 if t < 0.5 else float('inf')
    switched = 4.0 * exact_density(t)   # Chen switching: sieve {N - q m} (m q-rough) to level N^{1/2}, F(1)=2e^gamma
    return min(direct, switched)

def lower_bound(s, th0, th1, n=4001):
    """Lower bound for r(N)/HL(N) with Type II window [th0,th1] (clipped to [1/(2s),1/2])."""
    a = 1 / (2 * s)
    lb = f(s) * 2 * s / EG
    th = np.linspace(a, 0.5 - 1e-9, n)
    dens = []
    for t in th:
        if th0 <= t <= th1:
            dens.append(exact_density(t))
        else:
            dens.append(upper_density(t))
    lb -= np.trapezoid(dens, th)
    return lb

def chen_style_check():
    # Reproduce the shape of Chen's P_2 count (weights 1/2 on Buchstab terms in [1/10,1/3], 1/2 on Omega)
    # NOT Chen's exact argument (he sieves A_q only to N^{1/10}); indicative only.
    s = 5.0
    lb = f(s) * 2 * s / EG
    th = np.linspace(0.1, 1 / 3, 2001)
    lb -= 0.5 * np.trapezoid([F((0.5 - t) / t) / EG / t**2 for t in th], th)
    th2 = np.linspace(1 / 3, 0.5 - 1e-9, 2001)
    lb -= 0.5 * np.trapezoid([4.0 / (t * (1 - t)) for t in th2], th2)
    print("Chen-shaped P_2 lower bound (indicative, weights 1/2): %.3f HL  (Chen 1973 obtained ~0.67 HL with a sharper treatment)" % lb)

if __name__ == "__main__":
    sanity()
    chen_style_check()
    print()
    print("Type I only (no Type II window):")
    for s in (2.5, 3, 4, 5, 6, 8, 10, 15, 20, 30):
        print("  s=%.1f  LB=%.3f" % (s, lower_bound(s, 1, 0)))
    print()
    print("Full Type II window [1/(2s),1/2] (best case, = truth of Buchstab terms):")
    for s in (2.5, 3, 4, 5, 6, 8):
        print("  s=%.1f  LB=%.3f   (truth S(A,z)/HL = %.3f, sieve LB = %.3f)" % (
            s, lower_bound(s, 0, 1), 2 * s * omega(2 * s), f(s) * 2 * s / EG))
    print()
    print("Scan of Type II windows [th0,th1]; report best LB over s in [2,10]:")
    svals = np.arange(2.0, 10.01, 0.25)
    rows = []
    for th0 in np.arange(0.05, 0.50, 0.05):
        for th1 in np.arange(th0 + 0.05, 0.5001, 0.05):
            best = max((lower_bound(s, th0, th1, n=1201), s) for s in svals)
            rows.append((th0, th1, best[0], best[1]))
    for th0, th1, lb, s in rows:
        flag = " <-- positive" if lb > 0 else ""
        print("  window [%.2f,%.2f]  best LB=%+.3f at s=%.2f%s" % (th0, th1, lb, s, flag))
    print()
    print("Minimal-length windows with positive LB (step 0.01):")
    found = []
    for L in np.arange(0.02, 0.5, 0.01):
        ok = []
        for th0 in np.arange(0.0, 0.5 - L + 1e-9, 0.01):
            th1 = th0 + L
            best = max(lower_bound(s, th0, th1, n=801) for s in np.arange(2.0, 10.01, 0.5))
            if best > 0:
                ok.append((round(th0, 2), round(th1, 2), round(best, 3)))
        if ok:
            print("  length %.2f: %s" % (L, ok))
            found.append((L, ok))
            if len(found) >= 4:
                break
