#!/usr/bin/env python3
"""Analyze enumeration outputs: tight instances, lonely-time denominators,
spectrum below 1/n (Kravitz / Fan-Sun form s/(ns+k)), minimal modulus m*."""
import json, glob, math
from fractions import Fraction
from collections import Counter, defaultdict

for fn in sorted([f for f in glob.glob("/home/ubuntu/lrc/enum_n*_B*.json") if "sos" not in f], key=lambda s: int(s.split("_n")[1].split("_")[0])):
    d = json.load(open(fn)); n, B, S = d["n"], d["B"], d["sets"]
    print(f"\n=== n={n} (k={n+1}) speeds<=B={B}, {len(S)} gcd-1 sets ===")
    tight = [r for r in S if r["tight"]]
    print("tight instances:", [r["v"] for r in tight])
    for r in tight:
        ts = [Fraction(*t) for t in r["times"]]
        dens = sorted(set(t.denominator for t in ts))
        res = [[x % (n + 1) for x in r["v"]]]
        print(f"  v={r['v']} lonely times={[str(t) for t in ts]} denominators={dens} residues mod {n+1}={res[0]}")
    # spectrum below 1/n
    below = defaultdict(list)
    for r in S:
        ml = Fraction(*r["ml"])
        if ml < Fraction(1, n):
            below[ml].append(r["v"])
    print(f"distinct ML values < 1/n: {len(below)}")
    kc = Counter()
    for ml in sorted(below):
        p, q = ml.numerator, ml.denominator
        k = q - n * p  # ml = p/(np+k)
        kc[k] += 1
        ex = below[ml][:3]
        print(f"  ML={ml} = s/(ns+k) with s={p},k={k}; #sets={len(below[ml])} e.g. {ex}")
    print("  k-distribution (k=1 is Kravitz discrete part):", dict(kc))
    # minimal modulus statistics
    ratios = [(r["mstar"], max(r["v"]), r["v"]) for r in S if r["mstar"] is not None]
    none = sum(1 for r in S if r["mstar"] is None)
    mx = max(ratios, key=lambda x: x[0] / x[1])
    print(f"m* (min modulus of a time a/m certifying 1/(n+1)): none-found={none}, max m*={max(x[0] for x in ratios)}, "
          f"max m*/maxspeed={mx[0]}/{mx[1]} at v={mx[2]}")
    cnt = Counter(r["mstar"] for r in S)
    small = sum(c for m, c in cnt.items() if m is not None and m <= n + 1)
    print(f"  fraction with m* <= n+1: {small/len(S):.4f}; with m* <= 2(n+1): {sum(c for m,c in cnt.items() if m is not None and m <= 2*(n+1))/len(S):.4f}")
    # ML distribution summary
    mlc = Counter(Fraction(*r["ml"]) for r in S)
    print(f"  ML=1/2 fraction: {mlc[Fraction(1,2)]/len(S):.4f}; #distinct ML values: {len(mlc)}")
