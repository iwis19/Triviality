// Exact covering test for the lonely runner conjecture, k = 8 (7 positive integer speeds, one stationary).
// delta = 1/8. Bad set of runner v: {t in [0,1) : ||v t|| < 1/8} = union_j ((8j-1)/(8v), (8j+1)/(8v)).
// Scale to common denominator D = 8*lcm(v_i): endpoints are integers.
//   open-cover test  : exists t with ||v_i t|| >= 1/8 for all i  <=> open intervals fail to cover  <=> ML(v) >= 1/8
//   closed-cover test: closed intervals cover                    <=> ML(v) <= 1/8
// Reports counts of sets with ML<1/8 (would be counterexamples), ML=1/8 (tight), ML>1/8.
// Only gcd=1 sets are tested (ML is invariant under scaling the speed set).
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#ifndef K
#define K 7
#endif
typedef long long ll;
static ll gcdll(ll a, ll b){ while(b){ ll t=a%b; a=b; b=t;} return a; }

typedef struct { ll s, e; } iv;
static int cmp(const void*a,const void*b){ ll x=((iv*)a)->s, y=((iv*)b)->s; return (x<y)?-1:(x>y); }

static iv buf[8*64+16];

// returns 1 if [0,D] is covered (open=1: open intervals; open=0: closed intervals)
static int covered(const int*v, int open){
    ll L=1; for(int i=0;i<K;i++) L = L/gcdll(L,v[i])*v[i];
    ll D=(K+1)*L; int m=0;
    for(int i=0;i<K;i++){ ll u=D/((K+1)*v[i]); for(int j=0;j<=v[i];j++){ buf[m].s=((K+1)*j-1)*u; buf[m].e=((K+1)*j+1)*u; m++; } }
    qsort(buf,m,sizeof(iv),cmp);
    ll cur=0; // point to be covered next; buf[0].s<0 always
    for(int i=0;i<m;i++){
        if(open ? (buf[i].s>=cur) : (buf[i].s>cur)) return 0; // uncovered point at cur (open) or in (cur, s) (closed)
        if(buf[i].e>cur) cur=buf[i].e;
        if(cur>=D) return 1;
    }
    return cur>=D;
}

int main(int argc,char**argv){
    int Nmin=atoi(argv[1]), Nmax=atoi(argv[2]);
    for(int N=Nmin; N<=Nmax; N++){
        clock_t t0=clock();
        ll total=0, tested=0, lt=0, eq=0, gt=0;
        int v[K];
        // enumerate 7-subsets of {1..N} containing N (incremental: sets with max < N were counted at smaller N)
        // so cumulative counts printed are for all subsets of {1..N}.
        static ll clt=0,ceq=0,cgt=0,ctested=0,ctotal=0;
        v[K-1]=N;
        int idx[K-1]; for(int i=0;i<K-1;i++) idx[i]=i+1;
        while(1){
            for(int i=0;i<K-1;i++) v[i]=idx[i];
            total++;
            ll g=0; for(int i=0;i<K;i++) g=gcdll(g,v[i]);
            if(g==1){
                tested++;
                int ge = !covered(v,1); // ML >= 1/8
                int le =  covered(v,0); // ML <= 1/8
                if(!ge){ lt++; printf("COUNTEREXAMPLE? "); for(int i=0;i<K;i++) printf("%d ",v[i]); printf("\n"); }
                else if(le){ eq++; printf("TIGHT "); for(int i=0;i<K;i++) printf("%d ",v[i]); printf("\n"); }
                else gt++;
            }
            int p=K-2; while(p>=0 && idx[p]==N-(K-1)+p) p--; // max value for idx[p] is N-1-(K-2-p)
            if(p<0) break;
            idx[p]++; for(int q=p+1;q<K-1;q++) idx[q]=idx[q-1]+1;
        }
        clt+=lt; ceq+=eq; cgt+=gt; ctested+=tested; ctotal+=total;
        double dt=(double)(clock()-t0)/CLOCKS_PER_SEC;
        printf("N=%d new_subsets=%lld new_gcd1=%lld new_lt=%lld new_eq=%lld new_gt=%lld | cumulative subsets=%lld gcd1=%lld lt=%lld eq=%lld gt=%lld | time=%.2fs\n",
               N,total,tested,lt,eq,gt,ctotal,ctested,clt,ceq,cgt,dt);
        fflush(stdout);
    }
    return 0;
}


