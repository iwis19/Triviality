#!/usr/bin/env python3
"""Recompute E(K) = sum_{p<=K+1, ord_p(2)=p-1} log p - A*K for 16<=K<=KMAX (idea 10893db6, exp9)."""
import sys, math, time, numpy as np
KMAX = int(sys.argv[1]) if len(sys.argv) > 1 else 10**7
A = 0.3739558136192022880547280543464164151116292486061
t0 = time.time()
N = KMAX + 2
spf = np.zeros(N, dtype=np.int32)
for i in range(2, int(N**.5) + 1):
    if spf[i] == 0:
        blk = spf[i*i::i]; m = blk == 0; blk[m] = i
is_p = spf == 0; is_p[:2] = False
P = np.flatnonzero(is_p).astype(np.int64)
spf[is_p] = np.flatnonzero(is_p)
def modpow_vec(b, e, m):
    r = np.ones_like(m); b = b % m; e = e.copy()
    while e.any():
        odd = (e & 1) == 1
        r[odd] = (r[odd] * b[odd]) % m[odd]
        e >>= 1
        b = (b * b) % m
    return r
Podd = P[P > 2]
cur = Podd - 1
ok = np.ones(Podd.size, dtype=bool)
while (cur > 1).any():
    act = cur > 1
    q = spf[cur[act]].astype(np.int64)
    e = (Podd[act] - 1) // q
    r = modpow_vec(np.full(q.size, 2, dtype=np.int64), e, Podd[act])
    ok_act = ok[act]; ok_act &= (r != 1); ok[act] = ok_act
    c = cur[act]
    while True:
        d = (c % q == 0)
        if not d.any(): break
        c[d] //= q[d]
    cur[act] = c
prim = Podd[ok]
print("primes<=%d: %d ; with 2 primitive root: %d ; ratio %.6f (A=%.6f)" % (N-1, P.size, prim.size, prim.size/P.size, A))
w = np.zeros(N, dtype=np.float64); w[prim] = np.log(prim)
cum = np.cumsum(w)
K = np.arange(16, KMAX + 1, dtype=np.int64)
E = cum[K + 1] - A * K
ratio_sqrt = np.abs(E) / np.sqrt(K)
print("max |E|/sqrt(K) over 16<=K<=%d: %.4f at K=%d" % (KMAX, ratio_sqrt.max(), K[ratio_sqrt.argmax()]))
lo = 16
while lo <= KMAX:
    hi = min(2 * lo - 1, KMAX); m = (K >= lo) & (K <= hi)
    print("K in [%d,%d]: max|E|=%.3f  max|E|/sqrtK=%.3f  E(hi)=%.3f" % (lo, hi, np.abs(E[m]).max(), ratio_sqrt[m].max(), E[m][-1]))
    lo *= 2
big = K >= 2**20
if big.any():
    hool = K[big] * np.log(np.log(K[big])) / np.log(K[big])
    print("max |E|/(K loglog K/log K) for K>=2^20: %.5f" % (np.abs(E[big]) / hool).max())
print("E(128)=%.3f, max|E| on [64,128]=%.3f" % (E[128-16], np.abs(E[64-16:128-16+1]).max()))
print("time %.1fs" % (time.time() - t0))

