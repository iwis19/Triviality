#!/usr/bin/env python3
"""Independent re-implementation (critic) of the covering statement of idea d2c8682b
(claim 104f3f3f): for K=2..77 every candidate n in block (2^K, 2^{K+1}] given by lemma C1
(type A: n <= 2^K+K+1; type B: n = M_S(K)*i) is either one of {7,15,21,45,75,105}
or has k <= min(K,31), prime q <= 997 with q | n-2^k, q < n-2^k, or n-2^k = 1.

Differences from the reviewed code (as described): K <= 31 handled entirely with exact Python
integers (no numpy, no properness shortcut); K >= 32 uses a numpy filter for the residue
classes but every survivor is re-tested with exact integers; kills are attributed to the
smallest k (then smallest q) for comparison with the reported per-k counts.
"""
import sys, time, math
import numpy as np

QMAX, KCAP, KMAX = 997, 31, 77
SOLS = {7, 15, 21, 45, 75, 105}

def primes_upto(B):
    s = bytearray([1]) * (B + 1); s[0] = s[1] = 0
    for i in range(2, int(B ** 0.5) + 1):
        if s[i]:
            s[i*i::i] = bytearray(len(s[i*i::i]))
    return [i for i in range(B + 1) if s[i]]

PR = primes_upto(QMAX)

def is_prime_exact(m):
    if m < 2: return False
    if m % 2 == 0: return m == 2
    r = math.isqrt(m); d = 3
    while d <= r:
        if m % d == 0: return False
        d += 2
    return True

def factor_small(m):
    out = []; 
    for p in primes_upto(max(2, math.isqrt(m)) + 1):
        if m % p == 0:
            out.append(p)
            while m % p == 0: m //= p
    if m > 1: out.append(m)
    return out

def two_is_primitive_root(p):
    # 2 generates (Z/p)^* iff 2^((p-1)/r) != 1 mod p for every prime r | p-1 (p odd prime)
    if p == 2: return False
    return all(pow(2, (p - 1) // r, p) != 1 for r in factor_small(p - 1))

def S(K):
    return [p for p in primes_upto(K + 1) if two_is_primitive_root(p)]

def witness_exact(n, K):
    """Return ('f',k,q) / ('one',k) / ('sol',) / ('none',) using only exact integers."""
    for k in range(1, min(K, KCAP) + 1):
        m = n - (1 << k)
        if m == 1: return ('one', k)
        for q in PR:
            if q < m and m % q == 0: return ('f', k, q)
    # exact check of the full property
    k = 1
    while (1 << k) < n:
        if not is_prime_exact(n - (1 << k)): return ('none',)
        k += 1
    return ('sol',)

def main():
    t0 = time.time()
    total_A = total_B = 0
    kills = {}          # k -> count (type B)
    killsA = {}
    survivors = []
    ones = []
    for K in range(2, KMAX + 1):
        tK = time.time()
        SK = S(K); M = 1
        for p in SK: M *= p
        lo, hi = 1 << K, 1 << (K + 1)
        # type A
        nA = 0
        for n in range(lo + 1, lo + K + 2):
            nA += 1
            w = witness_exact(n, K)
            if w[0] == 'f': killsA[w[1]] = killsA.get(w[1], 0) + 1
            elif w[0] == 'one': ones.append((K, n, w[1]))
            elif w[0] == 'sol': survivors.append((K, 'A', n))
            else: print("!!! type A candidate with no small witness and not a solution:", K, n); survivors.append((K, 'A?', n))
        total_A += nA
        # type B
        i_lo = (lo + K + 1) // M + 1
        i_hi = hi // M
        nB = max(0, i_hi - i_lo + 1)
        total_B += nB
        if nB == 0:
            print(f"K={K:2d} S={SK} M={M} A={nA} B=0"); continue
        if K <= 31:
            for i in range(i_lo, i_hi + 1):
                n = M * i
                w = witness_exact(n, K)
                if w[0] == 'f': kills[w[1]] = kills.get(w[1], 0) + 1
                elif w[0] == 'sol': survivors.append((K, 'B', n))
                elif w[0] == 'one': ones.append((K, n, w[1]))
                else: print("!!! type B candidate with no small witness and not a solution:", K, n); survivors.append((K, 'B?', n))
            print(f"K={K:2d} S={SK} M={M} A={nA} B={nB} exact  {time.time()-tK:.1f}s")
            continue
        # K >= 32: k <= 31 < K so n - 2^k > 2^K - 2^31 >= 2^31 > 997: properness automatic
        Mq = {q: M % q for q in PR}
        usable = [q for q in PR if Mq[q] != 0]
        assert all(M % q == 0 for q in PR if q not in usable)
        alive = np.ones(nB, dtype=bool)
        for q in usable:
            c = (2 * pow(Mq[q], -1, q)) % q            # i = 2*M^{-1} mod q  <=>  q | M i - 2
            off = (c - i_lo) % q
            alive[off::q] = False
        surv = np.nonzero(alive)[0].astype(np.int64) + np.int64(i_lo)
        del alive
        kills[1] = kills.get(1, 0) + (nB - len(surv))
        for k in range(2, KCAP + 1):
            before = len(surv)
            for q in usable:
                c = (pow(2, k, q) * pow(Mq[q], -1, q)) % q
                surv = surv[(surv % q) != c]
                if len(surv) == 0: break
            kills[k] = kills.get(k, 0) + (before - len(surv))
            if len(surv) == 0: break
        # exact re-test of all survivors (should be none for K >= 32)
        for i in surv.tolist():
            n = M * int(i)
            w = witness_exact(n, K)
            print("survivor after numpy sieve:", K, n, w)
            survivors.append((K, 'B' if w[0] == 'sol' else 'B?', n))
        print(f"K={K:2d} |S|={len(SK)} M={M} A={nA} B={nB} i=[{i_lo},{i_hi}] numpy  {time.time()-tK:.1f}s", flush=True)
    print("\n=== SUMMARY ===")
    print("type A candidates:", total_A)
    print("type B candidates:", total_B)
    print("total candidates :", total_A + total_B)
    print("type B kills by k:", {k: kills[k] for k in sorted(kills)})
    print("type A kills by k:", {k: killsA[k] for k in sorted(killsA)})
    print("max k used (B):", max(kills), " max k used (A):", max(killsA))
    print("n-2^k = 1 cases:", ones)
    print("survivors (exact):", survivors)
    print("survivor set == known solutions:", {s[2] for s in survivors} == SOLS and all(s[1] in ('A', 'B') for s in survivors))
    print(f"elapsed {time.time()-t0:.1f}s")

if __name__ == '__main__':
    main()


