"""
Erdős #274 / Herzog–Schönheim: exhaustive search for exact coset coverings with
pairwise distinct indices in a battery of small finite groups, plus a test of the
representation-theoretic necessary condition (claim C1):

  For an exact covering G = ⊔ a_i G_i (finite G), every nontrivial irreducible ρ and
  every i with m_ρ(G_i) := dim Fix_ρ(G_i) > 0 satisfy
      |G_i| <= sum_{j != i, m_ρ(G_j) > 0} |G_j|          (operator-norm form)
      m_ρ(G_i) <= sum_{j != i} m_ρ(G_j)                  (rank form)

Groups are given as permutation groups; everything is computed from the Cayley table.
Character tables are computed numerically (Burnside class-sum algorithm) and rounded.
Requires numpy only.
"""
import itertools, sys, math
from fractions import Fraction
import numpy as np

# ---------------- permutation-group utilities ----------------
def pmul(p, q):  # (p*q)(i) = p(q(i))
    return tuple(p[i] for i in q)

def closure(gens):
    n = len(gens[0]); e = tuple(range(n))
    elems = {e}; frontier = [e]
    while frontier:
        new = []
        for x in frontier:
            for g in gens:
                y = pmul(g, x)
                if y not in elems:
                    elems.add(y); new.append(y)
        frontier = new
    return sorted(elems)

class Group:
    def __init__(self, name, gens):
        self.name = name
        self.elems = closure(gens)
        self.N = len(self.elems)
        idx = {g: i for i, g in enumerate(self.elems)}
        self.e = idx[tuple(range(len(gens[0])))]
        self.mul = np.zeros((self.N, self.N), dtype=np.int32)
        for i, p in enumerate(self.elems):
            for j, q in enumerate(self.elems):
                self.mul[i, j] = idx[pmul(p, q)]
        self.inv = np.zeros(self.N, dtype=np.int32)
        for i in range(self.N):
            self.inv[i] = int(np.where(self.mul[i] == self.e)[0][0])

    def sub_closure(self, S):
        S = set(S) | {self.e}
        frontier = list(S)
        gens = list(S)
        while frontier:
            new = []
            for x in frontier:
                for g in gens:
                    y = int(self.mul[g, x])
                    if y not in S:
                        S.add(y); new.append(y)
            frontier = new
        return frozenset(S)

    def subgroups(self):
        subs = set()
        for x in range(self.N):
            subs.add(self.sub_closure([x]))
        subs = set(subs)
        changed = True
        while changed:
            changed = False
            lst = sorted(subs, key=len)
            for a, b in itertools.combinations(lst, 2):
                if a <= b or b <= a: continue
                c = self.sub_closure(a | b)
                if c not in subs:
                    subs.add(c); changed = True
        return sorted(subs, key=len)

    def left_coset(self, a, H):
        return frozenset(int(self.mul[a, h]) for h in H)

    # ------------- character table (numerical Burnside) -------------
    def conj_classes(self):
        seen = set(); classes = []
        for g in range(self.N):
            if g in seen: continue
            cl = {int(self.mul[self.mul[x, g], self.inv[x]]) for x in range(self.N)}
            seen |= cl; classes.append(sorted(cl))
        return classes

    def character_table(self):
        classes = self.conj_classes()
        r = len(classes)
        cls_of = np.zeros(self.N, dtype=int)
        for k, cl in enumerate(classes):
            for g in cl: cls_of[g] = k
        # structure constants a[j][i][k] = #{(x,y) in C_j x C_i : xy = z} for fixed z in C_k
        M = np.zeros((r, r, r))
        reps = [cl[0] for cl in classes]
        for j in range(r):
            for i in range(r):
                for x in classes[j]:
                    for y in classes[i]:
                        k = cls_of[self.mul[x, y]]
                        M[j, i, k] += 1
        for k in range(r):
            M[:, :, k] /= len(classes[k])
        rng = np.random.default_rng(1)
        A = sum(rng.standard_normal() * M[j] for j in range(r))
        # rows of eigenvector basis: simultaneous eigenvectors are common to all M_j
        w, V = np.linalg.eig(A)  # right eigenvectors: M_j omega = omega_j omega
        chars = []
        for c in range(r):
            v = V[:, c]
            v = v / v[cls_of[self.e]]  # omega(1)=1
            # omega_k = |C_k| chi(g_k)/chi(1)  =>  chi(g_k) = chi(1) omega_k/|C_k|
            om = np.array([v[k] / len(classes[k]) for k in range(r)])
            norm = sum(len(classes[k]) * abs(om[k]) ** 2 for k in range(r))
            d = math.sqrt(self.N / norm.real)
            chars.append(np.array([d * om[k] for k in range(r)]))
        chars = np.array(chars)
        # sanity: degrees integral, orthogonality
        degs = chars[:, cls_of[self.e]].real
        assert np.allclose(degs, np.round(degs), atol=1e-6), degs
        assert abs(sum(np.round(degs) ** 2) - self.N) < 1e-6
        return classes, cls_of, chars

# ---------------- constructors ----------------
def cyc(n):
    return [tuple((i + 1) % n for i in range(n))]

def dihedral(n):
    r = tuple((i + 1) % n for i in range(n)); s = tuple((-i) % n for i in range(n))
    return [r, s]

def sym(n):
    return [tuple([1, 0] + list(range(2, n))), tuple(list(range(1, n)) + [0])]

def direct_product(gA, gB):
    nA = len(gA[0]); nB = len(gB[0])
    gens = []
    for g in gA: gens.append(tuple(list(g) + list(range(nA, nA + nB))))
    for g in gB: gens.append(tuple(list(range(nA)) + [nA + x for x in g]))
    return gens

def affine(p, mult):  # AGL(1,p) or subgroup: x -> x+1, x -> mult*x
    return [tuple((x + 1) % p for x in range(p)), tuple((mult * x) % p for x in range(p))]

def from_matrices_mod(mats, q, dim):
    # action on vectors of F_q^dim (q prime)
    vecs = list(itertools.product(range(q), repeat=dim)); vidx = {v: i for i, v in enumerate(vecs)}
    gens = []
    for m in mats:
        perm = []
        for v in vecs:
            w = tuple(sum(m[i][j] * v[j] for j in range(dim)) % q for i in range(dim))
            perm.append(vidx[w])
        gens.append(tuple(perm))
    return gens

def quaternion():  # Q8 as regular rep via matrices over F_3: SL(2,3) contains Q8
    return from_matrices_mod([[[0, 1], [2, 0]], [[1, 1], [1, 2]]], 3, 2)

def sl23():
    return from_matrices_mod([[[1, 1], [0, 1]], [[0, 1], [2, 0]]], 3, 2)

def gl23():
    return from_matrices_mod([[[1, 1], [0, 1]], [[0, 1], [1, 0]], [[2, 0], [0, 1]]], 3, 2)

def dicyclic(n):  # order 4n: <a,x | a^{2n}=1, x^2=a^n, xax^-1=a^-1>, as perm on 4n points (regular-ish)
    # realise inside C_{2n} ⋊ via explicit permutations on Z_{2n} x {0,1}
    pts = [(i, s) for s in range(2) for i in range(2 * n)]; pidx = {p: k for k, p in enumerate(pts)}
    a = tuple(pidx[((i + 1) % (2 * n), s)] if s == 0 else pidx[((i - 1) % (2 * n), s)] for (i, s) in pts)
    x = tuple(pidx[(i, 1)] if s == 0 else pidx[((i + n) % (2 * n), 0)] for (i, s) in pts)
    return [a, x]

def c3c3_semidirect_c4():  # (C3xC3) ⋊ C4, order 36, C4 acting by (x,y)->(-y,x)
    return [tuple(( (v[0]+1)%3)*3 + v[1] for v in itertools.product(range(3), repeat=2)),
                                                            tuple(( v[0])*3 + (v[1]+1)%3 for v in itertools.product(range(3), repeat=2)),
                                                            tuple(((-v[1])%3)*3 + v[0] for v in itertools.product(range(3), repeat=2))]

def gen_c3c3_semidirect_c2():  # generalised dihedral of C3xC3, order 18
    return [tuple(((v[0]+1)%3)*3 + v[1] for v in itertools.product(range(3), repeat=2)),
            tuple((v[0])*3 + (v[1]+1)%3 for v in itertools.product(range(3), repeat=2)),
            tuple(((-v[0])%3)*3 + (-v[1])%3 for v in itertools.product(range(3), repeat=2))]

def psl27_gens():
    # standard: (0 1 2 3 4 5 6), (1 2 4)(3 6 5)  -> generates PSL(2,7) of order 168 acting on P^1(F_7)? use projective line
    q = 7
    pts = list(range(q)) + ['inf']; pidx = {p: i for i, p in enumerate(pts)}
    def mob(a, b, c, d):
        perm = []
        for p in pts:
            if p == 'inf':
                w = 'inf' if c == 0 else (a * pow(c, -1, q)) % q
            else:
                den = (c * p + d) % q
                w = 'inf' if den == 0 else ((a * p + b) * pow(den, -1, q)) % q
            perm.append(pidx[w])
        return tuple(perm)
    return [mob(1, 1, 0, 1), mob(0, 6, 1, 0), mob(2, 0, 0, 4)]  # x+1, -1/x, 4x  (det = 1 each: 2*4=8=1)

