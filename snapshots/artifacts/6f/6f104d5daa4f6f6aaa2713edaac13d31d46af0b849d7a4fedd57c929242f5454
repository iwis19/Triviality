# ---------------- main analysis ----------------
def egyptian_tuples(indices_available, target=Fraction(1), start=2, maxk=12):
    """all sets of pairwise-distinct indices from indices_available (sorted), reciprocals summing to 1"""
    out = []
    avail = sorted(i for i in indices_available if i >= start)
    def rec(rem, lo, chosen):
        if rem == 0:
            if len(chosen) >= 2: out.append(tuple(chosen))
            return
        if len(chosen) >= maxk: return
        for n in avail:
            if n < lo: continue
            if Fraction(1, n) > rem: continue
            # bound: remaining terms are >= n, count <= maxk-len
            if Fraction(maxk - len(chosen), n) < rem: break
            rec(rem - Fraction(1, n), n + 1, chosen + [n])
    rec(target, start, [])
    return out

def find_partition(G, subs):
    """subs: list of subgroups (frozensets). Search a_i with a_1 = e, cosets pairwise disjoint."""
    k = len(subs)
    # coset lists
    cosets = []
    for H in subs:
        seen = set(); cl = []
        for a in range(G.N):
            if a in seen: continue
            c = G.left_coset(a, H); seen |= c; cl.append(c)
        cosets.append(cl)
    chosen = [None] * k
    def rec(j, covered):
        if j == k:
            return len(covered) == G.N
        for c in (cosets[j] if j > 0 else [cosets[0][[G.e in c for c in cosets[0]].index(True)]]):
            if covered.isdisjoint(c):
                chosen[j] = c
                if rec(j + 1, covered | c): return True
        return False
    ok = rec(0, frozenset())
    return chosen if ok else None

def analyse(name, gens, do_chars=True, verbose=False, c1_prune=False):
    G = Group(name, gens)
    subs = G.subgroups()
    by_index = {}
    for H in subs:
        by_index.setdefault(G.N // len(H), []).append(H)
    tuples = egyptian_tuples(by_index.keys())
    n_cand = 0; n_found = 0; n_excl_C1 = 0; n_excl_rank = 0; n_private = 0
    if do_chars:
        classes, cls_of, chars = G.character_table()
        def mult(H):  # multiplicities m_rho(H) for all rho
            v = np.zeros(len(chars))
            for h in H: v += chars[:, cls_of[h]].real
            v /= len(H)
            return np.round(v).astype(int)
        mcache = {H: mult(H) for H in subs}
        triv = int(np.argmin([abs(chars[r] - 1).sum() for r in range(len(chars))]))
    counterexamples = []
    for idx_tuple in tuples:
        for choice in itertools.product(*[by_index[n] for n in idx_tuple]):
            n_cand += 1
            if do_chars:
                ms = [mcache[H] for H in choice]
                excl = False; exclr = False; priv = False
                for r in range(len(chars)):
                    if r == triv: continue
                    for i, H in enumerate(choice):
                        if ms[i][r] > 0:
                            others = sum(len(K) for j, K in enumerate(choice) if j != i and ms[j][r] > 0)
                            if len(H) > others: excl = True
                            if others == 0: priv = True
                            if ms[i][r] > sum(ms[j][r] for j in range(len(choice)) if j != i): exclr = True
                n_excl_C1 += excl; n_excl_rank += exclr; n_private += priv
            if c1_prune and do_chars and excl:
                continue  # C1 is a proven necessary condition; exact search only on survivors
            part = find_partition(G, list(choice))
            if part is not None:
                n_found += 1; counterexamples.append((idx_tuple, part))
    print(f"{name:28s} |G|={G.N:4d} #subs={len(subs):4d} candidate tuples={n_cand:6d} "
          f"partitions found={n_found}{' (exact search only on C1 survivors)' if c1_prune else ''} " + (f"excluded by C1(norm)={n_excl_C1} by rank={n_excl_rank} with private constituent={n_private}" if do_chars else ""), flush=True)
    return counterexamples

if __name__ == "__main__":
    args = sys.argv[1:]
    c1_prune = "--c1-prune" in args
    names = [a for a in args if not a.startswith("--")] or list(GROUPS)
    allce = []
    for nm in names:
        try:
            allce += analyse(nm, GROUPS[nm], c1_prune=c1_prune)
        except Exception as ex:
            print(nm, "ERROR", repr(ex), flush=True)
    print("TOTAL distinct-index exact coverings found:", len(allce))
