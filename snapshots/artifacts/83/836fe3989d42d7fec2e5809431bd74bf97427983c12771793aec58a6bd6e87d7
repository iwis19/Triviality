// Enumerate S3 ∩ S5 ∩ [0, N) by galloping intersection.
// S_p = { n : all base-p digits <= (p-1)/2 }.
// Usage: ./isect2 N > out.txt   (N as decimal, < 2^63)
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>

typedef unsigned long long u64;

// smallest y >= x with all base-p digits <= d
static u64 next_p(u64 x, u64 p, u64 d) {
    u64 dig[64]; int len = 0; u64 t = x;
    while (t) { dig[len++] = t % p; t /= p; }
    int bad = -1;
    for (int i = len - 1; i >= 0; i--) if (dig[i] > d) { bad = i; break; }
    if (bad < 0) return x;
    // find lowest position k > bad with dig[k] < d
    int k = bad + 1;
    while (k < len && dig[k] >= d) k++;
    if (k == len) { dig[len++] = 1; for (int i = 0; i < len - 1; i++) dig[i] = 0; }
    else { dig[k] += 1; for (int i = 0; i < k; i++) dig[i] = 0; }
    u64 y = 0;
    for (int i = len - 1; i >= 0; i--) y = y * p + dig[i];
    return y;
}

int main(int argc, char **argv) {
    u64 N = strtoull(argv[1], 0, 10);
    u64 x = 0; u64 cnt = 0, steps = 0;
    while (x < N) {
        u64 y = next_p(x, 3, 1); steps++;
        if (y != x) { x = y; continue; }
        y = next_p(x, 5, 2); steps++;
        if (y != x) { x = y; continue; }
        printf("%llu\n", x); cnt++;
        x++;
    }
    fprintf(stderr, "count=%llu steps=%llu\n", cnt, steps);
    return 0;
}

