#!/usr/bin/env python3
"""Extra checks at j=9 (Q=7^9): anchor sums at gap scales m=3..9, digit structure of the
large spectrum of the cylinder, err/sqrt(main), and whether size-weighted anchors reproduce Shat(4)."""
import sys, numpy as np
S = np.loadtxt(sys.argv[1], dtype=np.uint64); n = len(S)
gaps = np.diff(S.astype(np.int64))
j = 9; Q = 7 ** j
def base7(a):
    s = ""
    for _ in range(j): s = str(a % 7) + s; a //= 7
    return s
def signed_digits(a):
    ds = []
    for _ in range(j):
        d = a % 7; a //= 7
        ds.append(d if d <= 3 else d - 7)
    return ds
ind = np.ones(1)
for _ in range(j):
    blk = np.zeros(7 * len(ind))
    for d in range(4): blk[d * len(ind):(d + 1) * len(ind)] = ind
    ind = blk
Chat = np.fft.fft(ind); absC = np.abs(Chat); absC[0] = 0; Csize = 4 ** j
h = np.bincount((S % np.uint64(Q)).astype(np.int64), minlength=Q).astype(float)
Shat = np.fft.fft(h)
main = (4 / 7) ** j * n; err = np.sum(h * ind) - main
print("j=9: err=%.1f main=%.1f sqrt(main)=%.1f err/sqrt(main)=%.2f" % (err, main, main ** .5, err / main ** .5))
# digit structure of the large spectrum
for eta in (0.5, 0.1, 0.01):
    spec = np.nonzero(absC >= eta * Csize)[0]
    mx = [max(abs(x) for x in signed_digits(int(a))) for a in spec]
    hist = np.bincount(mx, minlength=4)
    print("Spec_%.2f: size %d; max |signed base-7 digit| histogram (0,1,2,3): %s; examples: %s"
          % (eta, len(spec), hist.tolist(), [base7(int(a)) for a in spec[:6]]))
# anchors at gap scale 7^m, m=3..9, with and without size weights
for m in range(3, 10):
    starts = np.concatenate(([0], np.nonzero(gaps >= 7 ** m)[0] + 1))
    anchors = S[starts]; nc = len(anchors)
    sizes = np.diff(np.concatenate((starts, [n]))).astype(float)
    r = (anchors % np.uint64(Q)).astype(np.int64)
    ha = np.bincount(r, minlength=Q).astype(float); hw = np.bincount(r, weights=sizes, minlength=Q)
    Ahat = np.fft.fft(ha); Ahat[0] = 0; Wq = np.fft.fft(hw); Wq[0] = 0
    spec = absC >= 0.1 * Csize
    aA = np.abs(Ahat)
    am = int(np.argmax(aA))
    print("m=%d #c=%d mean size %.1f: max|Ahat|/sqrt(#c)=%.2f at a=%s; over Spec_0.1: %.2f; |Shat(4)|=%.0f, size-weighted anchor sum at a=4: %.0f, |Ahat(4)|*mean=%.0f"
          % (m, nc, n / nc, aA[am] / nc ** .5, base7(am), aA[spec].max() / nc ** .5, abs(Shat[4]), abs(Wq[4]), aA[4] * n / nc))

