#!/usr/bin/env python3
"""Reproduce claims b62bf60a / a9cacde1 for S = S3 ∩ S5 ∩ [0,10^18) and run the
large-spectrum falsifier of idea f2e6accd.

For Q = 7^j:  Shat(a) = sum_{n in S} e(a n / Q),  Chat(a) = sum_{r in C_j} e(a r/Q),
C_j = residues mod 7^j all of whose j base-7 digits are <= 3.
count(S in C_j) = (1/Q) sum_a Shat(a) conj(Chat(a))  (exact).
"""
import sys, numpy as np

S = np.loadtxt(sys.argv[1], dtype=np.uint64)
n_elems = len(S)
print("|S| =", n_elems)

# consecutive-gap statistics (claim: 61% of gaps < 7)
gaps = np.diff(S.astype(np.int64))
print("fraction of consecutive gaps <7: %.4f" % np.mean(gaps < 7))
for m in (3, 5, 9):
    runs = 1 + np.sum(gaps >= 7 ** m)
    print("runs at gap scale 7^%d: %d, mean size %.1f" % (m, runs, n_elems / runs))

def base7(a, j):
    s = ""
    for _ in range(j):
        s = str(a % 7) + s; a //= 7
    return s

def cyl_indicator(j):
    Q = 7 ** j
    ind = np.ones(1, dtype=np.float64)
    for _ in range(j):
        # digits <= 3 at the new (top) position
        blk = np.zeros(7 * len(ind))
        for d in range(4):
            blk[d * len(ind):(d + 1) * len(ind)] = ind
        ind = blk
    assert len(ind) == Q
    return ind

jmax = int(sys.argv[2]) if len(sys.argv) > 2 else 9
mlist = [3, 5]
jmin = int(sys.argv[3]) if len(sys.argv) > 3 else 1
for j in range(jmin, jmax + 1):
    Q = 7 ** j
    res = (S % np.uint64(Q)).astype(np.int64)
    h = np.bincount(res, minlength=Q).astype(np.float64)
    Shat = np.fft.fft(h)            # Shat(a) = sum_r h_r e(-a r/Q)
    ind = cyl_indicator(j)
    Chat = np.fft.fft(ind)
    Csize = 4 ** j
    absS = np.abs(Shat); absC = np.abs(Chat)
    absS[0] = 0; absC0 = absC.copy(); absC0[0] = 0
    rms = np.sqrt(np.mean(absS[1:] ** 2)) / np.sqrt(n_elems)
    amax = int(np.argmax(absS))
    mx = absS[amax] / np.sqrt(n_elems)
    true_count = float(np.sum(h * ind))
    main = (4 / 7) ** j * n_elems
    err = true_count - main
    # error via Fourier (check identity)
    err_f = (np.sum(Shat[1:] * np.conj(Chat[1:])) / Q).real
    Linf = absS.max() * absC0.sum() / Q
    L2 = np.sqrt(np.sum(absS ** 2)) * np.sqrt(np.sum(absC0 ** 2)) / Q
    Labs = np.sum(absS * absC0) / Q
    L1C = np.log(absC.sum() / Csize) / np.log(Q)
    print("\nj=%d Q=%d theta=j/log_7(1e18)=%.3f" % (j, Q, j / (18 * np.log(10) / np.log(7))))
    print(" RMS|Shat|/sqrt|S| = %.3f   max|Shat|/sqrt|S| = %.2f at a=%d (base7 %s)" % (rms, mx, amax, base7(amax, j)))
    print(" count in C_j = %d, main = %.1f, rel err = %.2f%%  (Fourier err %.1f)" % (true_count, main, 100 * err / main, err_f))
    print(" bounds/main: Linf %.3g  L2 %.3g  abs-sum %.3g ; log_Q(||Chat||_1/|C|) = %.4f" % (Linf / main, L2 / main, Labs / main, L1C))

    # ---- falsifier: restrict the Fourier error to the large spectrum of Chat ----
    order = np.argsort(-absC0)  # a=0 excluded via absC0[0]=0 (it is last)
    terms = (Shat * np.conj(Chat) / Q).real
    cum = np.cumsum(terms[order])
    print(" large-spectrum-restricted error (eta = |Chat(a)|/|C| threshold):")
    for eta in (0.5, 0.3, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005, 0.002, 0.001):
        k = int(np.sum(absC0 >= eta * Csize))
        if k == 0:
            continue
        restricted = cum[k - 1]
        # absolute-value bound on the complementary (small-spectrum) part
        tail_abs = np.sum(absS[order[k:]] * absC0[order[k:]]) / Q
        print("   eta=%.3f |Spec|=%d (Q^%.3f) restricted err=%.1f true=%.1f ratio=%.2f ; abs tail bound/main=%.2f"
              % (eta, k, np.log(k) / np.log(Q), restricted, err, restricted / err if err != 0 else float('nan'), tail_abs / main))
    # how far into the sorted spectrum does the partial sum stay within factor 2 of the truth?
    # ---- anchors: cluster decomposition at gap scale 7^m ----
    for m in mlist:
        if m >= j:
            continue
        starts = np.concatenate(([0], np.nonzero(gaps >= 7 ** m)[0] + 1))
        anchors = S[starts]
        nc = len(anchors)
        ha = np.bincount((anchors % np.uint64(Q)).astype(np.int64), minlength=Q).astype(np.float64)
        Ahat = np.abs(np.fft.fft(ha)); Ahat[0] = 0
        for eta in (0.1, 0.01):
            spec = absC0 >= eta * Csize
            print("   m=%d #clusters=%d mean size %.1f : max|Ahat|/sqrt(#c) over all a=%.2f, over Spec_%.2f=%.2f, RMS over Spec=%.2f ; naive bound Q^0.5208/sqrt(#c)=%.2f"
                  % (m, nc, n_elems / nc, Ahat.max() / np.sqrt(nc), eta, Ahat[spec].max() / np.sqrt(nc),
                     np.sqrt(np.mean(Ahat[spec] ** 2)) / np.sqrt(nc), Q ** 0.5208 / np.sqrt(nc)))
    sys.stdout.flush()

