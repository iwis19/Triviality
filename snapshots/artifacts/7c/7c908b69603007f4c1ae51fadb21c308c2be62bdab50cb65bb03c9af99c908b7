// For all union-closed families on [n] (n<=5) and all x: compare
//  T5(x): inclusion-respecting injection F_{not x} -> F_x exists
//  U(x):  for every e subset [n] with x notin e, x is abundant in F ∩ up(e)   (necessary for T5(x), by Hall with G = up-interval)
// Count pairs (F,x) with U(x) true but T5(x) false, and print a few.
#include "uc.h"
static int N; static int inc[MAXS], ninc; static unsigned char inF[MAXS];
static long pairs=0, t5true=0, utrue=0, u_not_t5=0, printed=0;
static int U_holds_at(const fam_t *F,int x){
  for(int e=0;e<(1<<F->n);e++){ if(e>>x&1) continue; int w=0,v=0;
    for(int j=0;j<F->cnt;j++){ int A=F->sets[j]; if((A&e)!=e) continue; if(A>>x&1) v++; else w++; }
    if(w>v) return 0; }
  return 1;
}
static void leaf(void){
  if(ninc==0) return; if(ninc==1 && inc[0]==0) return;
  fam_t F; F.n=N; F.cnt=0; memset(F.in,0,sizeof(F.in));
  for(int i=0;i<ninc;i++){F.in[inc[i]]=1; F.sets[F.cnt++]=inc[i];}
  for(int x=0;x<N;x++){ pairs++; int t=t5_holds_at(&F,x), u=U_holds_at(&F,x); t5true+=t; utrue+=u;
    if(u && !t){ u_not_t5++; if(printed<8){printed++; printf("U(x) but not T5(x): x=%d : ",x+1); fam_print(&F,stdout); printf("\n");} }
    if(t && !u){ printf("BUG: T5 without U\n"); exit(1);} }
}
static void rec(int s){ if(s<0){leaf();return;} rec(s-1); int ok=1; for(int i=0;i<ninc;i++) if(!inF[inc[i]|s]){ok=0;break;} if(ok){inF[s]=1;inc[ninc++]=s;rec(s-1);ninc--;inF[s]=0;} }
int main(int argc,char**argv){ N=argc>1?atoi(argv[1]):5; rec((1<<N)-1);
  printf("n=%d: (F,x) pairs %ld, T5(x) true %ld, U(x) true %ld, U(x) true but T5(x) false %ld\n",N,pairs,t5true,utrue,u_not_t5); return 0; }
