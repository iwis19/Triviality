// Shared helpers: union-closed families on [n] as bitsets over 2^n masks.
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAXN 8
#define MAXS (1<<MAXN)

typedef struct { int n; int cnt; unsigned char in[MAXS]; int sets[MAXS]; } fam_t;

static void fam_from_list(fam_t *F, int n, const int *sets, int k){
  F->n=n; F->cnt=0; memset(F->in,0,sizeof(F->in));
  for(int i=0;i<k;i++) if(!F->in[sets[i]]){F->in[sets[i]]=1; F->sets[F->cnt++]=sets[i];}
}
// union closure of the generators already in F (in-place)
static void fam_close(fam_t *F){
  int changed=1;
  while(changed){ changed=0;
    for(int i=0;i<F->cnt;i++) for(int j=i+1;j<F->cnt;j++){ int u=F->sets[i]|F->sets[j];
      if(!F->in[u]){F->in[u]=1; F->sets[F->cnt++]=u; changed=1;} }
  }
}
static int fam_is_uc(const fam_t *F){
  for(int i=0;i<F->cnt;i++) for(int j=i;j<F->cnt;j++) if(!F->in[F->sets[i]|F->sets[j]]) return 0;
  return 1;
}
// bipartite matching: left = sets without x, right = sets with x, edge iff A subset B.
// returns 1 iff an injection A -> B (A subset B) exists.
static int matchR[MAXS], visR[MAXS];
static int L[MAXS], R[MAXS], nL, nR;
static const fam_t *curF;
static int try_aug(int a, int stamp){
  int A=L[a];
  for(int b=0;b<nR;b++){ int B=R[b];
    if((A & ~B)!=0) continue; // need A subset B
    if(visR[b]==stamp) continue; visR[b]=stamp;
    if(matchR[b]<0 || try_aug(matchR[b],stamp)){ matchR[b]=a; return 1; }
  }
  return 0;
}
static int t5_holds_at(const fam_t *F, int x){
  nL=nR=0; curF=F;
  for(int i=0;i<F->cnt;i++){ int A=F->sets[i]; if(A>>x&1) R[nR++]=A; else L[nL++]=A; }
  if(nL>nR) return 0;
  for(int b=0;b<nR;b++){matchR[b]=-1; visR[b]=0;}
  int stamp=0;
  for(int a=0;a<nL;a++){ stamp++; if(!try_aug(a,stamp)) return 0; }
  return 1;
}
// T2: exists S in F_x with A -> A|S injective on F_{not x}
static int t2_holds_at(const fam_t *F, int x){
  static unsigned char seen[MAXS];
  for(int i=0;i<F->cnt;i++){ int S=F->sets[i]; if(!(S>>x&1)) continue;
    memset(seen,0,1<<F->n); int ok=1;
    for(int j=0;j<F->cnt && ok;j++){ int A=F->sets[j]; if(A>>x&1) continue; int u=A|S; if(seen[u]) ok=0; else seen[u]=1; }
    if(ok) return 1;
  }
  return 0;
}
static int freq(const fam_t *F,int x){ int c=0; for(int i=0;i<F->cnt;i++) c+= (F->sets[i]>>x)&1; return c; }
static int maxfreq(const fam_t *F){ int m=0; for(int x=0;x<F->n;x++){int c=freq(F,x); if(c>m)m=c;} return m; }
static void fam_print(const fam_t *F, FILE *out){
  for(int i=0;i<F->cnt;i++){ int A=F->sets[i]; if(i) fputc(' ',out); if(A==0) fputc('e',out); for(int x=0;x<F->n;x++) if(A>>x&1) fputc('1'+x,out); }
}
