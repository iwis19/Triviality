#!/usr/bin/env python3
"""Spot-check of claim d4330638 (idea f040cbd7): over Z/QZ, Q=7^k,
A3=S3∩[0,3^L), A5=S5∩[0,5^m), A7=S7∩[0,7^k) with 3^L,5^m<=Q.
exact = |A3∩A5∩A7|,  main = |A3||A5||A7|/Q^2,
E = Q^-2 * sum_{(a,b)!=(0,0)} |Â3(a)||Â5(b)||Â7(a+b)|  (computed by FFT convolution),
plus L1 exponents log_Q(||Â_p||_1/|A_p|) and the Cauchy–Schwarz lower bound
||Â||_1 >= Q (so log_Q(||Â_p||_1/|A_p|) >= 1 - log_Q|A_p|).
Also evaluates Bloom–Croot Lemma 6 exponent log_g(10g/t) at (g,t)=(3,2),(5,3),(7,4).
"""
import numpy as np, math, sys

def digit_set(p, dmax, R):
    # all n < p^R with digits <= dmax
    vals = np.array([0], dtype=np.int64)
    for i in range(R):
        vals = (vals[:, None] + (np.arange(dmax + 1, dtype=np.int64) * p ** i)[None, :]).ravel()
    return np.sort(vals)

def indicator(A, Q):
    f = np.zeros(Q); f[A] = 1.0; return f

for k in range(3, 8):
    Q = 7 ** k
    L = int(math.floor(math.log(Q) / math.log(3) + 1e-9))
    m = int(math.floor(math.log(Q) / math.log(5) + 1e-9))
    while 3 ** L > Q: L -= 1
    while 5 ** m > Q: m -= 1
    A3 = digit_set(3, 1, L); A5 = digit_set(5, 2, m); A7 = digit_set(7, 3, k)
    exact = len(np.intersect1d(np.intersect1d(A3, A5), A7))
    main = len(A3) * len(A5) * len(A7) / Q ** 2
    F3 = np.abs(np.fft.fft(indicator(A3, Q)))
    F5 = np.abs(np.fft.fft(indicator(A5, Q)))
    F7 = np.abs(np.fft.fft(indicator(A7, Q)))
    # conv(c) = sum_a |F3(a)| |F5(c-a)|  -> total = sum_c |F7(c)| conv(c)
    conv = np.real(np.fft.ifft(np.fft.fft(F3) * np.fft.fft(F5)))
    total = np.sum(F7 * conv) / Q ** 2
    E = total - main
    l1 = [math.log(F.sum() / F[0]) / math.log(Q) for F in (F3, F5, F7)]
    lb = [1 - math.log(F[0]) / math.log(Q) for F in (F3, F5, F7)]
    print(f"k={k} Q={Q} L={L} m={m} |A3|={len(A3)} |A5|={len(A5)} |A7|={len(A7)} exact={exact} main={main:.4f} "
          f"E={E:.4g} log_Q(E/main)={math.log(E/main)/math.log(Q):.3f} "
          f"L1exp(3,5,7)={[round(x,3) for x in l1]} CS-lower-bound={[round(x,3) for x in lb]}")

print("Bloom–Croot Lemma 6 'in particular' exponent log_g(10g/t):",
      {f"g={g},t={t}": round(math.log(10 * g / t) / math.log(g), 3) for g, t in ((3, 2), (5, 3), (7, 4))},
      "(nontrivial only if < 1)")
print("Lemma 6 first bound factor (10/t)^min(R,K):", {t: 10 / t for t in (2, 3, 4)}, "(nontrivial only if < 1)")

