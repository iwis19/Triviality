# ===== search_discrepancy.py =====
"""Search for generator families A on [5] where the 'recalled' LP (UC H with A ⊆ H ⊆ P(U(A)))
and Poonen's LP (UC B ⊆ P(U(A)) with B ⊎ A ⊆ B) give different FC verdicts or different values.
Generators: all families of 1..4 sets of size >=3 on [5] (plus optionally the 5-set), up to S_5 symmetry."""
import itertools, sys, time
import numpy as np
from scipy.optimize import linprog
import poonen_lp as P

N, M = P.N, P.M
FAMS = P.FAMS
H = ((FAMS[:, None] >> P.BITS[None, :]) & 1).astype(bool)      # 2.77M x 32 membership
NMAT_ALL, SIZE_ALL = P.features(FAMS)

def cls_mask(A, cls, X):
    allowed = np.uint32(sum(1 << s for s in range(M) if (s & ~X) == 0))
    ok = (FAMS & ~allowed) == 0
    if cls == 'recalled':
        for s in A: ok &= H[:, s]
        return ok
    for S in A:
        for b in range(M):
            if b | S == b: continue
            ok &= ~(H[:, b] & ~H[:, b | S])
    return ok

def lp(ok):
    Nmat = NMAT_ALL[ok]; rhs = SIZE_ALL[ok] / 2
    cobj = np.zeros(N + 1); cobj[-1] = -1
    active = np.arange(min(len(Nmat), 200))
    bounds = [(0, None)] * N + [(None, None)]
    for it in range(300):
        Aub = np.hstack([-Nmat[active], np.ones((len(active), 1))])
        res = linprog(cobj, A_ub=Aub, b_ub=-rhs[active], A_eq=[[1] * N + [0]], b_eq=[1], bounds=bounds, method='highs')
        c = res.x[:N]; t = res.x[-1]
        margin = Nmat @ c - rhs
        worst = np.argsort(margin)[:50]
        if margin[worst[0]] >= t - 1e-9:
            return t, c
        active = np.union1d(active, worst)
    raise RuntimeError

def canon(A):
    best = None
    for perm in itertools.permutations(range(N)):
        img = tuple(sorted(sum(1 << perm[i] for i in range(N) if s >> i & 1) for s in A))
        if best is None or img < best: best = img
    return best

sets = [s for s in range(M) if bin(s).count('1') >= 3]
seen = set(); results = []
t0 = time.time()
for k in range(1, 5):
    for A in itertools.combinations(sets, k):
        cA = canon(A)
        if cA in seen: continue
        seen.add(cA)
        X = 0
        for s in cA: X |= s
        tp, cp = lp(cls_mask(cA, 'poonen', X))
        tr, cr = lp(cls_mask(cA, 'recalled', X))
        fc_p, fc_r = tp >= -1e-9, tr >= -1e-9
        flag = ''
        if fc_p != fc_r: flag = 'VERDICT DIFFERS'
        elif tr < tp - 1e-7: flag = 'recalled < poonen (unexpected)'
        elif abs(tr - tp) > 1e-7: flag = 'values differ'
        name = ','.join(''.join(str(i + 1) for i in range(N) if s >> i & 1) for s in cA)
        results.append((name, tp, tr, flag))
        print(f"{name:26s} poonen={tp:8.4f} recalled={tr:8.4f} {flag}"); sys.stdout.flush()
print('classes:', len(results), 'time', time.time() - t0)
print('verdict differs:', sum(1 for r in results if r[3] == 'VERDICT DIFFERS'))
print('values differ  :', sum(1 for r in results if r[3] != ''))

