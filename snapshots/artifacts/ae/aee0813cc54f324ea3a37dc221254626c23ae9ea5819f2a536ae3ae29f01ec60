#!/usr/bin/env python3
"""Experiment 5 (for idea I1): the CRT / orbit-avoidance counting bound per dyadic block.

For a solution n in (2^K, 2^{K+1}] and a prime p with 2 a primitive root mod p and p-1 <= K,
either p | n or n = p + 2^k for some k <= p-1 (Lean: dvd_of_erdos1142_of_primitiveRoot).
Hence   N(2^K, 2^{K+1}]  <=  2^K / M_S(K) + 1 + K * |S(K)|,   M_S(K) = prod_{p in S, p <= K+1} p.
Also using primes with ord_p(2) = (p-1)/2 (index 2) n must avoid the (p-1)/2 residues 2^k mod p
(again up to n = p + 2^k exceptions), which allows one further factor ~1/2 per such prime while
the CRT modulus stays <= 2^K.  Print the resulting exponent  theta(K) = log_2(bound) / K.
Artin's constant A = 0.3739558... gives the conjectural limit  1 - A/log 2 = 0.4605...
"""
import math
from sympy import primerange, n_order

A = 0.3739558136192022880547280543
print("conjectural limit exponent 1 - A/log2 =", 1 - A / math.log(2))
print("  K   |S(K)|  log2 M_S(K)   theta_S(K)=1-log2M_S/K   theta_with_index2(K)")
for K in [44, 64, 100, 128, 200, 300, 500, 1000, 2000, 5000, 10000, 20000]:
    S = [p for p in primerange(3, K + 2) if n_order(2, p) == p - 1]
    I2 = [p for p in primerange(3, K + 2) if 2 * n_order(2, p) == p - 1]
    l2M = sum(math.log2(p) for p in S)
    # add index-2 primes greedily while total modulus <= 2^K; each contributes density (p+1)/(2p)
    tot = l2M; gain = 0.0
    for p in I2:
        if tot + math.log2(p) <= K:
            tot += math.log2(p); gain += -math.log2((p + 1) / (2 * p))
        else:
            break
    print(f"{K:6d} {len(S):6d} {l2M:12.2f} {1 - l2M / K:12.4f}            {1 - (l2M + gain) / K:10.4f}")


