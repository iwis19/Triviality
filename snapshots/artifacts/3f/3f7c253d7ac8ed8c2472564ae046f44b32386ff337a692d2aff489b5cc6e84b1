"""Runge-type analysis for even k=2j and square N=a^2 (Erdos #686).
F_k(t) = prod_{i=1}^k (t+i).  With u = t + (k+1)/2 (half-integer),
F_k = prod_{i=1}^{j} (u^2 - c_i^2),  c_i = i - 1/2.
P_j(u) := polynomial part of sqrt(F_k) as a Laurent series in 1/u (degree j, rational coeffs, 2-power denominators).
E_j(u) := P_j(u)^2 - F_k(u), of degree <= j-1 (even polynomial in u).
If F_k(m) = a^2 F_k(n) then sqrt(F_k(u_m)) = a sqrt(F_k(u_n)), so
  |P_j(u_m) - a P_j(u_n)| <= delta(u_m) + a delta(u_n),  delta(u) = |sqrt(F_k(u)) - P_j(u)| ~ |e_j|/2 * u^{deg E - j}.
If this is < 1/D_j (D_j = lcm of denominators of P_j), then P_j(u_m) = a P_j(u_n) exactly,
hence E_j(u_m) = a^2 E_j(u_n); with u_m ~ a^{1/j} u_n this forces a^{deg E / j} = a^2, impossible for a>1
once u_n is large: explicit finiteness for each fixed even k (Runge's method).
Output: for each even k, deg E, D_j, leading coeff e_j, threshold T(k,a) on u_n, and the forced lower bound
n >= k^2/log N - 2k (from N >= (1 + k/(n+2k))^k, using m >= n+k).
"""
import sympy as sp
from fractions import Fraction
from math import log

u, w = sp.symbols('u w')

def analyze(k, a):
    j = k // 2
    cs = [sp.Rational(2*i - 1, 2) for i in range(1, j+1)]
    G = sp.prod([1 - c**2 * w for c in cs])          # F_k = u^{2j} G(1/u^2)
    order = j // 2 + 1
    S = sp.series(sp.sqrt(G), w, 0, order).removeO()  # sqrt(G) = sum s_r w^r
    P = sp.expand(sum(S.coeff(w, r) * u**(j - 2*r) for r in range(0, j//2 + 1)))
    F = sp.expand(sp.prod([u**2 - c**2 for c in cs]))
    E = sp.expand(P**2 - F)
    Pp = sp.Poly(P, u); Ep = sp.Poly(E, u)
    D = sp.ilcm(*[sp.fraction(c)[1] for c in Pp.coeffs()])
    degE = Ep.degree(); e = Ep.LC()
    # threshold on u_n: (a+1) * |e|/2 * u^{degE-j} < 1/D   (using u_m >= u_n and delta decreasing)
    T = ((a + 1) * abs(e) * D / 2) ** sp.Rational(1, j - degE)
    return j, P, E, degE, e, D, sp.N(T, 6)

if __name__ == "__main__":
    a = 2  # N = 4
    N = a*a
    print("k  j  degE  D_j(denominator of P_j)   lead(E)   Runge threshold T(k,2) on u_n   forced n_min = k^2/log N - 2k")
    for k in range(4, 41, 2):
        j, P, E, degE, e, D, T = analyze(k, a)
        nmin = k*k/log(N) - 2*k
        print(f"{k:2d} {j:2d} {degE:4d}  {D!s:>22}  {sp.N(e,4)!s:>12}  {T!s:>14}  {nmin:10.1f}")
        if k <= 8:
            print("    P =", P); print("    E =", E)
