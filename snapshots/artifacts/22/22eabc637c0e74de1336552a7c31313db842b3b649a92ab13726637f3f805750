"""Hall witnesses for T5 failures.

T5 at x: an injection f: F_{not x} -> F_x with A subset f(A).
Hall: for every G subset F_{not x}, |N(G)| >= |G| where N(G) = {B in F_x : B contains some A in G}.
Since N is antitone in A, WLOG G is an up-set of (F_{not x}, subset).
Single-interval test: G_e = {A in F_{not x}: A contains e}; N(G_e) = {B in F_x : B contains e}.
So a NECESSARY condition for T5 at x is: x is abundant in F ∩ up(e) for every set e (equivalently for every e in F, e not containing x).
We check whether the single-interval test already explains every T5 failure found.
"""
import itertools, sys

def closure(gens):
    F = set(gens)
    changed = True
    while changed:
        changed = False
        for a in list(F):
            for b in list(F):
                if a | b not in F:
                    F.add(a | b); changed = True
    return F

def fam_from_str(s, n):
    F = set()
    for tok in s.split():
        if tok == 'e': F.add(0)
        else: F.add(sum(1 << (int(c) - 1) for c in tok))
    return F

def single_interval_witness(F, n, x):
    """return (e, count_without_x, count_with_x) with count_without > count_with, or None"""
    best = None
    for e in F:
        if e >> x & 1: continue
        up = [A for A in F if A & e == e]
        w = sum(1 for A in up if not (A >> x & 1))
        v = len(up) - w
        if w > v and (best is None or bin(e).count('1') < bin(best[0]).count('1')):
            best = (e, w, v)
    return best

def hall_violator(F, n, x):
    """brute force over up-sets? too many; instead find a violating G via max-matching deficiency (Konig).
    Here: minimal violating up-set by BFS on antichains would be complex; we only report single-interval witnesses."""
    return single_interval_witness(F, n, x)

def fmt(A):
    return ''.join(str(i + 1) for i in range(8) if A >> i & 1) or 'e'

def analyze(name, F, n):
    print(f"== {name}: |F|={len(F)}")
    for x in range(n):
        w = single_interval_witness(F, n, x)
        Fx = sum(1 for A in F if A >> x & 1)
        if w is None:
            print(f"  x={x+1}: freq {Fx}/{len(F)}; NO single-interval witness")
        else:
            print(f"  x={x+1}: freq {Fx}/{len(F)}; witness e={fmt(w[0])}: in up(e), #without x = {w[1]} > #with x = {w[2]}")

def cycle(m):
    return closure([(1 << i) | (1 << ((i + 1) % m)) for i in range(m)])

