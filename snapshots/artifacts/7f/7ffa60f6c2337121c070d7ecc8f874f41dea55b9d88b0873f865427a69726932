"""Checks for idea 2527fc6b: rotation classes of order-13 elements, single-orbit bounds."""
import numpy as np
from scipy.optimize import minimize_scalar, linprog

p = 13
# equivalence classes under b -> -b and b -> b^{-1}
def cls(b):
    s = {b % p, (-b) % p}
    inv = pow(b, -1, p)
    s |= {inv, (-inv) % p}
    return frozenset(s)
classes = sorted({cls(b) for b in range(1, p)}, key=min)
print("classes:", [sorted(c) for c in classes])

# single-orbit bound: min over s in [0,1] of max_k [s cos(2pi k/p) + (1-s) cos(2pi b k/p)]
def single_orbit(b):
    ks = np.arange(1, 7)
    c1 = np.cos(2 * np.pi * ks / p)
    cb = np.cos(2 * np.pi * b * ks / p)
    # LP: min z s.t. z >= s c1_k + (1-s) cb_k, 0<=s<=1
    # variables (s, z)
    A = np.column_stack([c1 - cb, -np.ones(6)])
    bvec = -cb
    res = linprog([0, 1], A_ub=A, b_ub=bvec, bounds=[(0, 1), (None, None)])
    return res.x[0], res.x[1]

for c in classes:
    b = min(c)
    s, z = single_orbit(b)
    print(f"b={b} class={sorted(c)}: min_s max_k cos = {z:.7f} at s={s:.6f}; angle = {np.degrees(np.arccos(z)):.3f} deg; excluded={z>0.5}")

