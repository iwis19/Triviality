#!/usr/bin/env python3
"""
Analyse the tipping set from degrey_stage1b: distances S = {1/sqrt3, sqrt(5/3), 0.736595474, 1.567618291}.
For H in {510, 517}:
  * which subsets of S already give UNSAT (minimal forbidden-distance sets),
  * does the augmented graph (unit edges + S-pairs) contain a K6? (trivial reason),
  * size of a vertex-minimal UNSAT subgraph (greedy deletion with assumptions).
Also identify the two unknown distances algebraically (mpmath identify).
"""
import sys, json, itertools, time
import numpy as np, mpmath as mp
from pysat.solvers import Cadical153
from degrey_stage1 import parse_vtx, parse_edges, var, K
import networkx as nx

root = '/home/ubuntu/CNP-SAT'
S = [0.577350269, 1.290994449, 0.736595474, 1.567618291]
mp.mp.dps = 30
for d in S:
    print(d, 'd^2 =', mp.identify(mp.mpf(d)**2, ['sqrt(3)', 'sqrt(11)', 'sqrt(33)']), flush=True)

def build(n, E, extra, sel):
    """clauses with a selector literal per vertex (for vertex-minimal core)."""
    cls = []
    for v in range(n):
        cls.append([-sel[v]] + [var(v, c) for c in range(K)])
    for u, v in E + extra:
        for c in range(K):
            cls.append([-var(u, c), -var(v, c)])
    return cls

for name in sys.argv[1:]:
    pts = parse_vtx(f'{root}/vtx/{name}.vtx'); n = len(pts)
    E = parse_edges(f'{root}/edge/{name}.edge')
    P = np.array([[float(x), float(y)] for x, y in pts])
    D = np.sqrt(((P[:, None, :] - P[None, :, :])**2).sum(-1)); UT = np.triu(D, 1)
    occ = {}
    for d in S:
        I, J = np.where(np.abs(UT - d) < 1e-9); occ[d] = [(int(i), int(j)) for i, j in zip(I, J)]
    sel = [n*K + 1 + v for v in range(n)]
    res = {'graph': name, 'subsets': {}}
    for r in range(1, len(S)+1):
        for sub in itertools.combinations(S, r):
            extra = sum((occ[d] for d in sub), [])
            with Cadical153(bootstrap_with=build(n, E, extra, sel)) as s:
                ok = s.solve(assumptions=sel)
            res['subsets'][str(sub)] = 'SAT' if ok else 'UNSAT'
    print(json.dumps(res), flush=True)
    extra = sum((occ[d] for d in S), [])
    G = nx.Graph(); G.add_edges_from(E + extra)
    w = max(len(c) for c in nx.find_cliques(G))
    print(json.dumps({'graph': name, 'clique_number_of_augmented_graph': w}), flush=True)
    # vertex-minimal UNSAT subgraph by greedy deletion
    with Cadical153(bootstrap_with=build(n, E, extra, sel)) as s:
        assert not s.solve(assumptions=sel)
        core = set(s.get_core())
        keep = [v for v in range(n) if sel[v] in core]
        changed = True
        while changed:
            changed = False
            for v in list(keep):
                trial = [x for x in keep if x != v]
                if not s.solve(assumptions=[sel[x] for x in trial]):
                    keep = trial; changed = True
        print(json.dumps({'graph': name, 'vertex_minimal_unsat_subgraph_size': len(keep), 'vertices': keep}), flush=True)
        sub = [(u, v) for u, v in E if u in keep and v in keep]
        subx = [(u, v) for u, v in extra if u in keep and v in keep]
        print(json.dumps({'graph': name, 'unit_edges_in_core': len(sub), 'extra_pairs_in_core': len(subx),
                          'core_points': [[mp.nstr(pts[v][0], 15), mp.nstr(pts[v][1], 15)] for v in keep]}), flush=True)

