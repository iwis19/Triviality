#!/usr/bin/env python3
"""
Stage-1 test for the de Grey-style two-stage argument at 5 colors.

For each graph H in Heule's CNP-SAT repository (https://github.com/marijnheule/CNP-SAT,
vtx/*.vtx = Mathematica-style exact coordinates, edge/*.edge = DIMACS unit-distance edges)
and for each 'rare property' P among
   P1: some pair of vertices at distance sqrt(3) is monochromatic
   P2: some pair of vertices at distance 1/sqrt(3) is monochromatic
   P3: some regular triangle of side sqrt(3) is monochromatic
we ask (SAT) whether there is a proper 5-coloring of H that is P-free, and if so,
we compute (MaxSAT, RC2) the minimum number of P-occurrences over all proper 5-colorings.

Distances are computed with mpmath at 60 digits; two lengths are "equal" if they
agree to 1e-30. Edge lists are cross-checked against the coordinate-derived unit pairs.
"""
import sys, re, time, itertools, json
import mpmath as mp
from pysat.formula import CNF, WCNF
from pysat.solvers import Cadical153
from pysat.examples.rc2 import RC2

mp.mp.dps = 60
TOL = mp.mpf('1e-30')
K = 5

def parse_vtx(path):
    pts = []
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        s = line.strip('{}')
        s = s.replace('Sqrt[', 'mp.sqrt(').replace(']', ')')
        s = re.sub(r'(?<![\w.])(\d+)(?![\w.])', r'mp.mpf(\1)', s)  # exact integers, no float division
        a, b = s.split(',', 1) if s.count(',') == 1 else split_top(s)
        pts.append((mp.mpf(eval(a, {'mp': mp})), mp.mpf(eval(b, {'mp': mp}))))
    return pts

def split_top(s):
    depth = 0
    for i, ch in enumerate(s):
        if ch in '([': depth += 1
        elif ch in ')]': depth -= 1
        elif ch == ',' and depth == 0:
            return s[:i], s[i+1:]
    raise ValueError(s)

def parse_edges(path):
    E = []
    for line in open(path):
        if line.startswith('e '):
            _, a, b = line.split()
            E.append((int(a)-1, int(b)-1))
    return E

def pairs_at(pts, d):
    """float prefilter (|dist-d|<1e-9) then 60-digit confirmation (|dist-d|<1e-30)."""
    import numpy as np
    P = np.array([[float(x), float(y)] for x, y in pts])
    D = np.sqrt(((P[:, None, :] - P[None, :, :])**2).sum(-1))
    I, J = np.where(np.abs(D - float(d)) < 1e-9)
    out = []
    for i, j in zip(I, J):
        if i < j:
            dx = pts[i][0] - pts[j][0]; dy = pts[i][1] - pts[j][1]
            if abs(mp.sqrt(dx*dx+dy*dy) - d) < TOL:
                out.append((int(i), int(j)))
    return sorted(out)

def triangles(pairs, n):
    adj = [set() for _ in range(n)]
    for i, j in pairs:
        adj[i].add(j); adj[j].add(i)
    T = set()
    for i, j in pairs:
        for k in adj[i] & adj[j]:
            T.add(tuple(sorted((i, j, k))))
    return sorted(T)

def var(v, c):  # colors 0..K-1
    return v*K + c + 1

def base_cnf(n, E):
    cnf = CNF()
    for v in range(n):
        cnf.append([var(v, c) for c in range(K)])
    for u, v in E:
        for c in range(K):
            cnf.append([-var(u, c), -var(v, c)])
    # symmetry breaking: vertex 0 gets color 0 (harmless: colors are interchangeable)
    cnf.append([var(0, 0)])
    return cnf

def run(name, n, E, occurrences, label, budget_s):
    """occurrences: list of vertex tuples (pairs or triples). P-free = no tuple monochromatic."""
    res = {'graph': name, 'property': label, 'num_occurrences': len(occurrences)}
    if not occurrences:
        res['pfree_5col'] = 'vacuous (no occurrences)'
        return res
    cnf = base_cnf(n, E)
    for tup in occurrences:
        for c in range(K):
            cnf.append([-var(v, c) for v in tup])
    t = time.time()
    with Cadical153(bootstrap_with=cnf.clauses) as s:
        sat = s.solve()
        model = s.get_model() if sat else None
    res['pfree_5col'] = 'SAT' if sat else 'UNSAT'
    res['pfree_time_s'] = round(time.time()-t, 2)
    if sat:
        col = [next(c for c in range(K) if model[var(v, c)-1] > 0) for v in range(n)]
        # sanity: proper and P-free
        assert all(col[u] != col[v] for u, v in E)
        assert all(len(set(col[v] for v in tup)) > 1 for tup in occurrences)
        res['min_occurrences'] = 0
        res['witness_coloring'] = col
    else:
        # minimum number of monochromatic occurrences via MaxSAT (RC2)
        wcnf = WCNF()
        for cl in base_cnf(n, E).clauses:
            wcnf.append(cl)
        top = n*K
        for tup in occurrences:
            top += 1; y = top
            for c in range(K):
                wcnf.append([y] + [-var(v, c) for v in tup])  # all same color c -> y
            wcnf.append([-y], weight=1)
        t = time.time()
        with RC2(wcnf, solver='cd15', adapt=True, exhaust=True, minz=True) as rc2:
            m = rc2.compute()
            res['min_occurrences'] = rc2.cost
        res['maxsat_time_s'] = round(time.time()-t, 2)
        col = [next(c for c in range(K) if m[var(v, c)-1] > 0) for v in range(n)]
        assert all(col[u] != col[v] for u, v in E)
        mono = [tup for tup in occurrences if len(set(col[v] for v in tup)) == 1]
        assert len(mono) == rc2.cost, (len(mono), rc2.cost)
        res['witness_coloring'] = col
        res['mono_occurrences_in_witness'] = mono
    return res

def main(names):
    root = sys.argv[1] if len(sys.argv) > 1 else '/home/ubuntu/CNP-SAT'
    results = []
    for name in names:
        pts = parse_vtx(f'{root}/vtx/{name}.vtx')
        n = len(pts)
        unit = pairs_at(pts, mp.mpf(1))
        try:
            E = parse_edges(f'{root}/edge/{name}.edge')
            same = set(map(tuple, map(sorted, E))) == set(unit)
        except FileNotFoundError:
            E, same = unit, 'edges derived from coordinates'
        s3 = pairs_at(pts, mp.sqrt(3))
        s13 = pairs_at(pts, 1/mp.sqrt(3))
        tri = triangles(s3, n)
        info = {'graph': name, 'n': n, 'unit_edges': len(unit), 'edge_file_matches_coords': same,
                'pairs_sqrt3': len(s3), 'pairs_1_over_sqrt3': len(s13), 'triangles_sqrt3': len(tri)}
        print(json.dumps(info), flush=True)
        results.append(info)
        # 4-colorability sanity (should be UNSAT for Heule's 5-chromatic graphs)
        global K
        K = 4
        with Cadical153(bootstrap_with=base_cnf(n, E).clauses) as s:
            info['4colorable'] = s.solve()
        K = 5
        for occ, label in [(s3, 'P1: mono pair at sqrt3'), (s13, 'P2: mono pair at 1/sqrt3'),
                           (tri, 'P3: mono regular triangle side sqrt3'),
                           (s3 + s13, 'P1 or P2: mono pair at sqrt3 or 1/sqrt3')]:
            r = run(name, n, E, occ, label, 600)
            print(json.dumps({k: v for k, v in r.items() if k != 'witness_coloring'}), flush=True)
            results.append(r)
        # full distance-spectrum scan: for each distance d occurring in H, is there a proper
        # 5-coloring with NO monochromatic pair at distance d?  (i.e. is H + {d-pairs} 5-colorable)
        import numpy as np
        P = np.array([[float(x), float(y)] for x, y in pts])
        D = np.sqrt(((P[:, None, :] - P[None, :, :])**2).sum(-1))
        iu = np.triu_indices(n, 1)
        ds, cnt = np.unique(np.round(D[iu], 9), return_counts=True)
        MINMULT = 100  # only distances realized by >= 100 vertex pairs are scanned (bounded budget)
        print(json.dumps({'graph': name, 'distinct_distances_total': int(len(ds)),
                          'scanned_with_multiplicity_ge': MINMULT,
                          'num_scanned': int((cnt >= MINMULT).sum())}), flush=True)
        spectrum = []
        forced = []
        UT = np.triu(D, 1)
        for dv, c in zip(ds, cnt):
            if dv < 1e-6 or c < MINMULT:
                continue
            I, J = np.where(np.abs(UT - dv) < 1e-9)
            occ = [(int(i), int(j)) for i, j in zip(I, J)]
            cnf = base_cnf(n, E)
            for u, v in occ:
                for c in range(K):
                    cnf.append([-var(u, c), -var(v, c)])
            t = time.time()
            with Cadical153(bootstrap_with=cnf.clauses) as s:
                sat = s.solve()
            spectrum.append((float(dv), len(occ), 'SAT' if sat else 'UNSAT', round(time.time()-t, 2)))
            print(json.dumps({'d': float(dv), 'pairs': len(occ), 'res': spectrum[-1][2], 't': spectrum[-1][3]}), flush=True)
            if not sat:
                forced.append(float(dv))
        info['num_distinct_distances'] = len(spectrum)
        info['distances_forcing_mono_pair_in_every_5col'] = forced
        info['spectrum'] = spectrum
        print(json.dumps({'graph': name, 'distinct_distances': len(spectrum), 'forced_distances': forced,
                          'never_forced_examples': [s for s in spectrum if s[1] >= 50][:10]}), flush=True)
    json.dump(results, open('/home/ubuntu/degrey_stage1_results.json', 'w'))

if __name__ == '__main__':
    main(sys.argv[2:] if len(sys.argv) > 2 else ['510', '517', '529', '553', '610', 'L403', 'S199', 'T721', 'G2167'])

