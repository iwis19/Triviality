#!/usr/bin/env python3
"""
de Grey's original stage-1 property, one level up.  In de Grey (2018) the 7-vertex hexagon H
(centre + regular unit hexagon) has, in every proper 4-colouring of a certain graph, a monochromatic
triple on its ring (the three alternate ring vertices).  Here: for Heule's 5-chromatic graphs H,
enumerate all embedded copies of the 7-vertex hexagon and ask by SAT whether a proper 5-colouring
exists in which
   Q1: no hexagon copy has a monochromatic alternate triple on its ring,
   Q2: no hexagon copy has its ring coloured with <= 2 colours,
   Q3: no hexagon copy has ANY monochromatic pair on its ring at distance sqrt3 (i.e. alternate
       vertices) -- same as P1 restricted to hexagon rings.
If SAT for all, the 7-hexagon carries no forced 'rare' 5-colour property in these graphs.
"""
import sys, json, itertools, time
import numpy as np, mpmath as mp
from pysat.solvers import Cadical153
from pysat.card import CardEnc, EncType
from pysat.formula import IDPool
from degrey_stage1 import parse_vtx, parse_edges, base_cnf, var, K

root = '/home/ubuntu/CNP-SAT'
for name in sys.argv[1:]:
    pts = parse_vtx(f'{root}/vtx/{name}.vtx'); n = len(pts)
    E = parse_edges(f'{root}/edge/{name}.edge')
    P = np.array([[float(x), float(y)] for x, y in pts])
    D = np.sqrt(((P[:, None, :] - P[None, :, :])**2).sum(-1))
    adj = [set(int(j) for j in np.where(np.abs(D[i]-1) < 1e-9)[0]) for i in range(n)]
    hexes = []
    for c in range(n):
        nb = sorted(adj[c])
        if len(nb) < 6: continue
        # find 6-cycles of unit edges among neighbours of c (ring of the hexagon)
        ring_adj = {u: [v for v in nb if abs(D[u, v]-1) < 1e-9] for u in nb}
        seen = set()
        for u in nb:
            if len(ring_adj[u]) < 2: continue
            for a in ring_adj[u]:
                path = [u, a]
                while len(path) < 6:
                    nxt = [v for v in ring_adj[path[-1]] if v != path[-2]]
                    if not nxt: break
                    path.append(nxt[0])
                if len(path) == 6 and u in ring_adj[path[-1]] and len(set(path)) == 6:
                    key = tuple(sorted(path))
                    if key not in seen:
                        seen.add(key); hexes.append((c, path))
    print(json.dumps({'graph': name, 'hexagon_copies': len(hexes)}), flush=True)
    for label in ['Q1_no_mono_alternate_triple', 'Q2_ring_uses_ge3_colours', 'Q3_no_mono_sqrt3_pair_on_ring']:
        cnf = base_cnf(n, E)
        pool = IDPool(start_from=n*K + 1)
        for c, ring in hexes:
            trip = [ring[0::2], ring[1::2]]
            if label == 'Q1_no_mono_alternate_triple':
                for t in trip:
                    for col in range(K):
                        cnf.append([-var(v, col) for v in t])
            elif label == 'Q3_no_mono_sqrt3_pair_on_ring':
                for t in trip:
                    for u, v in itertools.combinations(t, 2):
                        for col in range(K):
                            cnf.append([-var(u, col), -var(v, col)])
            else:  # ring uses >= 3 colours: 'colour col used on ring' indicator, at least 3 true
                used = []
                for col in range(K):
                    y = pool.id(('used', c, col)); used.append(y)
                    for v in ring:
                        cnf.append([-var(v, col), y])
                    cnf.append([-y] + [var(v, col) for v in ring])
                for cl in CardEnc.atleast(lits=used, bound=3, vpool=pool, encoding=EncType.seqcounter).clauses:
                    cnf.append(cl)
        t = time.time()
        with Cadical153(bootstrap_with=cnf.clauses) as s:
            ok = s.solve()
        print(json.dumps({'graph': name, 'property': label, 'free_5colouring': 'SAT' if ok else 'UNSAT',
                          't': round(time.time()-t, 2)}), flush=True)

