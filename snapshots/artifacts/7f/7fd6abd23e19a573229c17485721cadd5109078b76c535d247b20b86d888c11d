#!/usr/bin/env python3
"""
Slack measurement: how many 'popular' distances of H can be simultaneously forbidden from being
monochromatic while a proper 5-coloring of H still exists?

Distances sorted by multiplicity (number of vertex pairs realising them, float rounding 1e-9).
We add them one at a time (most popular first) as extra 'must differ' constraints on top of the
unit-distance edges and report the first prefix length at which 5-colorability fails, and the
distance that tips it.  Plus a coarse sweep by multiplicity threshold.
"""
import sys, json, time
import numpy as np
from pysat.solvers import Cadical153
from degrey_stage1 import parse_vtx, parse_edges, base_cnf, var, K

root = '/home/ubuntu/CNP-SAT'
out = {}
for name in sys.argv[1:]:
    pts = parse_vtx(f'{root}/vtx/{name}.vtx'); n = len(pts)
    E = parse_edges(f'{root}/edge/{name}.edge')
    P = np.array([[float(x), float(y)] for x, y in pts])
    D = np.sqrt(((P[:, None, :] - P[None, :, :])**2).sum(-1))
    UT = np.triu(D, 1); iu = np.triu_indices(n, 1)
    ds, cnt = np.unique(np.round(D[iu], 9), return_counts=True)
    order = np.argsort(-cnt)
    ds, cnt = ds[order], cnt[order]
    # exclude distance 1 itself (already edges) and 0
    keep = [(d, c) for d, c in zip(ds, cnt) if d > 1e-6 and abs(d-1) > 1e-9]
    pairs_of = {}
    def occ(d):
        if d not in pairs_of:
            I, J = np.where(np.abs(UT - d) < 1e-9)
            pairs_of[d] = [(int(i), int(j)) for i, j in zip(I, J)]
        return pairs_of[d]
    # incremental: one solver, add distance classes in decreasing multiplicity
    s = Cadical153(bootstrap_with=base_cnf(n, E).clauses)
    added = []
    t0 = time.time()
    tip = None
    for d, c in keep:
        for u, v in occ(d):
            for col in range(K):
                s.add_clause([-var(u, col), -var(v, col)])
        added.append((float(d), int(c)))
        ok = s.solve()
        print(json.dumps({'graph': name, 'num_forbidden_distances': len(added), 'last_added': [float(d), int(c)],
                          'sat': ok, 't': round(time.time()-t0, 1)}), flush=True)
        if not ok:
            tip = (float(d), int(c)); break
        if time.time() - t0 > 1500:
            break
    s.delete()
    out[name] = {'n': n, 'distinct_distances': int(len(keep)), 'forbidden_prefix_len_before_unsat': len(added) - (tip is not None),
                 'tipping_distance': tip, 'prefix': added, 'time_s': round(time.time()-t0, 1)}
    json.dump(out, open('/home/ubuntu/degrey_stage1b_results.json', 'w'))

