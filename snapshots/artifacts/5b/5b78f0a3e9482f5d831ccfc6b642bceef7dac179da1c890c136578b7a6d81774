#!/usr/bin/env python3
"""Hunter threshold for structured (lacunary / geometric) speed sets, testing whether it can drop
below 1/(2n-2) for n>=4 as it does for (1,3,9) at n=3."""
from fractions import Fraction
from lrc_bonferroni import best_threshold, exact_ML
M = 2520*8
fams = []
for n in range(3, 8):
    for r in (2, 3, 4, 5, 7):
        fams.append(tuple(r**i for i in range(n)))
    fams.append(tuple(2**i - 1 for i in range(1, n+1)))
    fams.append(tuple(3**i - 1 for i in range(1, n+1)) if n <= 5 else tuple(3**i for i in range(n)))
fams += [(1, 3, 9), (1, 3, 8), (1, 3, 10), (1, 4, 16), (1, 4, 12), (1, 5, 25), (1, 2, 4), (1, 3, 7),
         (1, 3, 9, 27), (1, 3, 9, 28), (1, 4, 16, 64), (1, 5, 25, 125), (1, 6, 36, 216)]
seen = set()
for v in fams:
    if v in seen: continue
    seen.add(v); n = len(v)
    dH = best_threshold(v, M, 1)
    ref = Fraction(1, 2*n-2)
    print(f"n={n} v={v}: Hunter dH={dH} ~ {float(dH):.5f}; 1/(2n-2)={float(ref):.5f}; "
          f"{'BELOW' if dH < ref else 'ok'}; gain*n^2={float((dH-Fraction(1,2*n))*n*n):.4f}; ML={exact_ML(v) if max(v) < 400 else '-'}", flush=True)


