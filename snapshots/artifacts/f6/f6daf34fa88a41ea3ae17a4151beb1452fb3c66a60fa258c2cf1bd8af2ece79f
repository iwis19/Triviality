import Mathlib

/-!
Repaired, explicit form of claim 615bf03 of idea da83ea71 (C = 1, A = 1), with the
singular-series lower bound 2*C_2 = 1.3203... replaced by 1.32 and the threshold raised to
N ≥ 10^12 (≤ 4·10^18, so still usable for the intended hybrid argument).

Claim 615bf03 as stated ("≥ 1 for N ≥ N_0 with N_0 defined by N^{1/2} = (C/2C_2) log^{A+2} N")
is false at N = N_0, where the difference is exactly 0 by construction; the correct
conclusion is strict positivity, which is all that r(N) ≥ 1 needs since r(N) is an integer.
Also N_0(1,1) ≈ 1.009·10^7, not 2.4·10^7.

The proof only uses log N ≤ 24 N^{1/24} (Mathlib's `Real.log_le_rpow_div`), which is why the
threshold here is 10^12 rather than the optimal ≈ 1.01·10^7.
-/

theorem main_dominates_error (N : ℝ) (hN : (10:ℝ) ^ 12 ≤ N) :
    0 < 1.32 * N / (Real.log N) ^ 2 - Real.sqrt N * Real.log N := by
  have hN0 : 0 < N := lt_of_lt_of_le (by norm_num) hN
  obtain ⟨y, hy0, hyN⟩ : ∃ y : ℝ, 0 ≤ y ∧ y ^ 24 = N :=
    ⟨N ^ ((1:ℝ) / 24), Real.rpow_nonneg hN0.le _, by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hN0.le]; norm_num⟩
  subst hyN
  have hN1 : 1 < y ^ 24 := lt_of_lt_of_le (by norm_num) hN
  have hL : 0 < Real.log (y ^ 24) := Real.log_pos hN1
  have hlog : Real.log (y ^ 24) ≤ 24 * y := by
    have h1 := Real.log_le_rpow_div (x := y ^ 24) (ε := (24:ℝ)⁻¹) (by positivity) (by norm_num)
    have h2 : (y ^ 24) ^ ((24:ℝ)⁻¹) = y := by
      have := Real.pow_rpow_inv_natCast hy0 (n := 24) (by norm_num)
      simpa using this
    rw [h2, div_inv_eq_mul] at h1
    linarith
  have hy3 : (3.16:ℝ) ≤ y := by
    by_contra h
    push_neg at h
    have h24 : y ^ 24 < (3.16:ℝ) ^ 24 := by gcongr
    have : (3.16:ℝ) ^ 24 < 10 ^ 12 := by norm_num
    linarith
  have hypos : 0 < y := by linarith
  have hs : Real.sqrt (y ^ 24) = y ^ 12 := by
    rw [show y ^ 24 = (y ^ 12) ^ 2 by ring]
    exact Real.sqrt_sq (by positivity)
  set L := Real.log (y ^ 24) with hLdef
  have hL3 : L ^ 3 ≤ (24 * y) ^ 3 := by gcongr
  have hy9 : (3.16:ℝ) ^ 9 ≤ y ^ 9 := by gcongr
  have key : L ^ 3 < 1.32 * y ^ 12 := by
    have h9 : (13824:ℝ) < 1.32 * y ^ 9 := by
      have : (13824:ℝ) < 1.32 * (3.16:ℝ) ^ 9 := by norm_num
      linarith
    have h3 : 0 < y ^ 3 := by positivity
    calc L ^ 3 ≤ (24 * y) ^ 3 := hL3
      _ = 13824 * y ^ 3 := by ring
      _ < (1.32 * y ^ 9) * y ^ 3 := by exact mul_lt_mul_of_pos_right h9 h3
      _ = 1.32 * y ^ 12 := by ring
  rw [hs, sub_pos, lt_div_iff₀ (by positivity)]
  have h12 : 0 < y ^ 12 := by positivity
  calc y ^ 12 * L * L ^ 2 = y ^ 12 * L ^ 3 := by ring
    _ < y ^ 12 * (1.32 * y ^ 12) := mul_lt_mul_of_pos_left key h12
    _ = 1.32 * y ^ 24 := by ring
