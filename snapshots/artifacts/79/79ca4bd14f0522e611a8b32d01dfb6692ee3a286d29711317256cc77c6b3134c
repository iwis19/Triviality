import numpy as np, math
d = np.load("/home/ubuntu/pp_data.npz")
Ns, R, HL, PP = d["Ns"], d["R"], d["HL"], d["PP"]
res = R - HL + PP
def show(mask, label):
    v = res[mask]; n = mask.sum()
    print(f"{label:28s} n={n:6d} mean(R-HL+PP)={v.mean():+.3f}±{v.std(ddof=1)/math.sqrt(n):.3f}  rel={(v/HL[mask]).mean():+.6f}  mean PP={PP[mask].mean():.2f}  mean HL={HL[mask].mean():.0f}")
print("== absolute residuals by divisibility ==")
show(Ns % 3 == 0, "3 | N"); show(Ns % 3 != 0, "3 !| N")
show(Ns % 5 == 0, "5 | N"); show(Ns % 5 != 0, "5 !| N")
show(Ns % 7 == 0, "7 | N"); show(Ns % 7 != 0, "7 !| N")
show((Ns % 3 != 0) & (Ns % 5 != 0) & (Ns % 7 != 0), "gcd(N,105)=1")
show((Ns % 3 == 0) & (Ns % 5 != 0) & (Ns % 7 != 0), "3|N, 5,7 !| N")
show((Ns % 15 == 0), "15 | N")
print("== 3|N residual vs N (constant edge effect or ~sqrt(N)/log^2 N ?) ==")
edges = [10**5, 2 * 10**5, 4 * 10**5, 7 * 10**5, 10**6 + 1]
for lo, hi in zip(edges[:-1], edges[1:]):
    m = (Ns >= lo) & (Ns < hi)
    for lab, mm in (("3|N", m & (Ns % 3 == 0)), ("3!|N", m & (Ns % 3 != 0))):
        v = res[mm]
        print(f"[{lo},{hi}) {lab:5s} mean={v.mean():+.3f}±{v.std(ddof=1)/math.sqrt(mm.sum()):.3f}  mean PP={PP[mm].mean():.2f}  ratio res/PP={v.mean()/PP[mm].mean():+.4f}")
# naive edge correction: for odd p | N the term t=p (and t=N-p) has HL density S/(log p log(N-p)) but N-p is never prime
C2 = 0.66016181584686957
def spf_factors(n):
    f = []; p = 2
    while p * p <= n:
        if n % p == 0:
            f.append(p)
            while n % p == 0: n //= p
        p += 1
    if n > 1: f.append(n)
    return f
sub = np.arange(0, len(Ns), 20)
E = np.zeros(len(sub))
for i, j in enumerate(sub):
    N = int(Ns[j]); S = HL[j] / (HL[j] / (2 * C2 * np.prod([(p - 1) / (p - 2) for p in spf_factors(N) if p > 2])))
    E[i] = sum(2 * S / (math.log(p) * math.log(N - p)) for p in spf_factors(N) if p > 2)
print("== naive t=p|N edge correction E(N) (subsample) ==")
m3 = Ns[sub] % 3 == 0
print(f"mean E | 3|N  = {E[m3].mean():.3f}   observed deficit 3|N = {res[sub][m3].mean():+.3f}")
print(f"mean E | 3!|N = {E[~m3].mean():.3f}  observed 3!|N = {res[sub][~m3].mean():+.3f}")
print(f"mean E overall = {E.mean():.3f}")


