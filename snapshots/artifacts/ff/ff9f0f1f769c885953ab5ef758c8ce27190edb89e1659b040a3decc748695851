// Toolchain-independent (C, no Python/numpy) recomputation of the covering statement of
// claim 104f3f3f (idea d2c8682b): for K=2..77, every candidate of block K
//   type A: n in (2^K, 2^K+K+1],  type B: n = M*i, i in [floor((2^K+K+1)/M)+1, floor(2^{K+1}/M)]
// with M = prod{p <= K+1 prime : 2 primitive root mod p} is killed by some (k<=min(K,31), prime q<=997)
// with q | n-2^k and q < n-2^k, unless it is a solution. Survivors are printed for exact
// re-verification outside this program. Per-k kill counts (smallest killing k) are printed.
// build: gcc -O2 -fopenmp cover.c -o cover
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
typedef unsigned long long u64; typedef unsigned __int128 u128;
#define QMAX 997
#define KCAP 31
static int PR[200], NP = 0;
static void sieve(void){ char s[QMAX+1]; memset(s,1,sizeof s); s[0]=s[1]=0;
  for(int i=2;i*i<=QMAX;i++) if(s[i]) for(int j=i*i;j<=QMAX;j+=i) s[j]=0;
  for(int i=2;i<=QMAX;i++) if(s[i]) PR[NP++]=i; }
static u64 powmod(u64 b,u64 e,u64 m){ u64 r=1%m; b%=m; while(e){ if(e&1) r=(u128)r*b%m; b=(u128)b*b%m; e>>=1;} return r; }
static int is_prime_small(u64 n){ if(n<2) return 0; for(u64 d=2; d*d<=n; d++) if(n%d==0) return 0; return 1; }
static int two_prim_root(u64 p){ // check 2^((p-1)/r) != 1 for all prime r | p-1
  if(p==2) return 0; u64 m=p-1;
  for(u64 r=2; r*r<=m; r++) if(m%r==0){ if(powmod(2,(p-1)/r,p)==1) return 0; while(m%r==0) m/=r; }
  if(m>1 && powmod(2,(p-1)/m,p)==1) return 0; return 1; }
static u64 inv_mod(u64 a,u64 q){ return powmod(a%q,q-2,q); } // q prime, a not divisible by q

int main(void){
  sieve();
  u64 totA=0, totB=0; u64 killsB[KCAP+2]={0}, killsA[KCAP+2]={0}; int maxkB=0;
  for(int K=2;K<=77;K++){
    u64 M=1; int cntS=0;
    for(u64 p=3;p<=(u64)K+1;p++) if(is_prime_small(p) && two_prim_root(p)){ M*=p; cntS++; }
    u128 lo=(u128)1<<K; u128 hi=(u128)1<<(K+1);
    // type A (exact 128-bit arithmetic)
    for(u128 n=lo+1; n<=lo+K+1; n++){
      totA++; int killed=0;
      for(int k=1;k<=K && k<=KCAP && !killed;k++){ u128 m=n-((u128)1<<k);
        for(int j=0;j<NP;j++){ u64 q=PR[j]; if(q<m && m%q==0){ killsA[k]++; killed=1; break; } } }
      if(!killed) printf("SURVIVOR A K=%d n=%llu (low 64 bits)\n",K,(u64)n);
    }
    u64 i_lo=(u64)((lo+K+1)/M)+1, i_hi=(u64)(hi/M);
    if(i_hi<i_lo){ printf("K=%2d |S|=%d M=%llu B=0\n",K,cntS,M); continue; }
    u64 nB=i_hi-i_lo+1; totB+=nB;
    if(K<=31){ // exact u64 arithmetic incl. properness q < n-2^k
      for(u64 i=i_lo;i<=i_hi;i++){ u64 n=M*i; int killed=0;
        for(int k=1;k<=K && !killed;k++){ u64 m=n-(1ULL<<k);
          for(int j=0;j<NP;j++){ u64 q=PR[j]; if(q<m && m%q==0){ killsB[k]++; killed=1; if(k>maxkB) maxkB=k; break; } } }
        if(!killed) printf("SURVIVOR B K=%d n=%llu\n",K,n); }
      printf("K=%2d |S|=%d M=%llu B=%llu exact\n",K,cntS,M,nB); fflush(stdout); continue;
    }
    // K >= 32: k <= 31 < K so n-2^k > 2^(K-1) >= 2^31 > 997, properness automatic.
    // mask[j][r] = bitmask over k (bit k-1) with r == 2^k * M^{-1} mod q_j, i.e. q_j | M i - 2^k when i = r mod q_j
    static uint32_t mask[200][QMAX];
    int usable[200], nu=0;
    for(int j=0;j<NP;j++){ u64 q=PR[j]; if(M%q==0) continue; usable[nu++]=j;
      memset(mask[j],0,sizeof(uint32_t)*q); u64 im=inv_mod(M,q);
      for(int k=1;k<=KCAP;k++){ u64 r=powmod(2,k,q)*im%q; mask[j][r]|=1u<<(k-1); } }
    u64 loc[KCAP+2]={0}; u64 nsurv=0;
    #pragma omp parallel
    { u64 lk[KCAP+2]={0};
      #pragma omp for schedule(dynamic,65536) reduction(+:nsurv)
      for(u64 i=i_lo;i<=i_hi;i++){ int best=99;
        for(int t=0;t<nu;t++){ int j=usable[t]; uint32_t m=mask[j][i%PR[j]]; if(m){ int k=__builtin_ctz(m)+1; if(k<best){ best=k; if(k==1) break; } } }
        if(best==99){ nsurv++; 
          #pragma omp critical
          printf("SURVIVOR B K=%d i=%llu\n",K,i); }
        else lk[best]++; }
      #pragma omp critical
      for(int k=1;k<=KCAP;k++) loc[k]+=lk[k]; }
    for(int k=1;k<=KCAP;k++){ killsB[k]+=loc[k]; if(loc[k] && k>maxkB) maxkB=k; }
    printf("K=%2d |S|=%d M=%llu B=%llu i=[%llu,%llu] survivors=%llu\n",K,cntS,M,nB,i_lo,i_hi,nsurv); fflush(stdout);
  }
  printf("typeA=%llu typeB=%llu total=%llu maxkB=%d\n",totA,totB,totA+totB,maxkB);
  printf("killsB:"); for(int k=1;k<=KCAP;k++) if(killsB[k]) printf(" %d:%llu",k,killsB[k]); printf("\n");
  printf("killsA:"); for(int k=1;k<=KCAP;k++) if(killsA[k]) printf(" %d:%llu",k,killsA[k]); printf("\n");
  return 0; }


