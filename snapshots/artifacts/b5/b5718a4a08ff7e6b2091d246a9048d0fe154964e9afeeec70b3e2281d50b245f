"""
Experiment E: can the modular lattices of Exp B be lifted to codimension-one lattices u^perp ∩ Z^d
(i.e. to honest Q-dissociated integer vectors u) WITHOUT letting Q -> infinity?

Exp B finds (Q, d, m, w) with x -> (sum x, w.x mod m) injective on [0,Q-1]^d.  The natural lift is
    u = M*(1,...,1) + w ,   M >= m,
because u.x = M*sum(x) + w.x.  We search the least M such that u is Q-dissociated (x -> u.x injective on
[0,Q-1]^d) and report the resulting ratio  max(u)/Q^(d-1)  (= max A / 2^(|A|-1) for the digit set when
Q is a power of two) versus the 'continuous' value  m*sqrt(d)/Q^(d-1)/sqrt(d) = m/Q^(d-1).
Own reasoning; assumption: none beyond the definitions.
"""
import numpy as np, sys

def injective(u, Q):
    vals = np.zeros(1, dtype=np.int64)
    for ui in u:
        vals = (vals[:, None] + np.arange(Q, dtype=np.int64)[None, :] * int(ui)).ravel()
    return len(np.unique(vals)) == len(vals)

def best_lift(Q, d, m, w, Mmax_factor=6):
    for M in range(1, Mmax_factor*m + 1):
        u = [M + wi for wi in w]
        if injective(u, Q):
            return M, u
    return None, None

CASES = [  # (Q, d, m_min, w) from Exp B output
    (2,3,3,[0,1,2]), (3,3,7,[0,1,3]), (4,3,13,[0,1,4]), (6,3,30,[0,1,9]), (8,3,49,[0,1,19]),
    (2,4,6,[0,1,2,4]), (3,4,19,[0,1,3,8]), (4,4,46,[0,1,4,14]), (5,4,89,[0,1,5,56]),
    (2,5,11,[0,1,2,4,7]), (3,5,55,[0,1,3,8,39]),
]

if __name__ == "__main__":
    print("Q d | m_min | least M with u=M*1+w Q-dissociated | u | max u / Q^(d-1) | m/Q^(d-1) (lattice value)")
    for Q, d, m, w in CASES:
        M, u = best_lift(Q, d, m, w)
        if M is None:
            print(f"{Q} {d} | {m} | no lift with M <= {6*m}"); continue
        print(f"{Q} {d} | {m} | M={M} | u={u} | {max(u)/Q**(d-1):.4f} | {m/Q**(d-1):.4f}")
