import itertools
from itertools import combinations
def uc_closure(gens):
    F=set(frozenset(g) for g in gens)
    ch=True
    while ch:
        ch=False
        for a in list(F):
            for b in list(F):
                u=a|b
                if u not in F: F.add(u); ch=True
    return F
def hall_T5(F,x):
    # inclusion-respecting injection F_{not x} -> F_x exists? via bipartite matching (Hopcroft-Karp naive)
    L=[A for A in F if x not in A]; R=[B for B in F if x in B]
    adj={A:[B for B in R if A<=B] for A in L}
    match={}
    def tr(A,seen):
        for B in adj[A]:
            if B in seen: continue
            seen.add(B)
            if B not in match or tr(match[B],seen):
                match[B]=A; return True
        return False
    return all(tr(A,set()) for A in L)
def cycle(m):
    return [(i,(i+1)%m) for i in range(m)]
