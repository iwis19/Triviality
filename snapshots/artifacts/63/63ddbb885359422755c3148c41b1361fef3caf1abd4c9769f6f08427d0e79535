#!/usr/bin/env python3
"""
Erdős #97, idea I1: search for convex LATTICE polygons (square lattice Z^2 and
Eisenstein lattice Z[w]) in which every vertex has >= 4 other vertices at a
common distance.  Exact integer arithmetic (squared norms) so equidistance is exact.

Deficit(S) = sum_v (4 - min(4, maxmult_v)), maxmult_v = max over radii of the
number of other vertices of S at that distance from v.  Deficit 0 <=> counterexample.
Simulated annealing over strictly-convex-position lattice subsets of a box.

Usage: python3 lattice_search.py [square|hex] [box N] [restarts] [iters] [seed]
"""
import sys, random, math
from collections import Counter

LAT = sys.argv[1] if len(sys.argv) > 1 else "square"
N = int(sys.argv[2]) if len(sys.argv) > 2 else 14
RESTARTS = int(sys.argv[3]) if len(sys.argv) > 3 else 20
ITERS = int(sys.argv[4]) if len(sys.argv) > 4 else 20000
SEED = int(sys.argv[5]) if len(sys.argv) > 5 else 1
random.seed(SEED)

def norm2(p, q):
    dx, dy = p[0] - q[0], p[1] - q[1]
    if LAT == "square":
        return dx * dx + dy * dy
    # Eisenstein: |a + b w|^2 = a^2 - ab + b^2
    return dx * dx - dx * dy + dy * dy

def cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

def hull(pts):
    pts = sorted(set(pts))
    if len(pts) <= 2:
        return pts
    lo, up = [], []
    for p in pts:
        while len(lo) >= 2 and cross(lo[-2], lo[-1], p) <= 0:
            lo.pop()
        lo.append(p)
    for p in reversed(pts):
        while len(up) >= 2 and cross(up[-2], up[-1], p) <= 0:
            up.pop()
        up.append(p)
    return lo[:-1] + up[:-1]

def strictly_convex(pts):
    # every point is a hull vertex (strict: collinear boundary points are removed by <= 0)
    return len(hull(pts)) == len(pts)

def maxmult(v, S):
    c = Counter(norm2(v, q) for q in S if q != v)
    return max(c.values()) if c else 0

def deficit(S):
    return sum(4 - min(4, maxmult(v, S)) for v in S)

def incidence_score(S):
    return sum(maxmult(v, S) for v in S)

box = [(x, y) for x in range(N + 1) for y in range(N + 1)]

def random_convex_start(k):
    for _ in range(1000):
        S = random.sample(box, k)
        H = hull(S)
        if len(H) >= 7:
            return H
    return hull(random.sample(box, k))

best_by_n = {}
best_inc_by_n = {}
global_best = None
for rs in range(RESTARTS):
    S = random_convex_start(random.randint(8, 16))
    cur = deficit(S)
    T0 = 2.0
    for it in range(ITERS):
        T = T0 * (1 - it / ITERS) + 0.05
        move = random.random()
        S2 = list(S)
        if move < 0.35 and len(S2) < 40:
            S2.append(random.choice(box))
        elif move < 0.55 and len(S2) > 7:
            S2.pop(random.randrange(len(S2)))
        else:
            i = random.randrange(len(S2))
            p = S2[i]
            q = (p[0] + random.randint(-2, 2), p[1] + random.randint(-2, 2))
            if not (0 <= q[0] <= N and 0 <= q[1] <= N):
                continue
            S2[i] = q
        if len(set(S2)) != len(S2) or not strictly_convex(S2):
            continue
        d2 = deficit(S2)
        # mild preference for larger n at equal deficit (more chances), via deficit per vertex
        if d2 <= cur or random.random() < math.exp(-(d2 - cur) / T):
            S, cur = S2, d2
            n = len(S)
            if n not in best_by_n or cur < best_by_n[n][0]:
                best_by_n[n] = (cur, sorted(S))
            inc = incidence_score(S)
            if n not in best_inc_by_n or inc > best_inc_by_n[n][0]:
                best_inc_by_n[n] = (inc, sorted(S))
            if global_best is None or cur < global_best[0]:
                global_best = (cur, n, sorted(S))
                if cur == 0:
                    print("COUNTEREXAMPLE CANDIDATE", S)
                    sys.exit(0)

print(f"lattice={LAT} box={N} restarts={RESTARTS} iters={ITERS} seed={SEED}")
print("n : min deficit found (0 would be a counterexample) ; max incidence score sum_v maxmult_v (4n needed)")
for n in sorted(best_by_n):
    print(f"{n:3d} : deficit {best_by_n[n][0]:3d}  (deficit/n={best_by_n[n][0]/n:.2f})   max_incidence {best_inc_by_n[n][0]:3d} (={best_inc_by_n[n][0]/n:.2f} n)")
print("global best:", global_best)
