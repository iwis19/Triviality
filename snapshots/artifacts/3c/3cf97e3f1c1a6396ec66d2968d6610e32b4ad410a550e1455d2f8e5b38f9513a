#!/usr/bin/env python3
"""L^1 norm of the Riesz-product Fourier transform of the digit set
A_p = {n < p^k : all base-p digits <= (p-1)/2} over Z/p^k, for k = 1..kmax.
Reports e_k = log_p( sum_a |hat A(a)| / |A| ) and the incremental exponent
log_p( L1_k / L1_{k-1} ) - log_p(t), t = (p+1)/2 (this converges to the true
asymptotic L^1 exponent if the limit exists).

Recursion: for a = a' + d p^{k-1} (a' < p^{k-1}), the factors for m <= k-1 depend
only on a', and the new factor is g((a' + d p^{k-1}) / p^k) with
g(theta) = |sum_{c<=t-1} e(c theta)| = |sin(pi t theta)/sin(pi theta)|.
So W_k(a) = W_{k-1}(a') * g((a'/p^{k-1} + d)/p).  We keep the full vector W_k.
"""
import sys
import numpy as np

p = int(sys.argv[1]); kmax = int(sys.argv[2])
t = (p + 1) // 2


def g(theta):
    theta = np.mod(theta, 1.0)
    num = np.abs(np.sin(np.pi * t * theta))
    den = np.abs(np.sin(np.pi * theta))
    with np.errstate(divide='ignore', invalid='ignore'):
        r = np.where(den < 1e-12, float(t), num / den)
    return r


W = np.ones(1)  # k=0
prev = 1.0
print(f"# p={p} t={t}")
print("k   L1/|A|        log_p(L1/|A|)   incremental exponent")
for k in range(1, kmax + 1):
    Q1 = p ** (k - 1)
    x = np.arange(Q1, dtype=np.float64) / Q1  # a'/p^{k-1}
    Wn = np.empty(p * Q1)
    for d in range(p):
        Wn[d * Q1:(d + 1) * Q1] = W * g((x + d) / p)
    W = Wn
    L1 = W.sum()
    A = float(t) ** k
    ek = np.log(L1 / A) / np.log(p)
    inc = (np.log(L1 / prev) - np.log(t)) / np.log(p)
    prev = L1
    print(f"{k:2d}  {L1/A:12.5f}  {ek:12.5f}  {inc:12.5f}")
    sys.stdout.flush()
