#!/usr/bin/env python3
"""Experiment for idea f9b98c22: Fourier form of pairwise overlap + sign-structure obstruction.

Part A: check identity  mu(B_a cap B_b) = 4d^2 + (2/(ab)) sum_{k>=1} sin(2pi k d a) sin(2pi k d b)/(pi^2 k^2)
        against the exact m-sum closed form (Fractions), for coprime a<b and rational d in (0,1/2].
Part B: Hunter threshold search (structured + simulated annealing) for n=5..8.
"""
import sys, random, math
from fractions import Fraction as Fr
from math import gcd
import mpmath as mp

mp.mp.dps = 40

def overlap_exact(vi, vj, d):
    """mu({||vi t||<d} cap {||vj t||<d}), d Fraction. Exact via m-sum closed form (claim 12f2cdd1)."""
    g = gcd(vi, vj); a, b = vi // g, vj // g
    if a > b: a, b = b, a
    top = d * (a + b)
    M = int(math.floor(top))
    s = Fr(0)
    for m in range(-M, M + 1):
        s += max(Fr(0), min(2 * d * a, 2 * d * b, top - abs(m)))
    return s / (a * b)

def overlap_fourier(a, b, d, K):
    """Truncated Fourier series (mpmath), plus rigorous tail bound 2/(ab pi^2 K)."""
    d = mp.mpf(d.numerator) / d.denominator
    s = mp.mpf(0)
    for k in range(1, K + 1):
        s += mp.sin(2 * mp.pi * k * d * a) * mp.sin(2 * mp.pi * k * d * b) / (mp.pi ** 2 * k ** 2)
    val = 4 * d ** 2 + 2 * s / (a * b)
    tail = mp.mpf(2) / (a * b * mp.pi ** 2 * K)
    return val, tail

def part_A(trials=300, seed=1):
    rng = random.Random(seed)
    worst = 0; fails = 0
    for _ in range(trials):
        a = rng.randint(1, 60); b = rng.randint(a + 1, 400)
        if gcd(a, b) != 1: continue
        den = rng.randint(2, 60); num = rng.randint(1, den // 2)
        d = Fr(num, den)
        ex = overlap_exact(a, b, d)
        K = 20000
        fv, tail = overlap_fourier(a, b, d, K)
        err = abs(fv - mp.mpf(ex.numerator) / ex.denominator)
        worst = max(worst, err / tail)
        if err > tail: fails += 1; print("FAIL", a, b, d, ex, fv, err, tail)
    print(f"PartA: {trials} trials, failures={fails}, max err/tailbound={mp.nstr(worst,5)}")
    # also some non-coprime pairs: identity applied to reduced pair
    for (vi, vj, d) in [(6, 15, Fr(1, 8)), (30, 290, Fr(1, 8)), (135, 495, Fr(1, 12))]:
        g = gcd(vi, vj); ex = overlap_exact(vi, vj, d); fv, tail = overlap_fourier(vi // g, vj // g, d, 20000)
        print(" noncoprime", vi, vj, d, ex, float(ex), mp.nstr(fv, 12), "err<=tail:", abs(fv - mp.mpf(ex.numerator) / ex.denominator) <= tail)

# ---------------- Part B ----------------
def overlap_float(vi, vj, d):
    g = gcd(vi, vj); a, b = vi // g, vj // g
    if a > b: a, b = b, a
    top = d * (a + b); M = int(math.floor(top)); s = 0.0
    da2, db2 = 2 * d * a, 2 * d * b
    for m in range(-M, M + 1):
        s += max(0.0, min(da2, db2, top - abs(m)))
    return s / (a * b)

def max_tree(v, d, ov=overlap_float):
    n = len(v); W = [[0] * n for _ in range(n)]
    for i in range(n):
        for j in range(i + 1, n):
            W[i][j] = W[j][i] = ov(v[i], v[j], d)
    intree = [False] * n; best = [None] * n; intree[0] = True
    for j in range(1, n): best[j] = W[0][j]
    tot = 0
    for _ in range(n - 1):
        j = max((j for j in range(n) if not intree[j]), key=lambda j: best[j])
        tot += best[j]; intree[j] = True
        for k in range(n):
            if not intree[k] and W[j][k] > best[k]: best[k] = W[j][k]
    return tot

def hunter_bound(v, d, ov=overlap_float):
    return 2 * len(v) * d - max_tree(v, d, ov)

def hunter_threshold(v, iters=50):
    """sup{d : 2nd - maxtree(d) < 1} by bisection (assumes monotone; verified by exact check at the end)."""
    lo, hi = 0.0, 0.5
    for _ in range(iters):
        mid = (lo + hi) / 2
        if hunter_bound(v, mid) < 1: lo = mid
        else: hi = mid
    return lo

def certify_below(v, d):
    """Exact: Hunter bound >= 1 at d  (so Hunter cannot certify ML >= d)."""
    return hunter_bound(v, d, overlap_exact) >= 1

def anneal(n, N, steps, seed, init=None):
    rng = random.Random(seed)
    v = sorted(init) if init else sorted(rng.sample(range(1, N + 1), n))
    def score(v):
        if math.gcd(*v) != 1: return 1.0
        return hunter_threshold(v, 40)
    cur = score(v); best = (cur, v[:]); T = 0.002
    for s in range(steps):
        w = v[:]; i = rng.randrange(n)
        w[i] = rng.randint(1, N) if rng.random() < 0.3 else min(N, max(1, w[i] + rng.randint(-5, 5)))
        if len(set(w)) < n: continue
        w.sort(); sc = score(w)
        if sc < cur or rng.random() < math.exp((cur - sc) / T):
            v, cur = w, sc
            if cur < best[0]: best = (cur, v[:])
        T *= 0.9995
    return best

def part_B():
    print("\nPartB: known examples from claim f9a0da3f")
    for v in [(30, 66, 75, 85, 290), (6, 180, 183, 202, 228), (15, 135, 170, 271, 287, 478, 495)]:
        n = len(v); d0 = Fr(1, 2 * n - 2)
        print(v, "thr=", hunter_threshold(list(v)), "1/(2n-2)=", float(d0), "exact bound>=1 at d0:", certify_below(v, d0))
    print("\nPartB: sign classes and structured constructions")
    for n in range(5, 9):
        d0 = Fr(1, 2 * n - 2); q = 2 * n - 2
        # residues r mod q with sin(2 pi r/q) > 0 / < 0
        pos = [r for r in range(q) if math.sin(2 * math.pi * r / q) > 1e-12]
        neg = [r for r in range(q) if math.sin(2 * math.pi * r / q) < -1e-12]
        print(f"n={n} q={q} pos residues {pos} neg residues {neg}")
    print("\nPartB: simulated annealing, minimize Hunter threshold")
    results = {}
    for n in range(5, 9):
        d0 = 1 / (2 * n - 2); best = (1, None)
        for N, seed in [(120, 1), (300, 2), (600, 3), (600, 4)]:
            b = anneal(n, N, 1500, seed)
            print(f" n={n} N={N} seed={seed} best thr={b[0]:.7f} ratio thr/d0={b[0]/d0:.6f} set={b[1]}", flush=True)
            if b[0] < best[0]: best = b
        v = best[1]; d0f = Fr(1, 2 * n - 2)
        print(f" n={n} BEST thr={best[0]:.8f} d0={d0:.8f} rel deficit={(d0-best[0])/d0:.5f} set={v} exact(bound>=1 at d0)={certify_below(v, d0f)}")
        # sign classes of best set at d0
        cls = [(x, 'pos' if math.sin(2 * math.pi * x * d0) > 0 else 'neg') for x in v]
        print("   k=1 sign classes:", cls)
        results[n] = (best, cls)
    return results

if __name__ == "__main__":
    part_A()
    part_B()


