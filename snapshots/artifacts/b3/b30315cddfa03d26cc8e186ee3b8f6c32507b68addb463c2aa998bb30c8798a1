#!/usr/bin/env python3
"""Seeded local search minimizing T(d0) = max spanning tree overlap sum at d0=1/(2n-2).
Objective ratio r = T(d0)/((n-1)(2d0)^2); r<1 <=> Hunter threshold < d0. Report exact values + Hunter threshold."""
import sys, math, random
from fractions import Fraction as Fr
sys.path.insert(0, '/home/ubuntu')
from lrc_fourier import max_tree, overlap_exact, hunter_threshold

seeds = {
 5: [(30, 66, 75, 85, 290), (6, 180, 183, 202, 228), (2, 138, 190, 247, 252)],
 6: [(1, 6, 48, 108, 168, 288), (1, 6, 16, 36, 56, 96)],
 7: [(2, 9, 16, 33, 81, 88, 112), (15, 135, 170, 271, 287, 478, 495)],
 8: [(1, 12, 96, 162, 208, 264, 306, 320), (5, 8, 45, 64, 78, 108, 176, 204)],
}

def local(v, N, steps, rng):
    n = len(v); d0 = 1 / (2 * n - 2); base = (n - 1) * 4 * d0 * d0
    def sc(w):
        if math.gcd(*w) != 1 or len(set(w)) < n: return 9.0
        return max_tree(list(w), d0) / base
    cur = sc(v); best = (cur, tuple(v))
    for s in range(steps):
        w = list(v); i = rng.randrange(n); mv = rng.random()
        if mv < 0.3: w[i] = rng.randint(1, N)
        elif mv < 0.6: w[i] = max(1, min(N, w[i] + rng.randint(-3, 3)))
        elif mv < 0.8:
            f = rng.choice([2, 3, 4, 5, 6, 7]); w[i] = w[i] * f if w[i] * f <= N else max(1, w[i] // f)
        else:  # scale all but one by small factor (keeps reduced pairs among them)
            f = rng.choice([2, 3]); w = [x * f if j != i and x * f <= N else x for j, x in enumerate(w)]
        w = sorted(w); c = sc(w)
        if c <= cur or rng.random() < 0.02:
            v, cur = w, c
            if c < best[0]: best = (c, tuple(w))
    return best

if __name__ == "__main__":
    rng = random.Random(7)
    for n in range(5, 9):
        overall = None
        for sd in seeds[n]:
            for N in (600, 3000):
                b = local(list(sd), N, 3000, rng)
                if overall is None or b[0] < overall[0]: overall = b
                print(f"n={n} seed {sd} N={N}: r={b[0]:.6f} set={b[1]}", flush=True)
        r, v = overall; d0f = Fr(1, 2 * n - 2); Tex = max_tree(list(v), d0f, overlap_exact)
        thr = hunter_threshold(list(v), 50)
        print(f"n={n} OVERALL: set={v} exact T(d0)={Tex} ({float(Tex):.7f}) vs (n-1)(2d0)^2={(n-1)*4*d0f*d0f}; Hunter thr={thr:.8f}; rel deficit {(float(d0f)-thr)/float(d0f):.6f}", flush=True)


