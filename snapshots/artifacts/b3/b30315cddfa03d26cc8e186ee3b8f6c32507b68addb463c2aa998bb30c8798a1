#!/usr/bin/env python3
"""Search for speed sets in which EVERY pair has overlap < (2d)^2 at d=1/(2n-2)
(all-negative correction), via clique search in the 'negative overlap' graph on [1..N].
Any such set automatically has max spanning tree sum < (n-1)(2d)^2, i.e. Hunter threshold < 1/(2n-2).
Then minimize T(d0)/((n-1)(2d0)^2) over found cliques and report the exact Hunter threshold deficit."""
import sys, math, itertools
from fractions import Fraction as Fr
from math import gcd
sys.path.insert(0, '/home/ubuntu')
from lrc_fourier import overlap_float, overlap_exact, max_tree, hunter_threshold, hunter_bound

def run(n, N, maxcliques=20000):
    d0 = 1 / (2 * n - 2); base = 4 * d0 * d0
    ov = {}
    neg = {i: set() for i in range(1, N + 1)}
    for a in range(1, N + 1):
        for b in range(a + 1, N + 1):
            o = overlap_float(a, b, d0); ov[(a, b)] = o
            if o < base - 1e-12: neg[a].add(b); neg[b].add(a)
    # simple clique enumeration (Bron-Kerbosch style, size n), bounded
    found = []
    def extend(clique, cands):
        if len(found) >= maxcliques: return
        if len(clique) == n: found.append(tuple(clique)); return
        for c in sorted(cands):
            if c < clique[-1]: continue
            extend(clique + [c], cands & neg[c])
    for a in range(1, N + 1):
        extend([a], set(neg[a]))
        if len(found) >= maxcliques: break
    print(f"n={n} N={N}: negative-graph edges={sum(len(s) for s in neg.values())//2} of {N*(N-1)//2}; all-negative {n}-cliques found: {len(found)} (cap {maxcliques})", flush=True)
    best = None
    for cl in found:
        if math.gcd(*cl) != 1: continue
        T = max_tree(list(cl), d0)
        r = T / ((n - 1) * base)
        if best is None or r < best[0]: best = (r, cl, T)
    if best:
        r, cl, T = best
        thr = hunter_threshold(list(cl), 50)
        d0f = Fr(1, 2 * n - 2)
        Tex = (n - 1) * 4 * d0f * d0f - (hunter_bound(cl, d0f, overlap_exact) - 2 * n * d0f + max_tree(list(cl), d0f, overlap_exact)) # placeholder
        Tex = max_tree(list(cl), d0f, overlap_exact)
        print(f"  best all-negative set {cl}: T(d0)/((n-1)(2d0)^2)={r:.6f}  exact T={Tex} vs {(n-1)*4*d0f*d0f}; Hunter thr={thr:.8f}, rel deficit={(d0-thr)/d0:.6f}")
        # pairwise reduced residues
        q = 2 * n - 2
        print("  reduced pairs (a/g,b/g) mod q:", [((a // gcd(a, b)) % q, (b // gcd(a, b)) % q) for a, b in itertools.combinations(cl, 2)])
    return best

if __name__ == "__main__":
    for n, N in [(5, 120), (5, 250), (6, 160), (6, 300), (7, 200), (7, 350), (8, 250), (8, 400)]:
        run(n, N)


