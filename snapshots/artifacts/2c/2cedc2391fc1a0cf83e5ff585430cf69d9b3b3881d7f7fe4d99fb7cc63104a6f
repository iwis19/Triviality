"""Construct D5 and C5-40b (Leech / Cohn-Jiao-Kumar-Torquato 2011) kissing configurations on S^4,
list their inner-product spectra and estimate their covering radii (deepest holes)."""
import itertools
import numpy as np
from scipy.optimize import minimize

r2 = np.sqrt(2.0)
# 24-cell: permutations of (+-1,+-1,0,0)/sqrt2
cell24 = []
for i, j in itertools.combinations(range(4), 2):
    for si in (1, -1):
        for sj in (1, -1):
            v = np.zeros(4); v[i] = si; v[j] = sj
            cell24.append(v / r2)
cell24 = np.array(cell24)
coset_a = np.array([s * np.eye(4)[i] for i in range(4) for s in (1, -1)])  # +-e_i
half = np.array([np.array(s) / 2.0 for s in itertools.product((1, -1), repeat=4)])
coset_b = np.array([w for w in half if np.prod(np.sign(w)) > 0])  # even number of minus signs
coset_c = np.array([w for w in half if np.prod(np.sign(w)) < 0])


def layered(E, A, B, cA=1 / r2, cB=-1 / r2):
    pts = [np.append(v, 0.0) for v in E]
    pts += [np.append(np.sqrt(1 - cA ** 2) * u, cA) for u in A]
    pts += [np.append(np.sqrt(1 - cB ** 2) * u, cB) for u in B]
    return np.array(pts)


D5 = layered(cell24, coset_a, coset_a)
C540b = layered(cell24, coset_a, coset_b)


def spectrum(X):
    G = X @ X.T
    iu = np.triu_indices(len(X), 1)
    vals = np.round(G[iu], 10)
    u, c = np.unique(vals, return_counts=True)
    return dict(zip(u.tolist(), c.tolist())), G[iu].max()


def covering_radius(X, starts=3000, seed=0):
    rng = np.random.default_rng(seed)
    best = 1.0  # minimise max inner product
    bestp = None

    def f(p):
        p = p / np.linalg.norm(p)
        return np.max(X @ p)
    for _ in range(starts):
        p0 = rng.normal(size=5)
        res = minimize(f, p0, method="Nelder-Mead", options={"xatol": 1e-10, "fatol": 1e-12, "maxiter": 4000})
        if res.fun < best:
            best = res.fun
            bestp = res.x / np.linalg.norm(res.x)
    return best, np.degrees(np.arccos(best)), bestp


for name, X in [("D5", D5), ("C5-40b", C540b)]:
    spec, mx = spectrum(X)
    print(name, "N =", len(X), "max inner product =", mx)
    print("  inner-product spectrum (value: count):", spec)
    print("  is inner product set inside {-1,-1/2,0,1/2}?", all(abs(v - round(v * 2) / 2) < 1e-9 for v in spec))
    c, deg, p = covering_radius(X, starts=1500)
    print(f"  deepest hole: max cos = {c:.6f} (2/sqrt10 = {2/np.sqrt(10):.6f}), angle = {deg:.4f} deg, direction = {np.round(p*np.sqrt(5),4)}")

# 24-cell covering radius
def cov4(E, starts=2000, seed=1):
    rng = np.random.default_rng(seed)
    best = 1.0
    for _ in range(starts):
        p0 = rng.normal(size=4)
        res = minimize(lambda p: np.max(E @ (p / np.linalg.norm(p))), p0, method="Nelder-Mead",
                       options={"xatol": 1e-10, "fatol": 1e-12, "maxiter": 4000})
        best = min(best, res.fun)
    return best
c4 = cov4(cell24)
print(f"24-cell covering radius: max cos = {c4:.6f} (1/sqrt2 = {1/np.sqrt(2):.6f}) angle = {np.degrees(np.arccos(c4)):.4f} deg")

