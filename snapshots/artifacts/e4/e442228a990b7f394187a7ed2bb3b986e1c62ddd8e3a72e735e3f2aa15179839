#!/usr/bin/env python3
"""
gen_cert.py -- witness-logged wheel search for Erdos problem #1142.

For each block K (2^K < n <= 2^{K+1}) the candidates are (lemma C1/C9 of the lab, Lean-checked
in the form dvd_of_erdos1142_of_primitiveRoot):
  type A: n = 2^K + j, 1 <= j <= K+1                       (all integers in (2^K, 2^K+K+1])
  type B: n = M*i, with M = M_S(K) = prod{p prime <= K+1 : ord_p(2) = p-1}
          and (2^K+K+1) < M*i <= 2^{K+1}, i.e. i in [i_lo, i_hi].
For every candidate we output a compositeness witness for some n - 2^k (1<=k<=K):
  ('f', q):  q is a proper divisor of m = n - 2^k, 1 < q < m
  ('mr', a): a is a strong (Miller-Rabin) witness for m (m odd, > 2)
  ('one',):  m == 1
or record n as a SOLUTION (all n-2^k prime).

Output (directory OUT):
  typeA.txt      lines: K j k kind w
  blockK.npz     arrays kk (uint8), ww (uint16) indexed by i - i_lo; meta = [K, i_lo, i_hi]
                 kk[t]=k, ww[t]=q  means ('f', q) at k for n = M*(i_lo+t)
                 kk[t]=0           means entry is in mr.txt (or solutions.txt)
  mr.txt         lines: K i k kind w   (type B entries not killed by a small factor)
  solutions.txt  lines: K type idx n
  summary.txt    per-block counts and timing
Assumptions: gmpy2.is_prime (Miller-Rabin, 40 rounds) never declares a prime composite
(true for Miller-Rabin); a 'prime' verdict on a composite can only produce a spurious SOLUTION line,
never hide a real solution -- and SOLUTION lines are re-checked by the checker anyway.
"""
import sys, os, time
import numpy as np
import gmpy2
from sympy import primerange, n_order

B = 1000  # trial-division bound
SMALL_PRIMES = list(primerange(2, B + 1))
NUMPY_THRESHOLD = 3000  # use numpy sieve path when block has more candidates than this


def S_of_K(K):
    return [p for p in primerange(3, K + 2) if n_order(2, p) == p - 1]


def strong_witness(m):
    """Return a base a (2 <= a < m) that is a strong witness for compositeness of odd m > 2."""
    d, s = m - 1, 0
    while d % 2 == 0:
        d //= 2
        s += 1
    for a in SMALL_PRIMES + list(range(B + 1, 10 ** 6)):
        if a >= m:
            break
        x = pow(a, d, m)
        if x == 1 or x == m - 1:
            continue
        witness = True
        for _ in range(s - 1):
            x = x * x % m
            if x == m - 1:
                witness = False
                break
        if witness:
            return a
    raise RuntimeError("no strong witness found for %d" % m)


def small_witness(m):
    """('one',) if m == 1; ('f', q) if m has a prime factor q <= B with q < m; else None."""
    if m < 2:
        return ('one',) if m == 1 else ('zero',)
    for q in SMALL_PRIMES:
        if q >= m:
            return None  # m is a prime <= B
        if m % q == 0:
            return ('f', q)
    return None


def check_candidate(n, K):
    """Some (k, witness) with n-2^k composite (small factors preferred), or None (solution)."""
    for k in range(1, K + 1):
        w = small_witness(n - (1 << k))
        if w is not None:
            return k, w
    for k in range(1, K + 1):
        m = n - (1 << k)
        if m > B and not gmpy2.is_prime(m, 40):
            return k, ('mr', strong_witness(m))
    return None


def run_block(K, out, fA, fMR, fSOL, fSUM):
    t0 = time.time()
    S = S_of_K(K)
    M = 1
    for p in S:
        M *= p
    lo, hi = 1 << K, 1 << (K + 1)
    # type A
    nsol = 0
    for j in range(1, K + 2):
        r = check_candidate(lo + j, K)
        if r is None:
            fSOL.write("%d A %d %d\n" % (K, j, lo + j)); nsol += 1
            fA.write("%d %d 0 sol 0\n" % (K, j))
        else:
            k, w = r
            fA.write("%d %d %d %s %s\n" % (K, j, k, w[0], w[1] if len(w) > 1 else 0))
    # type B
    i_lo = (lo + K + 1) // M + 1
    i_hi = hi // M
    N = i_hi - i_lo + 1
    if N <= 0:
        kk = np.zeros(0, np.uint8); ww = np.zeros(0, np.uint16); nmr = 0; N = 0
    elif N < NUMPY_THRESHOLD:
        kk = np.zeros(N, np.uint8); ww = np.zeros(N, np.uint16); nmr = 0
        for t in range(N):
            n = M * (i_lo + t)
            r = check_candidate(n, K)
            if r is None:
                fSOL.write("%d B %d %d\n" % (K, i_lo + t, n)); nsol += 1
                fMR.write("%d %d 0 sol 0\n" % (K, i_lo + t)); nmr += 1
            else:
                k, w = r
                if w[0] == 'f':
                    kk[t] = k; ww[t] = w[1]
                else:
                    fMR.write("%d %d %d %s %s\n" % (K, i_lo + t, k, w[0], w[1] if len(w) > 1 else 0)); nmr += 1
    else:
        kk = np.zeros(N, np.uint8); ww = np.zeros(N, np.uint16)
        idx = np.arange(i_lo, i_hi + 1, dtype=np.int64)
        # k = 1, slice sieve over all indices. n even  <=> i even (M odd); n-2 even and > 2.
        start_even = (i_lo % 2)  # t with i even
        kk[start_even::2] = 1; ww[start_even::2] = 2
        Minv = {}
        for q in SMALL_PRIMES[1:]:
            if M % q == 0:
                continue
            Minv[q] = pow(M, -1, q)
            r = (2 * Minv[q]) % q          # i ≡ 2 * M^{-1} (mod q)  <=>  q | M*i - 2
            t0q = (r - i_lo) % q
            sl = ww[t0q::q]
            mask = sl == 0
            sl[mask] = q
            kk[t0q::q][mask] = 1
        surv = np.nonzero(kk == 0)[0]
        # k = 2 .. K-1: modulo sieve on compacted survivors
        for k in range(2, K):
            if surv.size == 0:
                break
            si = idx[surv]
            killed = np.zeros(surv.size, dtype=bool)
            for q in SMALL_PRIMES[1:]:
                if M % q == 0:
                    continue
                r = (pow(2, k, q) * Minv[q]) % q
                hit = (~killed) & ((si % q) == r)
                if hit.any():
                    kk[surv[hit]] = k; ww[surv[hit]] = q
                    killed |= hit
            surv = surv[~killed]
        # remaining survivors: individual treatment (covers k = K and MR witnesses)
        nmr = 0
        for t in surv.tolist():
            n = M * (i_lo + t)
            r = check_candidate(n, K)
            if r is None:
                fSOL.write("%d B %d %d\n" % (K, i_lo + t, n)); nsol += 1
                fMR.write("%d %d 0 sol 0\n" % (K, i_lo + t)); nmr += 1
            else:
                k, w = r
                if w[0] == 'f':
                    kk[t] = k; ww[t] = w[1]
                else:
                    fMR.write("%d %d %d %s %s\n" % (K, i_lo + t, k, w[0], w[1] if len(w) > 1 else 0)); nmr += 1
    np.savez_compressed(os.path.join(out, "block%02d.npz" % K), kk=kk, ww=ww,
                        meta=np.array([K, i_lo, i_hi], dtype=object))
    dt = time.time() - t0
    line = "K=%d S=%s M=%d i_lo=%d i_hi=%d N_B=%d N_A=%d mr_entries=%d solutions=%d time=%.1fs" % (
        K, S, M, i_lo, i_hi, N, K + 1, nmr, nsol, dt)
    print(line, flush=True); fSUM.write(line + "\n"); fSUM.flush()
    for f in (fA, fMR, fSOL):
        f.flush()


if __name__ == "__main__":
    Kmin, Kmax = int(sys.argv[1]), int(sys.argv[2])
    out = sys.argv[3] if len(sys.argv) > 3 else "/home/ubuntu/erdos1142_cert/out"
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, "typeA.txt"), "a") as fA, open(os.path.join(out, "mr.txt"), "a") as fMR, \
            open(os.path.join(out, "solutions.txt"), "a") as fSOL, open(os.path.join(out, "summary.txt"), "a") as fSUM:
        for K in range(Kmin, Kmax + 1):
            run_block(K, out, fA, fMR, fSOL, fSUM)
