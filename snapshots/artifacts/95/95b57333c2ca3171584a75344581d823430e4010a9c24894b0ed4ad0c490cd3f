# greedy_sweep.py
```python
import json
from apcover import primes_upto, allowed
k, d = 11, 2310
W = (k - 1) * d
cnt = [0] * (W + 1)
ap = {j * d for j in range(k)}
out = []
first0 = None
for p in primes_upto(6000):
    best, bestr = -1, None
    for r in allowed(p, k, d):
        g = sum(1 for x in range(r, W + 1, p) if cnt[x] == 0)
        if g > best: best, bestr = g, r
    for x in range(bestr, W + 1, p): cnt[x] += 1
    r = sum(1 for x in range(W + 1) if x not in ap and cnt[x] == 0)
    out.append((p, r))
    if r == 0 and first0 is None:
        first0 = p; break
print('first greedy P with r=0:', first0)
for p, r in out:
    if p in (227, 251, 281, 500 - 1, 997, 1499, 1999, 2999, 4001, 5003) or r == 0 or p < 60 and p > 40:
        print(p, r)
json.dump(out, open('greedy_sweep.json', 'w'))

