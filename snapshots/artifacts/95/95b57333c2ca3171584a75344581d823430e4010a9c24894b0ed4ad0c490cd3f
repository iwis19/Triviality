# apcover.py
```python
#!/usr/bin/env python3
"""AP-covering for CPAP-k templates (k=11, d=2310 by default).

Positions x in [0, W], W=(k-1)*d. AP positions A = {j*d : j<k}.
For each prime p <= P choose a residue r_p with r_p != a mod p for all a in A
(so no AP term is divisible by p).  Position x is covered if x = r_p (mod p)
for some p.  r(P) = #{x in [0,W] \ A : x uncovered}.
Greedy: primes ascending, pick residue covering most currently-uncovered positions.
Anneal: start from greedy, single-prime residue changes, Metropolis acceptance.
"""
import sys, math, random, time, json

def primes_upto(n):
    s = bytearray([1]) * (n + 1); s[0:2] = b'\x00\x00'
    for i in range(2, int(n ** .5) + 1):
        if s[i]: s[i*i::i] = bytearray(len(s[i*i::i]))
    return [i for i in range(n + 1) if s[i]]

def allowed(p, k, d):
    bad = {(j * d) % p for j in range(k)}
    return [r for r in range(p) if r not in bad]

def greedy(P, k=11, d=2310):
    W = (k - 1) * d
    cnt = [0] * (W + 1)
    isap = [False] * (W + 1)
    for j in range(k): isap[j * d] = True
    res = {}
    for p in primes_upto(P):
        best, bestr = -1, None
        for r in allowed(p, k, d):
            g = sum(1 for x in range(r, W + 1, p) if cnt[x] == 0)
            if g > best: best, bestr = g, r
        res[p] = bestr
        for x in range(bestr, W + 1, p): cnt[x] += 1
    r = sum(1 for x in range(W + 1) if not isap[x] and cnt[x] == 0)
    return res, cnt, r

def anneal(P, res, cnt, r, k=11, d=2310, iters=2_000_000, T0=2.0, T1=0.05, seed=0):
    rng = random.Random(seed)
    W = (k - 1) * d
    ps = sorted(res)
    allow = {p: allowed(p, k, d) for p in ps}
    best_r, best_res = r, dict(res)
    for it in range(iters):
        T = T0 * (T1 / T0) ** (it / iters)
        p = ps[rng.randrange(len(ps))]
        old = res[p]
        new = allow[p][rng.randrange(len(allow[p]))]
        if new == old: continue
        # delta: positions lost (cnt==1 in old class) minus gained (cnt==0 in new class)
        lost = sum(1 for x in range(old, W + 1, p) if cnt[x] == 1)
        gain = sum(1 for x in range(new, W + 1, p) if cnt[x] == 0)
        delta = lost - gain
        if delta <= 0 or rng.random() < math.exp(-delta / T):
            for x in range(old, W + 1, p): cnt[x] -= 1
            for x in range(new, W + 1, p): cnt[x] += 1
            res[p] = new
            r += delta
            if r < best_r: best_r, best_res = r, dict(res)
    return best_r, best_res

def verify(P, res, k=11, d=2310):
    W = (k - 1) * d
    cov = [False] * (W + 1)
    for p, rr in res.items():
        assert p <= P and 0 <= rr < p
        for j in range(k): assert (j * d - rr) % p != 0
        for x in range(rr, W + 1, p): cov[x] = True
    ap = {j * d for j in range(k)}
    return sum(1 for x in range(W + 1) if x not in ap and not cov[x])

if __name__ == '__main__':
    P = int(sys.argv[1]); iters = int(sys.argv[2]) if len(sys.argv) > 2 else 2_000_000
    seed = int(sys.argv[3]) if len(sys.argv) > 3 else 0
    t = time.time()
    res, cnt, r = greedy(P)
    rg = verify(P, dict(res))
    assert rg == r
    print(json.dumps({'P': P, 'greedy_r': r, 'greedy_time_s': round(time.time() - t, 1)}), flush=True)
    t = time.time()
    br, bres = anneal(P, res, cnt, r, iters=iters, seed=seed)
    assert verify(P, bres) == br
    print(json.dumps({'P': P, 'anneal_r': br, 'iters': iters, 'seed': seed, 'anneal_time_s': round(time.time() - t, 1)}), flush=True)
    with open(f'best_P{P}_s{seed}.json', 'w') as f: json.dump({'P': P, 'r': br, 'residues': bres}, f)

```
# variants.py
```python
import sys, json, random, time
from apcover import primes_upto, allowed, greedy, anneal, verify
P = int(sys.argv[1]); mode = sys.argv[2]; iters = int(sys.argv[3]); seed = int(sys.argv[4])
T0 = float(sys.argv[5]); T1 = float(sys.argv[6])
k, d = 11, 2310; W = (k - 1) * d
if mode == 'greedy':
    res, cnt, r = greedy(P)
else:  # random start
    rng = random.Random(seed + 1000)
    res = {p: rng.choice(allowed(p, k, d)) for p in primes_upto(P)}
    cnt = [0] * (W + 1)
    for p, rr in res.items():
        for x in range(rr, W + 1, p): cnt[x] += 1
    r = verify(P, dict(res))
t = time.time()
br, bres = anneal(P, res, cnt, r, iters=iters, T0=T0, T1=T1, seed=seed)
assert verify(P, bres) == br
print(json.dumps({'P': P, 'start': mode, 'start_r': r, 'anneal_r': br, 'iters': iters, 'seed': seed, 'T0': T0, 'T1': T1, 'time_s': round(time.time() - t, 1)}), flush=True)

