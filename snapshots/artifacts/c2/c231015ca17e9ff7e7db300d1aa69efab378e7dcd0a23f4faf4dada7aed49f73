# ==== critic_checks.py (rank-4 quotient counts, claim arithmetic) ====
"""Critic checks for ideas 5641... and 953b...
A_m = (Z/m)[x,y]/(x^2+3, y^2+11), basis 1, x=sqrt(-3), y=sqrt(-11), xy=sqrt(-33)... careful:
we use basis 1, s3=sqrt(-3), s11=sqrt(-11), s33 = sqrt(33) = -(sqrt(-3)*sqrt(-11)) (choose sign: s3*s11 = -s33).
Element z = a + b s3 + c s11 + d s33.  conj: s3->-s3, s11->-s11, s33->s33.
|z|^2 = (a + d s33)^2 + (b sqrt3 + c sqrt11)^2 = a^2+33d^2+3b^2+11c^2 + 2(ad+bc) s33.
So z*conj(z) = 1  <=>  a^2+3b^2+11c^2+33d^2 = 1  and  ad+bc = 0.
"""
import itertools, sys
import numpy as np
from fractions import Fraction

def norm_one_set(m):
    N = []
    for a, b, c, d in itertools.product(range(m), repeat=4):
        if (a*a + 3*b*b + 11*c*c + 33*d*d) % m == 1 % m and (a*d + b*c) % m == 0:
            N.append((a, b, c, d))
    return np.array(N, dtype=np.int64)

def count_avoiding_functionals(m, N):
    # functionals u in (Z/m)^4, u.z != 0 mod m for all z in N
    U = np.array(list(itertools.product(range(m), repeat=4)), dtype=np.int64)  # m^4 x 4
    ok = np.ones(len(U), dtype=bool)
    chunk = 20000
    for i in range(0, len(U), chunk):
        Uc = U[i:i+chunk]
        vals = (N @ Uc.T) % m  # |N| x chunk
        ok[i:i+chunk] = ~np.any(vals == 0, axis=0)
    return int(ok.sum()), U[ok]

# --- claim f422: f = a + c + 2d mod 5 avoids N_5
N5 = norm_one_set(5)
f = np.array([1, 0, 1, 2])
vals = (N5 @ f) % 5
print("m=5: |N_5| =", len(N5), "; f=(1,0,1,2) hits zero on", int((vals == 0).sum()), "elements of N_5")

# --- claim d4cc: counts
for m in [5, 7, 11, 13, 17, 19, 23, 25]:
    N = norm_one_set(m)
    cnt, U = count_avoiding_functionals(m, N)
    print(f"m={m}: |N_m|={len(N)}, avoiding functionals={cnt}")
    sys.stdout.flush()

