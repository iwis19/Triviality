# ==== rbar2_mod4_check.py (known linear 4-colouring of Rbar_2, Polymath wiki) ====
"""Known result check (Polymath wiki, 'Algebraic formulation', June 2018): Rbar_2 = Z[w, alpha, 1/3],
w=(1+i sqrt3)/2 (w^2 = w-1), alpha=(1+sqrt33)/2 (alpha^2 = alpha+8), has a LINEAR 4-colouring via
Rbar_2 -> Z_4[w,alpha] -> Z_4[w] (alpha -> 0), c(a+bw) = a-b mod 4.
Here we check it directly on the FULL norm-one set of the 256-element ring Z_4[w,alpha] (no unit-group parametrisation needed).
Element = a + b w + c alpha + d w alpha, conj: w -> 1-w, alpha -> alpha."""
import itertools
m = 4
def mul(x, y):
    a,b,c,d = x; e,f,g,h = y
    # (a + b w + c al + d w al)(e + f w + g al + h w al); w^2 = w-1, al^2 = al+8
    # collect coefficients on 1, w, al, w al
    r = [0,0,0,0]
    def add_w(p, q, coeff):  # (p + q w) * coeff pattern handled below
        pass
    terms = {}
    basis = {(0,0):0,(1,0):1,(0,1):2,(1,1):3}
    X = {(0,0):a,(1,0):b,(0,1):c,(1,1):d}
    Y = {(0,0):e,(1,0):f,(0,1):g,(1,1):h}
    out = {(0,0):0,(1,0):0,(0,1):0,(1,1):0}
    for (i1,j1),u in X.items():
        for (i2,j2),v in Y.items():
            coef = u*v
            # w^(i1+i2): w^2 = w - 1 -> contributes to (w^0, w^1) parts
            wpart = {0:{0:1}, 1:{1:1}, 2:{0:-1,1:1}}[i1+i2]
            apart = {0:{0:1}, 1:{1:1}, 2:{0:8,1:1}}[j1+j2]
            for wi,wc in wpart.items():
                for ai,ac in apart.items():
                    out[(wi,ai)] += coef*wc*ac
    return tuple(out[k] % m for k in [(0,0),(1,0),(0,1),(1,1)])
def conj(x):
    a,b,c,d = x  # w -> 1-w : b w -> b - b w ; d w al -> d al - d w al
    return ((a+b) % m, (-b) % m, (c+d) % m, (-d) % m)
N = [x for x in itertools.product(range(m), repeat=4) if mul(x, conj(x)) == (1,0,0,0)]
print("|Z_4[w,alpha]| = 256, |N_4| =", len(N))
f = lambda x: (x[0]-x[1]) % m
bad = [x for x in N if f(x) == 0]
print("functional a-b (alpha ignored) vanishes on", len(bad), "elements of N_4")
# also: which elements of N_4 map to which colours
print("colour values on N_4:", sorted(set(f(x) for x in N)))


