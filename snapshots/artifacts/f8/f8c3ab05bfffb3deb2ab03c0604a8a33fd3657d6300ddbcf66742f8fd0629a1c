"""Compatibility of residue congruences f = -x^{r_m} (mod Phi_m) in Z[x].

Pairwise: (r_m, r_n) compatible  <=>  x^{r_n} - x^{r_m} in (Phi_m, Phi_n) subset Z[x]
          <=>  (zeta_m^{r_n - r_m} - 1) / Phi_n(zeta_m) is integral in Z[zeta_m]
Global:   (r_{m_1},...,r_{m_k}) simultaneously solvable  <=>  the vector
          (-x^{r_1} mod Phi_{m_1}, ..., -x^{r_k} mod Phi_{m_k}) lies in the Z-lattice
          spanned by the images of 1, x, ..., x^{L-1}  (L = lcm), tested by HNF.
Requires sympy >= 1.9.
"""
import itertools, sys
from sympy import symbols, cyclotomic_poly, Poly, QQ, ZZ, invert, gcd as sgcd
from sympy.matrices import Matrix
from sympy.matrices.normalforms import hermite_normal_form
from math import gcd
from functools import reduce

x = symbols('x')

def phi(m):
    return Poly(cyclotomic_poly(m, x), x, domain=ZZ)

def pair_compatible(m, n, d):
    """Is x^d - 1 in the ideal (Phi_m, Phi_n) of Z[x]?  (d = r_n - r_m)"""
    Pm, Pn = phi(m), phi(n)
    PnQ = Poly(Pn.as_expr(), x, domain=QQ)
    PmQ = Poly(Pm.as_expr(), x, domain=QQ)
    if sgcd(PnQ, PmQ).degree() > 0:
        raise ValueError
    inv = invert(PnQ, PmQ)            # Phi_n^{-1} mod Phi_m over Q
    d %= n
    beta = ((Poly(x**d - 1, x, domain=QQ) * inv) % PmQ)
    return all(c.q == 1 for c in beta.all_coeffs())

def pair_rule(m, n):
    """Return the set of d mod n such that (r_m, r_m + d) is compatible."""
    return sorted(d for d in range(n) if pair_compatible(m, n, d))

_cache = {}

def lattice_basis(mods):
    mods = tuple(mods)
    if mods in _cache:
        return _cache[mods]
    L = reduce(lambda a, b: a * b // gcd(a, b), mods)
    blocks = [phi(m) for m in mods]
    degs = [b.degree() for b in blocks]
    def image(poly):
        v = []
        for b, dg in zip(blocks, degs):
            r = (poly % b).all_coeffs()[::-1]
            v += list(r) + [0] * (dg - len(r))
        return v
    gens = [image(Poly(x**k, x, domain=ZZ)) for k in range(L)]
    G = Matrix(gens).T                      # columns = generators of the image lattice
    H = hermite_normal_form(G)              # Z-basis (columns) of the lattice
    assert H.shape[0] == H.shape[1] == sum(degs)
    _cache[mods] = (blocks, degs, H.inv())
    return _cache[mods]

def global_solvable(mods, residues):
    blocks, degs, Hinv = lattice_basis(mods)
    tvec = [0] * sum(degs)
    off = 0
    for b, dg, r in zip(blocks, degs, residues):
        rr = (Poly(-x**r, x, domain=ZZ) % b).all_coeffs()[::-1]
        for i, c in enumerate(rr):
            tvec[off + i] = int(c)
        off += dg
    y = Hinv * Matrix(tvec)                 # t in lattice  <=>  H^{-1} t integral
    return all(v.q == 1 for v in y)

if __name__ == '__main__':
    print("Pairwise rule: d = r_n - r_m mod n compatible sets")
    for (m, n) in [(3, 9), (3, 27), (9, 27), (5, 15), (3, 15), (15, 45), (5, 45), (9, 45), (3, 45), (7, 21), (21, 63), (15, 135), (45, 135), (5, 25), (25, 75), (15, 75), (2, 4), (4, 8), (6, 12), (6, 18), (10, 20)]:
        S = pair_rule(m, n)
        claim = sorted(d for d in range(n) if d % m == 0)          # claim C1: compatible iff r_n = r_m (mod m)
        print(f"({m},{n}) ratio {n//m}: compatible d = {S} ; claim 'd=0 mod m' gives {claim} ; agree={S == claim}", flush=True)
    print()
    print("Pairwise-compatible vs globally solvable, all residue tuples")
    for mods in [(3, 9, 27), (3, 15, 45), (5, 15, 45), (3, 9, 45), (3, 5, 15, 45)]:
        rules = {}
        for a, b in itertools.combinations(mods, 2):
            if b % a == 0:
                rules[(a, b)] = set(pair_rule(a, b))
            else:
                rules[(a, b)] = set(pair_rule(a, b)) if True else None
        n_pair = n_glob = n_mismatch = 0
        for res in itertools.product(*[range(m) for m in mods]):
            pw = all(((res[j] - res[i]) % mods[j]) in rules[(mods[i], mods[j])]
                     for i, j in itertools.combinations(range(len(mods)), 2))
            gl = global_solvable(list(mods), list(res))
            n_pair += pw; n_glob += gl; n_mismatch += (pw != gl)
            if pw != gl:
                print("  mismatch", mods, res, "pairwise", pw, "global", gl)
        print(f"{mods}: pairwise-compatible tuples {n_pair}, globally solvable {n_glob}, mismatches {n_mismatch}", flush=True)

