import Mathlib
/-!
Finite certificate behind claim C1: in the ring A₅ = (ℤ/5)[s3,s11] (s3² = -3, s11² = -11,
s33 = s3·s11), every element of norm 1 (z · conj z = 1) has nonzero image under the
ℤ/5-linear functional f(a,b,c,d) = a + c + 2d.  Pulling f back along reduction mod 5
gives a proper 5-colouring of the unit-distance graph on ℤ[1/6][√-3, √-11].
Elements are encoded as quadruples of naturals < 5; arithmetic is done in ℕ modulo 5
(negatives are replaced by their representatives: -3 ≡ 2, -11 ≡ 4, 33 ≡ 3, -1 ≡ 4).
-/

/-- coordinates of z · conj z for z = (a,b,c,d), computed in ℕ mod 5 -/
def normA (a b c d : Nat) : Nat × Nat × Nat × Nat :=
  -- conj z = (a, 4b, 4c, d)
  ((a*a + 2*b*(4*b) + 4*c*(4*c) + 3*d*d) % 5,
   (a*(4*b) + b*a + 4*(c*d + d*(4*c))) % 5,
   (a*(4*c) + c*a + 2*(b*d + d*(4*b))) % 5,
   (a*d + d*a + b*(4*c) + c*(4*b)) % 5)

def fA (a c d : Nat) : Nat := (a + c + 2*d) % 5

/-- Boolean form of the certificate: over all 625 quadruples, norm 1 implies f ≠ 0. -/
def certificate : Bool :=
  (List.range 5).all fun a => (List.range 5).all fun b => (List.range 5).all fun c =>
    (List.range 5).all fun d => (normA a b c d != (1,0,0,0)) || (fA a c d != 0)

theorem C1_finite_certificate : certificate = true := by
  decide



