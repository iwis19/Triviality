from fractions import Fraction as F
from itertools import combinations
from math import gcd, sin, pi

def overlap(vi, vj, d):
    g = gcd(vi, vj); a, b = sorted((vi//g, vj//g))
    s = F(0); m = 0
    while True:
        term = min(2*d*a, 2*d*b, d*(a+b)-m)
        if term <= 0: break
        s += term if m == 0 else 2*term
        m += 1
    return s/(a*b)

def overlap_brute(vi, vj, d):
    def bad(v):
        return [(F(m,v)-d/v, F(m,v)+d/v) for m in range(v+1)]
    tot = F(0)
    for (l1,r1) in bad(vi):
        for (l2,r2) in bad(vj):
            l=max(l1,l2,F(0)); r=min(r1,r2,F(1))
            if r>l: tot += r-l
    return tot

def fourier(vi, vj, d, K=200000):
    g = gcd(vi, vj); a, b = vi//g, vj//g
    return 4*d*d + 2/(a*b)*sum(sin(2*pi*k*d*a)*sin(2*pi*k*d*b)/(pi*pi*k*k) for k in range(1,K))

def max_tree(v, d):
    n=len(v); w={(i,j):overlap(v[i],v[j],d) for i,j in combinations(range(n),2)}
    inT={0}; tot=F(0)
    while len(inT)<n:
        best=max(((w[(min(i,j),max(i,j))],j) for i in inT for j in range(n) if j not in inT))
        tot+=best[0]; inT.add(best[1])
    return tot

import random
random.seed(1)
for _ in range(30):
    vi,vj=random.sample(range(1,40),2); d=F(1,random.randint(3,20))
    c=overlap(vi,vj,d); assert c==overlap_brute(vi,vj,d)
    assert abs(float(c)-fourier(vi,vj,d))<1e-4
print('closed form == brute force == Fourier on 30 random pairs')
print('(1,2),d=1/3:', overlap(1,2,F(1,3)))
for v,n in [((30,66,75,85,290),5),((6,180,183,202,228),5),((15,135,170,271,287,478,495),7),((1,6,48,108,168,288),6),((2,9,16,33,81,88,112),7),((1,12,96,162,208,264,306,320),8),((30,66,105,150,290),5),((1,3,9),3),((1,4,16,64),4)]:
    d0=F(1,2*n-2); T=max_tree(v,d0)
    allneg=all(overlap(a,b,d0)<4*d0*d0 for a,b in combinations(v,2))
    print(v,'T=',T,'target',F(n-1)*4*d0*d0,'T<target:',T<F(n-1)*4*d0*d0,'all-negative:',allneg)
for n in [5,6,7,8]:
    d0=F(1,2*n-2)
    m=min((overlap(a,b,d0)-4*d0*d0,a,b) for a in range(1,60) for b in range(a+1,60) if gcd(a,b)==1)
    print(n,m,float(m[0])/float(4*d0*d0))

