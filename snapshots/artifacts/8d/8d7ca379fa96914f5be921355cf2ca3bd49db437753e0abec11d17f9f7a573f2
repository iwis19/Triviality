#!/usr/bin/env python3
"""
Critic checks for idea d41cde97 (6-chromatic hunt in R* = Z[w1,w3,w4,w_{25/9}, conjugates]).

Exact arithmetic in K = Q(i*sqrt3, i*sqrt11, sqrt5, i*sqrt91)  (degree 16).
Basis: products of generators g0=i*sqrt3, g1=i*sqrt11, g2=sqrt5, g3=i*sqrt91, indexed by bitmask.

Part A: algebraic facts
  A1. 5/3 = w3 + conj(w3) is in Rbar_3; 41/25 = w_{25/9}+conj in R*, hence 1/5 in R*.
  A2. kappa = (3 + i sqrt91)/10 has |kappa| = 1, kappa in R*, kappa^2 = -conj(w_{25/9}),
      and kappa is NOT in the multiplicative group generated by w1,w3,w4,w_{25/9} (valuation argument, checked numerically
      via 5-adic denominators of the Q(sqrt-91)-component).
  A3. mod-5 obstruction: 41*w_{25/9} = 25*(w_{25/9}^2 + 1); so any additive hom f: R -> Z/5 kills w_{25/9}.
Part B: SAT experiment in Rbar_3 = Z[w1, w3, conj w3, w4, conj w4]
  Build Minkowski sums V_2 = S+S, V_3 = S+S+S of a set S of unit vectors, containing 0 and 5/3.
  Test (i) 5-colourability, (ii) whether c(5/3) = c(0) is forced, (iii) scan all pairs (0,v) in V_2 for forced pairs.
"""
from fractions import Fraction as Fr
from itertools import product
import sys, time

GENSQ = [-3, -11, 5, -91]  # g_j^2
CONJ_SIGN = [-1, -1, 1, -1]  # conj(g_j) = sign * g_j
NB = 16

def mul_basis(a, b):
    """product of basis elements a,b (bitmasks) -> (coeff, basis)"""
    c = Fr(1)
    common = a & b
    for j in range(4):
        if common >> j & 1:
            c *= GENSQ[j]
    return c, a ^ b

class K:
    __slots__ = ("c",)
    def __init__(self, c=None):
        self.c = {} if c is None else {k: v for k, v in c.items() if v != 0}
    @staticmethod
    def rat(q):
        return K({0: Fr(q)})
    @staticmethod
    def gen(j):
        return K({1 << j: Fr(1)})
    def __add__(self, o):
        d = dict(self.c)
        for k, v in o.c.items():
            d[k] = d.get(k, 0) + v
        return K(d)
    def __neg__(self):
        return K({k: -v for k, v in self.c.items()})
    def __sub__(self, o):
        return self + (-o)
    def __mul__(self, o):
        if isinstance(o, (int, Fr)):
            return K({k: v * o for k, v in self.c.items()})
        d = {}
        for a, va in self.c.items():
            for b, vb in o.c.items():
                s, k = mul_basis(a, b)
                d[k] = d.get(k, 0) + va * vb * s
        return K(d)
    __rmul__ = __mul__
    def conj(self):
        d = {}
        for k, v in self.c.items():
            s = 1
            for j in range(4):
                if k >> j & 1 and CONJ_SIGN[j] == -1:
                    s = -s
            d[k] = v * s
        return K(d)
    def norm2(self):
        return self * self.conj()
    def is_rat(self, q=None):
        if any(k != 0 for k in self.c):
            return False
        return True if q is None else self.c.get(0, Fr(0)) == Fr(q)
    def key(self):
        return tuple(sorted(self.c.items()))
    def __eq__(self, o):
        return self.key() == o.key()
    def __hash__(self):
        return hash(self.key())
    def inv_unit(self):
        assert self.norm2().is_rat(1)
        return self.conj()
    def __pow__(self, n):
        if n < 0:
            return self.inv_unit() ** (-n)
        r = K.rat(1)
        for _ in range(n):
            r = r * self
        return r
    def __repr__(self):
        names = {0: "1"}
        parts = []
        for k, v in sorted(self.c.items()):
            nm = "*".join(["i√3", "i√11", "√5", "i√91"][j] for j in range(4) if k >> j & 1) or "1"
            parts.append(f"{v}·{nm}")
        return " + ".join(parts) if parts else "0"

s3, s11, r5, s91 = (K.gen(j) for j in range(4))
half, third, fifth = K.rat(Fr(1, 2)), K.rat(Fr(1, 3)), K.rat(Fr(1, 5))
one = K.rat(1)
w1 = (one + s3) * Fr(1, 2)
w3 = (K.rat(5) + s11) * Fr(1, 6)
w4 = (K.rat(7) + s3 * r5) * Fr(1, 8)           # i sqrt15 = i sqrt3 * sqrt5
w259 = (K.rat(41) + s91 * 3) * Fr(1, 50)
eta = (s3 - s3 * s11) * Fr(1, 6)               # (sqrt33 + i sqrt3)/6, sqrt33 = -(i√3)(i√11)
zeta = (one + s3 * r5) * Fr(1, 4)
alpha = (r5 + s11) * Fr(1, 4)
kappa = (K.rat(3) + s91) * Fr(1, 10)

def partA():
    print("== Part A: algebraic facts (exact arithmetic)")
    for nm, z in [("w1", w1), ("w3", w3), ("w4", w4), ("w_{25/9}", w259), ("eta", eta), ("zeta", zeta), ("alpha", alpha), ("kappa", kappa)]:
        print(f"  |{nm}|^2 = {z.norm2()}")
    print("  eta^2 == w3 :", eta ** 2 == w3)
    print("  w3 + conj(w3) =", w3 + w3.conj(), "  (=5/3, so 5/3 in Rbar_3)")
    print("  w_{25/9} + conj =", w259 + w259.conj(), "  (=41/25; gcd(41,25)=1 => 1/25, hence 1/5, in R*)")
    print("  cos(arg w_{25/9}) = 41/50 = 1 - 1/(2t) with t = 25/9 :", Fr(41, 50) == 1 - Fr(1, 2 * Fr(25, 9)))
    # A3: 41*w = 25*(w^2+1)
    lhs = w259 * 41
    rhs = (w259 ** 2 + one) * 25
    print("  41*w_{25/9} == 25*(w_{25/9}^2 + 1):", lhs == rhs, " => any additive hom to Z/5 sends w_{25/9} to 0")
    # A2: kappa
    print("  kappa^2 == -conj(w_{25/9}):", kappa ** 2 == -(w259.conj()))
    print("  i√91 = (50 w_{25/9} - 41)/3 in R* :", (w259 * 50 - K.rat(41)) * Fr(1, 3) == s91)
    # spindle geometry: rotating 5/3 by w_{25/9} moves it by exactly 1
    d = (w259 - one) * Fr(5, 3)
    print("  |(5/3)(w_{25/9} - 1)|^2 =", d.norm2())
    # kappa not in <w1,w3,w4,w259>: any element of that group lying in Q(sqrt-91) is ±w259^d.
    # 5-adic: w259 = (41+3i√91)/50; kappa = (3+i√91)/10.  In Z[(1+√-91)/2], 5 = p p'.  N(41+3i√91)=2500, N(3+i√91)=100.
    print("  N(41+3i√91) =", (K.rat(41) + s91 * 3).norm2(), "; N(3+i√91) =", (K.rat(3) + s91).norm2())
    print("  => (v_p, v_p')(w259) = ±(2,-2), (v_p,v_p')(kappa) = ±(1,-1); kappa = ±w259^d would need d = ±1/2. So kappa is an")
    print("     'unplanned' unit vector of R* outside the multiplicative closure of the generators (cf. eta in Rbar_2).")
    # brute-force sanity: kappa != ±w259^d for |d| <= 6 and != any small word
    found = False
    for d in range(-6, 7):
        if kappa == w259 ** d or kappa == -(w259 ** d):
            found = True
    print("  kappa == ±w259^d for some |d|<=6 :", found)

# ---------------- Part B ----------------
def build_S():
    S = set()
    for p in range(6):
        for q in range(-2, 3):
            S.add(w1 ** p * eta ** q)
        for r in (-1, 1):
            S.add(w1 ** p * zeta ** r)
            S.add(w1 ** p * alpha ** r)
    return list(S)

def build_U():
    U = set()
    for p in range(6):
        for q in range(-4, 5):
            for r in range(-2, 3):
                for s in range(-2, 3):
                    U.add(w1 ** p * eta ** q * zeta ** r * alpha ** s)
    return list(U)

def minkowski(S, k):
    V = {K.rat(0)}
    for _ in range(k):
        V = {u + v for u in V for v in S}
    return V

def edges_of(V, U):
    idx = {v: i for i, v in enumerate(V)}
    E = set()
    for v, i in idx.items():
        for u in U:
            j = idx.get(v + u)
            if j is not None and j > i:
                E.add((i, j))
    return sorted(E)

def sat_color(n, E, k, extra=(), assumptions=()):
    from pysat.solvers import Cadical153
    var = lambda v, c: v * k + c + 1
    s = Cadical153()
    for v in range(n):
        s.add_clause([var(v, c) for c in range(k)])
    for (i, j) in E:
        for c in range(k):
            s.add_clause([-var(i, c), -var(j, c)])
    for cl in extra:
        s.add_clause(cl)
    ok = s.solve(assumptions=list(assumptions))
    model = s.get_model() if ok else None
    s.delete()
    return ok, model

def partB(kfold_max=3):
    print("\n== Part B: SAT experiments in Rbar_3 (forced pair (0, 5/3)?)")
    S = build_S(); U = build_U()
    print(f"  |S| = {len(S)} unit vectors in Rbar_3 (words w1^p eta^q zeta^r alpha^s, |q|<=2, |r|,|s|<=1); |U| = {len(U)} unit vectors used for edge detection")
    assert all(u.norm2().is_rat(1) for u in S) and all(u.norm2().is_rat(1) for u in U)
    fivethirds = K.rat(Fr(5, 3))
    for kf in range(2, kfold_max + 1):
        t0 = time.time()
        V = sorted(minkowski(S, kf), key=lambda z: z.key())
        idx = {v: i for i, v in enumerate(V)}
        E = edges_of(V, U)
        n = len(V)
        print(f"  V_{kf} = S^(+{kf}): {n} vertices, {len(E)} unit edges (built in {time.time()-t0:.1f}s); contains 5/3: {fivethirds in idx}")
        k = 5
        var = lambda v, c: v * k + c + 1
        i0, i53 = idx[K.rat(0)], idx[fivethirds]
        t0 = time.time()
        ok, _ = sat_color(n, E, k, assumptions=[var(i0, 0)])
        print(f"    5-colourable: {ok} ({time.time()-t0:.1f}s)")
        t0 = time.time()
        ok2, model = sat_color(n, E, k, assumptions=[var(i0, 0), -var(i53, 0)])
        print(f"    5-colouring with c(5/3) != c(0) exists: {ok2} ({time.time()-t0:.1f}s)  => pair (0,5/3) forced: {not ok2}")
        if kf == 2:
            # full forced-pair scan from the origin
            t0 = time.time()
            forced = []
            for v, j in idx.items():
                if j == i0:
                    continue
                okv, _ = sat_color(n, E, k, assumptions=[var(i0, 0), -var(j, 0)])
                if not okv:
                    forced.append(v)
            print(f"    forced-pair scan (0,v) over all {n-1} vertices of V_2: {len(forced)} forced pairs ({time.time()-t0:.1f}s)")
            for v in forced:
                print("      forced:", v, " |v|^2 =", v.norm2())
        sys.stdout.flush()

if __name__ == "__main__":
    partA()
    partB(kfold_max=int(sys.argv[1]) if len(sys.argv) > 1 else 3)
