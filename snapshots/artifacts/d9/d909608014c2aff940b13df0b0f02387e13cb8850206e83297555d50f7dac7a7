import Mathlib

/-!
Independent re-derivation (critic's check) of the three Lean targets of idea 18ef46e0:
Parseval for `ZMod.dft`, and the "square-root barrier" for indicators of sparse sets.
-/

open ZMod Finset Complex


variable {N : ℕ} [NeZero N]

/-- Self-duality: `∑ k, 𝓕Φ(k) 𝓕Ψ(-k) = N ∑ j, Φ(j) Ψ(j)`, from `dft_dft` and `dft_comp_neg`. -/
lemma sum_dft_mul_dft_neg (Φ Ψ : ZMod N → ℂ) :
    ∑ k, 𝓕 Φ k * 𝓕 Ψ (-k) = N * ∑ j, Φ j * Ψ j := by
  have h1 : ∀ j, ∑ k, stdAddChar (-(j * k)) * 𝓕 Ψ (-k) = N * Ψ j := by
    intro j
    have := congrFun (dft_comp_neg (𝓕 Ψ)) j
    rw [dft_apply, dft_dft] at this
    simp only [neg_neg, smul_eq_mul] at this
    simpa [mul_comm] using this
  calc ∑ k, 𝓕 Φ k * 𝓕 Ψ (-k)
      = ∑ k, ∑ j, Φ j * (stdAddChar (-(j * k)) * 𝓕 Ψ (-k)) := by
        refine sum_congr rfl fun k _ ↦ ?_
        rw [dft_apply, sum_mul]
        refine sum_congr rfl fun j _ ↦ ?_
        simp only [smul_eq_mul]; ring
    _ = ∑ j, Φ j * ∑ k, stdAddChar (-(j * k)) * 𝓕 Ψ (-k) := by
        rw [sum_comm]; simp_rw [mul_sum]
    _ = N * ∑ j, Φ j * Ψ j := by
        simp_rw [h1, mul_sum]; refine sum_congr rfl fun j _ ↦ ?_; ring

lemma stdAddChar_conj (j : ZMod N) : starRingEnd ℂ (stdAddChar j) = stdAddChar (-j) := by
  have hR : 0 < ringChar (ZMod N) := by
    rw [ZMod.ringChar_zmod_n]; exact Nat.pos_of_ne_zero (NeZero.ne N)
  rw [AddChar.starComp_apply hR, AddChar.inv_apply]

lemma dft_conj_neg (Φ : ZMod N → ℂ) (k : ZMod N) :
    𝓕 (fun j ↦ starRingEnd ℂ (Φ j)) (-k) = starRingEnd ℂ (𝓕 Φ k) := by
  rw [dft_apply, dft_apply, map_sum]
  refine sum_congr rfl fun j _ ↦ ?_
  simp only [smul_eq_mul, map_mul, stdAddChar_conj]
  rw [show -(j * -k) = -(-(j * k)) by ring]

theorem zmod_dft_parseval (Φ : ZMod N → ℂ) :
    ∑ k, ‖𝓕 Φ k‖ ^ 2 = N * ∑ j, ‖Φ j‖ ^ 2 := by
  have h := sum_dft_mul_dft_neg Φ (fun j ↦ starRingEnd ℂ (Φ j))
  simp_rw [dft_conj_neg, Complex.mul_conj, Complex.normSq_eq_norm_sq] at h
  exact_mod_cast h

theorem exists_ne_zero_sq_norm_dft_indicator_ge (hN : 2 ≤ N) (S : Finset (ZMod N)) :
    ∃ k : ZMod N, k ≠ 0 ∧ (S.card : ℝ) * (N - S.card) / (N - 1) ≤
      ‖𝓕 (fun j ↦ if j ∈ S then (1 : ℂ) else 0) k‖ ^ 2 := by
  set f : ZMod N → ℂ := fun j ↦ if j ∈ S then (1 : ℂ) else 0 with hf
  have h0 : 𝓕 f 0 = S.card := by
    rw [dft_apply_zero]; simp [f]
  have hsq : ∑ j, ‖f j‖ ^ 2 = S.card := by
    simp [f, apply_ite]
  have hP := zmod_dft_parseval f
  rw [hsq, ← Finset.add_sum_erase _ _ (Finset.mem_univ (0 : ZMod N)), h0,
    Complex.norm_natCast] at hP
  have hN1 : (1 : ZMod N) ≠ 0 := by
    haveI : Fact (1 < N) := ⟨by omega⟩
    exact one_ne_zero
  have hne : (Finset.univ.erase (0 : ZMod N)).Nonempty :=
    ⟨1, Finset.mem_erase.mpr ⟨hN1, Finset.mem_univ _⟩⟩
  have hcard : ((Finset.univ.erase (0 : ZMod N)).card : ℝ) = N - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, ZMod.card]
    have : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
    push_cast [this]; ring
  have hNr : (N : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ N := by exact_mod_cast hN
    linarith
  obtain ⟨k, hk, hle⟩ := Finset.exists_le_of_sum_le hne
    (f := fun _ ↦ (S.card : ℝ) * (N - S.card) / (N - 1)) (g := fun k ↦ ‖𝓕 f k‖ ^ 2) (by
      rw [Finset.sum_const, nsmul_eq_mul, hcard]
      have : ((N : ℝ) - 1) * ((S.card : ℝ) * (N - S.card) / (N - 1)) =
          (S.card : ℝ) * (N - S.card) := by field_simp
      rw [this]; nlinarith [hP])
  exact ⟨k, Finset.ne_of_mem_erase hk, hle⟩

theorem exists_ne_zero_sqrt_half_card_le_norm_dft_indicator (hN : 2 ≤ N) (S : Finset (ZMod N))
    (hS : 2 * S.card ≤ N) :
    ∃ k : ZMod N, k ≠ 0 ∧ Real.sqrt (S.card / 2) ≤
      ‖𝓕 (fun j ↦ if j ∈ S then (1 : ℂ) else 0) k‖ := by
  obtain ⟨k, hk, h⟩ := exists_ne_zero_sq_norm_dft_indicator_ge hN S
  refine ⟨k, hk, ?_⟩
  have hS' : (2 : ℝ) * S.card ≤ N := by exact_mod_cast hS
  have hN' : (2 : ℝ) ≤ N := by exact_mod_cast hN
  have hc : (0 : ℝ) ≤ S.card := by positivity
  have hhalf : (S.card : ℝ) / 2 ≤ (S.card : ℝ) * (N - S.card) / (N - 1) := by
    rw [div_le_div_iff₀ (by norm_num) (by linarith)]
    nlinarith
  calc Real.sqrt (S.card / 2) ≤ Real.sqrt (‖𝓕 (fun j ↦ if j ∈ S then (1 : ℂ) else 0) k‖ ^ 2) :=
        Real.sqrt_le_sqrt (hhalf.trans h)
    _ = _ := Real.sqrt_sq (norm_nonneg _)

