/-- (p-2)! ≡ 1 (mod p) for every prime p (from Wilson's theorem). -/
lemma factorial_sub_two_modEq_one {p : ℕ} (hp : p.Prime) : (p - 2)! ≡ 1 [MOD p] := by
  have h2 : 2 ≤ p := hp.two_le
  have hw : ((p - 1)! : ZMod p) = -1 := by
    haveI := Fact.mk hp
    exact ZMod.wilsons_lemma p
  have h1 : (p - 1)! = (p - 1) * (p - 2)! := by
    have : p - 1 = (p - 2) + 1 := by omega
    rw [this, Nat.factorial_succ]
  haveI := Fact.mk hp
  rw [← ZMod.natCast_eq_natCast_iff]
  push_cast
  have hpm1 : ((p - 1 : ℕ) : ZMod p) = -1 := by
    rw [Nat.cast_sub (by omega), ZMod.natCast_self]; simp
  rw [h1] at hw
  push_cast at hw
  rw [hpm1, neg_one_mul, neg_inj] at hw
  exact hw

/-- Every prime p ≥ 5 gives k = 2: blocks {1} and {2, …, p-2}. -/
theorem k2_all_primes {p : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) :
    AllModProdEqualsOne p ![1, 2, p - 1] := by
  intro i
  fin_cases i
  · simp; rfl
  · have hb : ∏ n ∈ Finset.Ico ((![1, 2, p - 1] : Fin 3 → ℕ) (Fin.castSucc (1 : Fin 2)))
        ((![1, 2, p - 1] : Fin 3 → ℕ) (Fin.castSucc (1 : Fin 2) + 1)), n
        = ∏ n ∈ Finset.Ico 2 (p - 1), n := by
      rfl
    show ∏ n ∈ Finset.Ico ((![1, 2, p - 1] : Fin 3 → ℕ) (Fin.castSucc (1 : Fin 2)))
        ((![1, 2, p - 1] : Fin 3 → ℕ) (Fin.castSucc (1 : Fin 2) + 1)), n ≡ 1 [MOD p]
    rw [hb]
    have h := factorial_sub_two_modEq_one hp
    have hprod : ∏ n ∈ Finset.Ico 2 (p - 1), n = (p - 2)! := by
      have e1 : (p - 2)! = ∏ n ∈ Finset.Ico 1 (p - 1), n := by
        rw [← Finset.prod_Ico_id_eq_factorial]
        congr 1
      rw [e1, ← Finset.prod_Ico_consecutive _ (show 1 ≤ 2 by norm_num) (show 2 ≤ p - 1 by omega)]
      simp
    rw [hprod]; exact h

