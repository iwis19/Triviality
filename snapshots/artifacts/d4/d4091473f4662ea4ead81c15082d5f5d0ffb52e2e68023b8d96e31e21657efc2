import Mathlib
/-!
# Erdős problem #1056 — reduction lemma and explicit finite witnesses

`AllModProdEqualsOne` is copied verbatim from google-deepmind/formal-conjectures
(`FormalConjectures/ErdosProblems/1056.lean`).  Witness boundaries were produced by the C program
`fact_collisions.c`: reduce `n!` mod `p` for `0 ≤ n < p`; a residue hit `k+1` times at indices
`n_0 < … < n_k` yields boundaries `n_i + 1` (half-open `Ico` blocks), because
`(n_{i+1})! / (n_i)! = ∏_{n_i < j ≤ n_{i+1}} j`.  This is `allModProdEqualsOne_of_factorial_congr`.
-/

open Nat

def AllModProdEqualsOne (p : ℕ) {k : ℕ} (boundaries : Fin (k + 1) → ℕ) : Prop :=
  ∀ i : Fin k,
    (∏ n ∈ Finset.Ico (boundaries i.castSucc) (boundaries (i.castSucc + 1)), n) ≡ 1 [MOD p]

/-- Product of a half-open block times the factorial below it is the factorial above it. -/
lemma factorial_mul_prod_Ico {a d : ℕ} (ha : 1 ≤ a) (had : a ≤ d) :
    (a - 1)! * ∏ n ∈ Finset.Ico a d, n = (d - 1)! := by
  have h1 : (a - 1)! = ∏ n ∈ Finset.Ico 1 a, n := by
    rw [← Finset.prod_Ico_id_eq_factorial]
    congr 1
  have h2 : (d - 1)! = ∏ n ∈ Finset.Ico 1 d, n := by
    rw [← Finset.prod_Ico_id_eq_factorial]
    congr 1
  rw [h1, h2, Finset.prod_Ico_consecutive _ ha had]

/-- Noll–Simmons ⟹ Erdős #1056: if all `(b i - 1)!` are congruent to a common unit `c`
mod a prime `p`, every block product is `≡ 1`. -/
theorem allModProdEqualsOne_of_factorial_congr {p k : ℕ} (hp : p.Prime)
    (b : Fin (k + 1) → ℕ) (hb : StrictMono b) (hpos : ∀ i, 1 ≤ b i)
    (c : ℕ) (hc : ¬ p ∣ c) (h : ∀ i, (b i - 1)! ≡ c [MOD p]) :
    AllModProdEqualsOne p b := by
  intro i
  have hi : i.castSucc < i.castSucc + 1 := by
    rw [Fin.lt_def, Fin.val_add_one_of_lt (Fin.castSucc_lt_last i)]; omega
  have hlt : b i.castSucc < b (i.castSucc + 1) := hb hi
  have key := factorial_mul_prod_Ico (hpos i.castSucc) hlt.le
  have h1 := h i.castSucc
  have h2 := h (i.castSucc + 1)
  have hcop : Nat.Coprime p c := (Nat.Prime.coprime_iff_not_dvd hp).2 hc
  have : c * (∏ n ∈ Finset.Ico (b i.castSucc) (b (i.castSucc + 1)), n) ≡ c * 1 [MOD p] := by
    calc c * (∏ n ∈ Finset.Ico (b i.castSucc) (b (i.castSucc + 1)), n)
        ≡ (b i.castSucc - 1)! * (∏ n ∈ Finset.Ico (b i.castSucc) (b (i.castSucc + 1)), n) [MOD p] :=
          Nat.ModEq.mul_right _ h1.symm
      _ = (b (i.castSucc + 1) - 1)! := key
      _ ≡ c [MOD p] := h2
      _ = c * 1 := (mul_one c).symm
  exact Nat.ModEq.cancel_left_of_coprime hcop this


