import Mathlib

open Finset

/-- Vertex sets of `C_m` inducing a subgraph with no isolated vertex (El-Zahar's "derived subgraphs"). -/
def cycleClosure (m : ℕ) [NeZero m] : Finset (Finset (Fin m)) :=
  (univ : Finset (Finset (Fin m))).filter (fun S => S.Nonempty ∧ ∀ v ∈ S, v + 1 ∈ S ∨ v - 1 ∈ S)

theorem cycleClosure_unionClosed (m : ℕ) [NeZero m] :
    ∀ A ∈ cycleClosure m, ∀ B ∈ cycleClosure m, A ∪ B ∈ cycleClosure m := by
  intro A hA B hB
  simp only [cycleClosure, mem_filter, mem_univ, true_and] at hA hB ⊢
  refine ⟨hA.1.mono subset_union_left, ?_⟩
  intro v hv
  rcases mem_union.mp hv with h | h
  · rcases hA.2 v h with h' | h'
    · exact Or.inl (mem_union_left _ h')
    · exact Or.inr (mem_union_left _ h')
  · rcases hB.2 v h with h' | h'
    · exact Or.inl (mem_union_right _ h')
    · exact Or.inr (mem_union_right _ h')

/-- The interval `e = V \ N[x]`. -/
def cycleInterval (m : ℕ) [NeZero m] (x : Fin m) : Finset (Fin m) :=
  univ \ {x - 1, x, x + 1}

/-- Sanity check of the 4-vs-3 count for m = 5..7 by `decide` (the route the idea wants to avoid). -/
example : ∀ x : Fin 5,
    ((cycleClosure 5).filter (fun A => cycleInterval 5 x ⊆ A ∧ x ∈ A)).card = 3 ∧
    ((cycleClosure 5).filter (fun A => cycleInterval 5 x ⊆ A ∧ x ∉ A)).card = 4 := by decide

example : ∀ x : Fin 4,
    ((cycleClosure 4).filter (fun A => cycleInterval 4 x ⊆ A ∧ x ∈ A)).card = 3 ∧
    ((cycleClosure 4).filter (fun A => cycleInterval 4 x ⊆ A ∧ x ∉ A)).card = 3 := by decide
