    return sum((-1)**(k - i) * math.comb(k, i) * i**n for i in range(k + 1)) // math.factorial(k)

def touchard(j, lam):
    return sum(stirling2(j, m) * lam**m for m in range(j + 1))
def pois_tail(t, lam):
    return sum(math.exp(-lam + r*math.log(lam) - math.lgamma(r+1)) for r in range(t, 200))

