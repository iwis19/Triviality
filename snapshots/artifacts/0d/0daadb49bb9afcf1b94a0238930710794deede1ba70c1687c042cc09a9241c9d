// Exhaustive distribution of r(n) = #{k>=1 : 2^k < n, n - 2^k prime} for odd n <= 2^LMAX.
// Output: per block L (2^L < n <= 2^{L+1}), histogram of r(n) over odd n.
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
int main(int argc,char**argv){
  int LMAX = argc>1?atoi(argv[1]):30;
  uint64_t N = 1ULL<<LMAX;
  uint8_t *comp = calloc(N/8+1,1);           // bit i set => i composite (odd numbers only used, but simple)
  #define SET(i) (comp[(i)>>3] |= 1<<((i)&7))
  #define ISP(i) (!(comp[(i)>>3]>>((i)&7)&1))
  SET(0);SET(1);
  for(uint64_t i=2;i*i<N;i++) if(ISP(i)) for(uint64_t j=i*i;j<N;j+=i) SET(j);
  static uint64_t hist[70][70];
  for(int L=1;L<LMAX;L++){
    uint64_t lo=1ULL<<L, hi=1ULL<<(L+1);
    for(uint64_t n=lo+1;n<hi;n+=2){
      int r=0;
      for(int k=1;k<=L;k++){ uint64_t m=n-(1ULL<<k); if(ISP(m)) r++; }
      hist[L][r]++;
    }
    printf("L=%d",L);
    for(int r=0;r<=L;r++) printf(" %llu",(unsigned long long)hist[L][r]);
    printf("\n"); fflush(stdout);
  }
  return 0;
}

