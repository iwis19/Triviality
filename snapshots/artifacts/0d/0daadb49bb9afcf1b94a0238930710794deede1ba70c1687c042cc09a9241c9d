"""Large-sieve / Selberg sum L_j(Q) = sum_{q<=Q} mu^2(q) prod_{p|q} omega_K(p)/(p-omega_K(p))
for the shift set K = {2^k : k=1..j} (omega_K(p) = #{2^k mod p : k in K}), evaluated exactly for Q=2^15, 2^20.
Montgomery-Vaughan: #{n<=X : n-2^k prime for all k in K} <= (X + Q^2)/L_j(Q) (plus O(j) small primes).
Tests the claimed uniform evaluation L_j(Q) >= (log Q/(C log j))^j against the standard (log Q)^j/(j! C^j) shape."""
import math, sys
from sympy import primerange, n_order
out=[]
def P(*a): print(*a); out.append(' '.join(map(str,a)))
for LQ in (15, 20):
    Q = 1 << LQ
    primes = list(primerange(2, Q + 1))
    ordp = {p: (1 if p == 2 else n_order(2, p)) for p in primes}
    P(f"Q=2^{LQ}, log Q={math.log(Q):.3f}")
    for j in list(range(1, 21)) + [25, 30]:
        # multiplicative sieve of g(q)=mu^2(q) prod omega/(p-omega)
        g = [0.0] * (Q + 1); g[1] = 1.0
        for q in range(2, Q + 1): g[q] = 1.0
        for p in primes:
            om = min(j, ordp[p]) if p > 2 else 1
            fac = om / (p - om)
            for m in range(p, Q + 1, p): g[m] *= fac
            p2 = p * p
            for m in range(p2, Q + 1, p2): g[m] = 0.0
        L = sum(g)
        lj = L ** (1 / j)
        C_needed = math.log(Q) / (lj * math.log(j)) if j > 1 else float('nan')
        ratio_fact = L * math.factorial(j) / math.log(Q) ** j
        P(f"  j={j:2d}: L_j(Q)={L:.4g}  L^(1/j)={lj:.3f}  C needed for L>=(logQ/(C log j))^j: {C_needed:.3f}   L*j!/(log Q)^j={ratio_fact:.4g}  bound (X+Q^2)/L per X: {2/L:.3e}")
open('largesieve_out.txt','w').write('\n'.join(out))

