# Copy to backend/.env (gitignored). Never commit real keys.
MATHLAB_OWNER_API_KEY=change-me-owner-key

# mock (default, no Devin usage) or api (Devin v3 cloud API)
MATHLAB_DEVIN_PROVIDER=mock
MATHLAB_DEVIN_API_KEY=
MATHLAB_DEVIN_ORG_ID=
# Attribute API-created sessions to this user's plan (found on any session in the v3 API).
MATHLAB_DEVIN_CREATE_AS_USER_ID=
# Per-session ACU cap; leave empty for none.
MATHLAB_DEVIN_MAX_ACU_LIMIT=5

# Run the research loop in-process.
MATHLAB_SCHEDULER_ENABLED=false
MATHLAB_SCHEDULER_INTERVAL_SECONDS=60

# URL Devin sessions can reach to POST progress to /worker/*; localhost is unreachable from
# cloud sessions, in which case only the final structured output is ingested.
MATHLAB_PUBLIC_BASE_URL=http://localhost:8000
