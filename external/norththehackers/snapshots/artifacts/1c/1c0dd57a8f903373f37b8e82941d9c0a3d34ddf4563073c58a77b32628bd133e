## forced_rot.py (rotated unions + radius-class forcing)
```python
#!/usr/bin/env python3
"""Rotated-union amplification of the forced-colour-class test.
H = G ∪ R_phi1 G ∪ ... (rotations about the origin); the premise
'N(origin) avoids S' applies to all copies (a.e. rotation). Edges of H are
all numerically-unit pairs (tol 1e-9), so accidental cross-copy edges count.
Also reports 'radius-class forcing': for each radius r, whether every
5-colouring puts >=1 vertex of H at radius r into S.
"""
import sys, math, json, time, random
sys.path.insert(0, '/home/ubuntu/hn')
from forced_class import read_edge, read_vtx, K, Cadical153

def build(name, angles, origin_idx=1, root='/home/ubuntu/hn/CNP-SAT'):
    n, E = read_edge(f'{root}/edge/{name}.edge')
    pts = read_vtx(f'{root}/vtx/{name}.vtx')
    o = pts[origin_idx-1]; assert abs(o[0]) < 1e-12 and abs(o[1]) < 1e-12
    P = []
    for a in [0.0] + list(angles):
        c, s = math.cos(a), math.sin(a)
        for (x, y) in pts:
            P.append((c*x - s*y, s*x + c*y))
    # dedupe
    key = lambda p: (round(p[0], 7), round(p[1], 7))
    idx = {}; V = []
    for p in P:
        k = key(p)
        if k not in idx: idx[k] = len(V); V.append(p)
    # unit edges via grid hashing
    cell = {}
    for i, p in enumerate(V):
        cell.setdefault((math.floor(p[0]), math.floor(p[1])), []).append(i)
    edges = set()
    for i, p in enumerate(V):
        cx, cy = math.floor(p[0]), math.floor(p[1])
        for dx in (-2, -1, 0, 1, 2):
            for dy in (-2, -1, 0, 1, 2):
                for j in cell.get((cx+dx, cy+dy), []):
                    if j > i and abs(math.dist(p, V[j]) - 1) < 1e-9:
                        edges.add((i, j))
    return V, sorted(edges), idx[key((0.0, 0.0))]

def test(name, angles, S=(0, 1), origin_idx=1):
    V, E, o = build(name, angles, origin_idx)
    n = len(V); var = lambda v, c: v*K + c + 1
    cl = []
    for v in range(n):
        cl.append([var(v, c) for c in range(K)])
        for a in range(K):
            for b in range(a+1, K): cl.append([-var(v, a), -var(v, b)])
    for u, v in E:
        for c in range(K): cl.append([-var(u, c), -var(v, c)])
    nb = {v for u, v in E if u == o} | {u for u, v in E if v == o}
    for w in nb:
        for c in S: cl.append([-var(w, c)])
    res = {'graph': name, 'angles': angles, 'n': n, 'm': len(E), 'deg_origin': len(nb), 'S': list(S)}
    t0 = time.time()
    notS = [c for c in range(K) if c not in S]
    with Cadical153(bootstrap_with=cl) as s:
        res['premise_satisfiable'] = s.solve()
        if not res['premise_satisfiable']: return res
        forced_in = []; forced_out = []
        for v in range(n):
            if v == o or v in nb: continue
            if all(not s.solve(assumptions=[var(v, c)]) for c in notS): forced_in.append(v)
            if all(not s.solve(assumptions=[var(v, c)]) for c in S): forced_out.append(v)
        res['forced_in'] = [(V[v], math.hypot(*V[v])) for v in forced_in]
        res['forced_out'] = [(V[v], math.hypot(*V[v])) for v in forced_out]
        # radius-class forcing: is there a colouring with ALL vertices at radius r outside S?
        radii = {}
        for v in range(n):
            if v == o or v in nb: continue
            radii.setdefault(round(math.hypot(*V[v]), 6), []).append(v)
        rc = []
        for r, vs in sorted(radii.items()):
            # assumptions: each v in vs takes colour not in S -> encode via fresh selector? use clauses per v with assumptions on selector
            # simpler: add temporary clauses using an activation literal
            act = n*K + 1 + len(rc)
            for v in vs: s.add_clause([-act] + [var(v, c) for c in notS])
            ok = s.solve(assumptions=[act])
            if not ok: rc.append((r, len(vs)))
        res['radius_classes_forced_into_S'] = rc
        res['num_radius_classes'] = len(radii)
    res['time_s'] = round(time.time() - t0, 1)
    return res

if __name__ == '__main__':
    random.seed(1)
    out = []
    for name, oi in [('510', 1), ('517', 1), ('L403', 1), ('S199', 1), ('T721', 3)]:
        for angles in [[], [random.uniform(0, 2*math.pi)], [random.uniform(0, 2*math.pi) for _ in range(2)]]:
            r = test(name, angles, origin_idx=oi)
            print(json.dumps(r), flush=True); out.append(r)
    # structured rotations that create cross edges: rotate by angle mapping a unit vector to another
    json.dump(out, open('/home/ubuntu/hn/results_rot.json', 'w'), indent=1)

```

