# Forced-colour-class SAT test on Heule's 5-chromatic graphs

Source graphs: github.com/marijnheule/CNP-SAT (edge/*.edge, vtx/*.vtx), commit bb41495. Solver: pysat CaDiCaL 1.5.3.
Sanity: 510.edge has no 4-colouring (CaDiCaL UNSAT, 5.5 s, with origin=colour0 and one neighbour=colour1 symmetry breaking); all edges numerically unit (tol 1e-9).

## forced_class.py
```python
#!/usr/bin/env python3
"""Forced-colour-class test (Polymath16 thread-4 style criterion) on Heule's
5-chromatic unit-distance graphs (marijnheule/CNP-SAT, edge/*.edge, vtx/*.vtx).

For a graph G with vertex 1 = origin (checked), colours 0..4:
  premise P(S, o): every neighbour of the origin avoids the colour set S;
                   optionally origin has colour o.
  For each vertex v (not origin, not a neighbour) test whether
    F(G) & P & (v not in S)      is UNSAT  -> v forced INTO S
    F(G) & P & (v in S)          is UNSAT  -> v forced OUT of S
Reports forced vertices with |v| and the angle theta=2*asin(1/(2|v|)).
"""
import sys, re, math, json, time
from pysat.solvers import Cadical153
from pysat.formula import CNF

K = 5

def read_edge(fn):
    n = m = None; E = []
    for line in open(fn):
        t = line.split()
        if not t: continue
        if t[0] == 'p': n, m = int(t[2]), int(t[3])
        elif t[0] == 'e': E.append((int(t[1]), int(t[2])))
    assert len(E) == m
    return n, E

def read_vtx(fn):
    pts = []
    for line in open(fn):
        s = line.strip()
        if not s: continue
        s = s.strip('{}')
        s = re.sub(r'Sqrt\[([^\]]*)\]', r'math.sqrt(\1)', s)
        x, y = s.split(',')
        pts.append((eval(x, {'math': math}), eval(y, {'math': math})))
    return pts

def var(v, c):  # v 1-based, c 0..K-1
    return (v - 1) * K + c + 1

def base_cnf(n, E):
    cl = []
    for v in range(1, n + 1):
        cl.append([var(v, c) for c in range(K)])
        for a in range(K):
            for b in range(a + 1, K):
                cl.append([-var(v, a), -var(v, b)])
    for (u, v) in E:
        for c in range(K):
            cl.append([-var(u, c), -var(v, c)])
    return cl

def run(name, S, origin_colour, root='/home/ubuntu/hn/CNP-SAT'):
    n, E = read_edge(f'{root}/edge/{name}.edge')
    pts = read_vtx(f'{root}/vtx/{name}.vtx')
    assert len(pts) == n and abs(pts[0][0]) < 1e-12 and abs(pts[0][1]) < 1e-12, 'vertex 1 must be origin'
    # sanity: every edge has unit length (numerically)
    bad = [(u, v) for (u, v) in E if abs(math.dist(pts[u-1], pts[v-1]) - 1) > 1e-9]
    assert not bad, bad[:5]
    nbrs = sorted({v for (u, v) in E if u == 1} | {u for (u, v) in E if v == 1})
    cl = base_cnf(n, E)
    for w in nbrs:
        for c in S:
            cl.append([-var(w, c)])
    if origin_colour is not None:
        cl.append([var(1, origin_colour)])
    res = {'graph': name, 'n': n, 'm': len(E), 'deg_origin': len(nbrs), 'S': S,
           'origin_colour': origin_colour, 'forced_in': [], 'forced_out': []}
    t0 = time.time()
    with Cadical153(bootstrap_with=cl) as s:
        sat = s.solve()
        res['premise_satisfiable'] = sat
        if not sat:
            return res
        others = [v for v in range(2, n + 1) if v not in nbrs]
        notS = [c for c in range(K) if c not in S]
        for v in others:
            # forced into S: assume v takes some colour outside S -> need UNSAT for all such
            fin = all(not s.solve(assumptions=[var(v, c)]) for c in notS)
            fout = all(not s.solve(assumptions=[var(v, c)]) for c in S)
            r = math.hypot(*pts[v-1])
            if fin or fout:
                th = 2 * math.asin(1 / (2 * r)) if r >= 0.5 else None
                res['forced_in' if fin else 'forced_out'].append(
                    {'v': v, 'xy': pts[v-1], 'r': r, 'theta_over_pi': (th / math.pi) if th else None})
    res['time_s'] = round(time.time() - t0, 1)
    return res

if __name__ == '__main__':
    out = []
    graphs = sys.argv[1:] or ['510', '517', '529', '553']
    for g in graphs:
        for S, o in [([0, 1], None), ([0, 1], 0), ([0], 0), ([0], None)]:
            r = run(g, S, o)
            print(json.dumps(r), flush=True)
            out.append(r)
    json.dump(out, open('/home/ubuntu/hn/results.json', 'w'), indent=1)

```

