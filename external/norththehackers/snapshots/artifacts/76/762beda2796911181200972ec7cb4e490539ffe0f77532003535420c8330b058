#!/usr/bin/env python3
"""Independent re-implementation of the galloping intersection for
T = {n : base-3 digits <=1, base-5 digits <=2, base-7 digits <=3}
(Kummer: gcd(C(2n,n),105)=1).  Used to spot-check claims in ideas
7cec77b2 (counts, clusters) and f040cbd7 (exact count below 3^15).
"""
import sys, time, hashlib

BASES = [(3, 1), (5, 2), (7, 3)]  # (p, max digit)

def digits(n, p):
    d = []
    while n:
        d.append(n % p); n //= p
    return d  # least significant first

def next_good(x, p, dmax):
    """least y >= x with all base-p digits <= dmax"""
    d = digits(x, p)
    # most significant bad digit
    bad = -1
    for i in range(len(d) - 1, -1, -1):
        if d[i] > dmax:
            bad = i; break
    if bad < 0:
        return x
    # find lowest position j > bad with d[j] < dmax (can be incremented)
    j = bad + 1
    while j < len(d) and d[j] >= dmax:
        j += 1
    if j == len(d):
        return p ** len(d)          # new leading digit 1
    d[j] += 1
    for i in range(j):
        d[i] = 0
    y = 0
    for i in range(len(d) - 1, -1, -1):
        y = y * p + d[i]
    return y

def in_T(n):
    return all(all(c <= dm for c in digits(n, p)) for p, dm in BASES)

def enumerate_T(limit):
    out = []
    x = 0
    while x < limit:
        changed = True
        while changed:
            changed = False
            for p, dm in BASES:
                y = next_good(x, p, dm)
                if y != x:
                    x = y; changed = True
        if x >= limit:
            break
        assert in_T(x)
        out.append(x)
        x += 1
    return out

def clusters(T, ratio=1.001):
    cl = []
    cur = [T[0]]
    for a, b in zip(T, T[1:]):
        if a > 0 and b < a * ratio:
            cur.append(b)
        else:
            cl.append(cur); cur = [b]
    cl.append(cur)
    return cl

if __name__ == '__main__':
    E = int(sys.argv[1]) if len(sys.argv) > 1 else 30
    t0 = time.time()
    T = enumerate_T(10 ** E)
    print(f"|T cap [0,10^{E})| = {len(T)}  (incl. 0)   time {time.time()-t0:.1f}s")
    for e in range(5, E + 1, 5):
        c = sum(1 for n in T if 1 <= n < 10 ** e)
        heur = (10 ** e) ** 0.02595
        print(f"  A(10^{e}) = {c:6d}   heuristic x^0.02595 = {heur:8.2f}   ratio {c/heur:6.2f}")
    print("  |T cap [0,3^15)| =", sum(1 for n in T if n < 3 ** 15))
    h = hashlib.sha256(("\n".join(map(str, T)) + "\n").encode()).hexdigest()
    print("  sha256 of list:", h)
    cl = clusters([n for n in T if n >= 1])
    print(f"  clusters (ratio<1.001) below 10^{E}: {len(cl)}")
    for e in (10, 20, 30, 40, 50, 60, 70):
        if e <= E:
            print(f"    clusters below 10^{e}: {sum(1 for c in cl if c[0] < 10**e)}")
    open(f'T_1e{E}.txt', 'w').write("\n".join(map(str, T)) + "\n")

