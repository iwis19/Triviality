#!/usr/bin/env python3
"""Experiment 4: intrinsic-moduli constraints.

For a solution n in (2^K, 2^{K+1}] put q_k = n - 2^k (all prime).  Since
q_k | (n - 2^j) - (n - 2^k) = 2^k - 2^j, we get  q_k | n - 2^j  iff  ord_{q_k}(2) | (j - k).
Hence a solution must satisfy   ord_{q_k}(2) ∤ (j-k) for all j != k in [1,K],
i.e. ord_{q_k}(2) > max(k-1, K-k)  (in particular ord_r(2) >= K for r = n - 2^K, so r > K).

We (1) check this on the 7 known solutions, and (2) look at the record-holders n
(argmax of r(n) in each dyadic block, from exp1) to see which primes account for the
composite n - 2^k: are they small (< K), medium, or 'intrinsic' (equal to some q_j)?
"""
from sympy import isprime, n_order, factorint, primerange

def K_of(n):
    return (n - 1).bit_length() - 1  # number of k>=1 with 2^k < n

print("known solutions: order constraints")
for n in [4, 7, 15, 21, 45, 75, 105]:
    K = K_of(n)
    ok = True
    for k in range(1, K + 1):
        q = n - 2 ** k
        if q == 2:
            continue
        o = n_order(2, q)
        need = max(k - 1, K - k)
        if o <= need:
            ok = False
    print(f"n={n:4d} K={K} r=n-2^K={n-2**K:3d} ord_r(2)={n_order(2,n-2**K) if n-2**K>2 else '-'} all-order-constraints-hold={ok}")

# S-primes (2 primitive root) up to 200
S = [p for p in primerange(3, 200) if n_order(2, p) == p - 1]
print("primes with 2 a primitive root (<200):", S)

records = [195, 465, 525, 1095, 2145, 4935, 14955, 18525, 42705, 80685, 229845, 267645, 664125,
           1575285, 2426655, 4555155, 15054105, 20435415, 53999715, 101291505, 194401185,
           335200515, 994034415, 1116594765]
print("\nrecord holders of r(n) per dyadic block: which primes kill the composite n-2^k ?")
for n in records:
    K = K_of(n)
    fails = []
    for k in range(1, K + 1):
        m = n - 2 ** k
        if not isprime(m):
            f = factorint(m)
            fails.append((k, min(f)))
    smallS = [p for p in S if n % p == 0]
    print(f"n={n:11d} K={K:2d} n's S-prime divisors={smallS}  fails (k, least prime factor)={fails}")


