#!/usr/bin/env python3
"""Experiment 6 (idea I5): reproducible re-derivation of the empty-range statement using only
(a) the primitive-root lemma (Lean: dvd_of_erdos1142_of_primitiveRoot, hypothesis 2^(p-1)+p < n) and
(b) BPSW-style probable-prime tests (gmpy2.is_prime, 25 rounds).

For K in [KMIN, KMAX]: let S(K) = {p prime, p <= K+1, 2 primitive root mod p}, M = prod S(K).
Every solution n in (2^K, 2^{K+1}] with n > 2^K + K + 1 is a multiple of M (lemma (a) for each p in S(K),
since 2^(p-1) + p <= 2^K + K + 1 < n).  The finitely many n in (2^K, 2^K + K + 1] are tested directly.
Candidates are tested by early-exit primality of n - 2^k, k = 1..K.
Assumption: gmpy2.is_prime has no false negatives (true: it is Miller-Rabin; a composite could only be
reported prime, which would make the search *miss* a failure, i.e. report a false candidate, never miss a true solution).
Usage: python3 exp6_search.py KMIN KMAX
"""
import sys, time, math
import gmpy2
from sympy import primerange, n_order

KMIN, KMAX = int(sys.argv[1]), int(sys.argv[2])

def is_solution(n, K):
    for k in range(1, K + 1):
        if not gmpy2.is_prime(n - (1 << k), 25):
            return False
    return True

total_cand = 0
for K in range(KMIN, KMAX + 1):
    t0 = time.time()
    S = [p for p in primerange(3, K + 2) if n_order(2, p) == p - 1]
    M = math.prod(S)
    lo, hi = (1 << K) + 1, 1 << (K + 1)
    sols = []
    # small strip handled directly
    for n in range(lo, min(hi, (1 << K) + K + 1) + 1):
        if is_solution(n, K):
            sols.append(n)
    # multiples of M above the strip
    start = ((1 << K) + K + 1) // M + 1
    m = start
    cand = 0
    while m * M <= hi:
        n = m * M
        cand += 1
        if is_solution(n, K):
            sols.append(n)
        m += 1
    total_cand += cand
    print(f"K={K:3d} |S|={len(S):2d} log2M={math.log2(M):6.2f} candidates={cand:9d} solutions={sols}  ({time.time()-t0:.1f}s)", flush=True)
print("total candidates tested:", total_cand)


