import Mathlib

/-!
Erdős #835, formal skeleton.

`Property k` : the k-subsets of {0,…,2k-1} can be (k+1)-coloured so that every
(k+1)-subset A sees all k+1 colours on its k-subsets.  (Same meaning as the
reference formalization in google-deepmind/formal-conjectures, with `B ⊆ A`
phrased through `A.powerset` so that small cases are decidable.)

We record: (1) `Property 2` holds (the 1-factorization of K_4), and
(2) the clique lemma that drives every reduction used in the hypotheses:
for a colouring witnessing `Property k`, the k+1 supersets of a (k-1)-set
must receive k+1 distinct colours, i.e. each colour class is an S(k-1,k,2k).
-/


def Property (k : ℕ) : Prop :=
  ∃ c : Finset (Fin (2 * k)) → Fin (k + 1),
    ∀ A : Finset (Fin (2 * k)), A.card = k + 1 →
      ∀ i : Fin (k + 1), ∃ B ∈ A.powerset, B.card = k ∧ c B = i

/-- The 1-factorization of K₄ : {01,23} ↦ 0, {02,13} ↦ 1, {03,12} ↦ 2. -/
def c2 (B : Finset (Fin 4)) : Fin 3 :=
  if B = {0, 1} ∨ B = {2, 3} then 0
  else if B = {0, 2} ∨ B = {1, 3} then 1
  else 2

theorem property_two : Property 2 := by
  refine ⟨c2, ?_⟩
  decide

