#!/usr/bin/env python3
"""
Critic re-computation for idea ab5d2ea8 (prime-power correction PP(N) to the
Hardy-Littlewood integral main term for Goldbach representation counts).

Conventions (ordered representations, as implied by the factor 2 in PP):
  R(N)      = #{(p,q) primes, p+q=N}
  S(N)      = 2*C_2 * prod_{p|N, p>2} (p-1)/(p-2)          (C_2 twin-prime constant)
  HL_int(N) = S(N) * sum_{3<=t<=N-3} 1/(log t log(N-t))
  PP(N)     = 2 * sum_{k>=2} (1/k) * #{q prime : q^k < N, N-q^k prime}
  PPlog(N)  = 2 * sum_{k>=2} sum_{q^k<N, N-q^k prime} log(q) log(N-q^k) / log(N)^2
              (what one gets from crude 'divide the Lambda-weighted count by log^2 N')
  PP_asym(N)= closed-form local-factor approximation (Granville-type) with
              coefficient 2/sqrt(N)*prod_{p not | 2N}(1 - (N/p)/(p-2)) times HL_int(N)
Everything computed exactly (R, HL_int, PP) via FFT convolution for all even N <= X.
"""
import numpy as np, math, sys, json
from numpy.fft import rfft, irfft

X = int(sys.argv[1]) if len(sys.argv) > 1 else 10**6
LO = int(sys.argv[2]) if len(sys.argv) > 2 else 10**5

# ---------- sieve ----------
def sieve(n):
    s = np.ones(n + 1, dtype=bool); s[:2] = False
    for i in range(2, int(n**0.5) + 1):
        if s[i]: s[i*i::i] = False
    return s
isp = sieve(X)
primes = np.nonzero(isp)[0]

# smallest prime factor for singular series
spf = np.zeros(X + 1, dtype=np.int64)
for p in primes:
    if p * p > X: break
    m = spf[p::p] == 0
    idx = np.arange(p, X + 1, p)[m]
    spf[idx] = p
spf[spf == 0] = np.arange(X + 1)[spf == 0]

C2 = 0.6601618158468695739278121100145557784326233602847334133194484233354056423
def singular(N):
    s = 2 * C2
    n = N
    while n > 1:
        p = spf[n]
        if p > 2: s *= (p - 1) / (p - 2)
        while n % p == 0: n //= p
    return s
Ns = np.arange(LO, X + 1, 2)
S = np.array([singular(int(N)) for N in Ns])

# ---------- R(N) via FFT ----------
L = 1
while L < 2 * X + 2: L *= 2
f = np.zeros(L); f[primes] = 1.0
Rall = np.rint(irfft(rfft(f) ** 2, L)).astype(np.int64)   # ordered count
R = Rall[Ns]

# ---------- HL_int via FFT of 1/log t ----------
g = np.zeros(L); t = np.arange(3, X + 1); g[t] = 1.0 / np.log(t)
Hall = irfft(rfft(g) ** 2, L)  # sum_{t+u=N, t,u>=3} 1/(log t log u)
HL = S * Hall[Ns]

# ---------- PP(N) exact ----------
PP = np.zeros(X + 1); PPlog = np.zeros(X + 1); PP2 = np.zeros(X + 1)  # PP2 = k=2 part only
logN = np.log(np.arange(X + 1, dtype=float).clip(1))
for q in primes:
    if q * q >= X: break
    k = 2; qk = q * q
    while qk < X:
        # N ranges over qk+2 .. X ; contributes if N - qk prime
        Nr = np.arange(qk + 2, X + 1)
        hit = isp[Nr - qk]
        PP[Nr] += 2.0 / k * hit
        if k == 2: PP2[Nr] += 2.0 / k * hit
        PPlog[Nr] += 2.0 * hit * math.log(q) * np.log(Nr - qk) / logN[Nr] ** 2
        k += 1; qk *= q
# both-prime-power term (k,l>=2), weight 1/(k l), ordered
BB = np.zeros(X + 1)
pps = []
for q in primes:
    if q * q >= X: break
    k = 2; qk = q * q
    while qk < X:
        pps.append((qk, k)); k += 1; qk *= q
pps.sort()
for a, k in pps:
    for b, l in pps:
        if a + b > X: break
        BB[a + b] += 1.0 / (k * l)
PPv = PP[Ns]; PPlogv = PPlog[Ns]; BBv = BB[Ns]; PP2v = PP2[Ns]

# ---------- closed-form local factor approx ----------
# PP_asym(N) = HL_int(N) * (2/sqrt N) * prod_{3<=p<=P, p not | N} (1 - (N/p)/(p-2))
P = 3000
smallp = [int(p) for p in primes[(primes >= 3) & (primes <= P)]]
def legendre(a, p):
    a %= p
    if a == 0: return 0
    return 1 if pow(int(a), (p - 1) // 2, p) == 1 else -1
def asym_factor(N):
    prod = 1.0
    for p in smallp:
        if N % p == 0: continue
        prod *= 1 - legendre(N, p) / (p - 2)
    return prod
# this loop is slowish: subsample for the check
sub = np.arange(0, len(Ns), 50)
AF = np.array([asym_factor(int(N)) for N in Ns[sub]])
PPasym_sub = HL[sub] * 2.0 / np.sqrt(Ns[sub]) * AF

# ---------- statistics ----------
def rep(name, x):
    m = x.mean(); sd = x.std(ddof=1); se = sd / math.sqrt(len(x))
    print(f"{name:34s} mean={m:+.4f}  sd={sd:.3f}  SE={se:.4f}  n={len(x)}")
    return m, sd, se

print(f"== even N in [{LO},{X}] ==")
res0 = R - HL
rep("R - HL_int", res0)
rep("-PP", -PPv)
rep("-PPlog", -PPlogv)
rep("-(PP+BB)", -(PPv + BBv))
rep("R - HL_int + PP", res0 + PPv)
rep("R - HL_int + PPlog", res0 + PPlogv)
rep("R - HL_int + PP + BB", res0 + PPv + BBv)
print("ratio mean(R-HL)/mean(-PP) =", res0.mean() / (-PPv.mean()))
print("ratio mean(R-HL)/mean(-PPlog) =", res0.mean() / (-PPlogv.mean()))
# regression of (R-HL) on -PP with intercept
A = np.vstack([-PPv, np.ones_like(PPv)]).T
coef, *_ = np.linalg.lstsq(A, res0, rcond=None)
resid = res0 - A @ coef
cov = np.linalg.inv(A.T @ A) * resid.var(ddof=2)
print(f"OLS (R-HL) = a*(-PP) + c : a={coef[0]:.4f}±{math.sqrt(cov[0,0]):.4f}, c={coef[1]:.3f}±{math.sqrt(cov[1,1]):.3f}")
A2 = np.vstack([-PPv, -PPlogv, np.ones_like(PPv)]).T
coef2, *_ = np.linalg.lstsq(A2, res0, rcond=None)
resid2 = res0 - A2 @ coef2
cov2 = np.linalg.inv(A2.T @ A2) * resid2.var(ddof=3)
print(f"OLS (R-HL) = a*(-PP) + b*(-PPlog) + c : a={coef2[0]:.3f}±{math.sqrt(cov2[0,0]):.3f}, b={coef2[1]:.3f}±{math.sqrt(cov2[1,1]):.3f}, c={coef2[2]:.3f}±{math.sqrt(cov2[2,2]):.3f}")
print("corr(PP, PPlog) =", np.corrcoef(PPv, PPlogv)[0, 1])

# class means mod 3, 5, 7 of relative residuals
for q in (3, 5, 7, 8):
    for name, x in (("R/HL-1", R / HL - 1), ("(R-HL+PP)/HL", (R - HL + PPv) / HL), ("(R-HL+PPlog)/HL", (R - HL + PPlogv) / HL)):
        out = []
        for a in range(q):
            m = Ns % q == a
            if m.sum() == 0: continue
            v = x[m]
            out.append(f"{a}:{v.mean():+.5f}±{v.std(ddof=1)/math.sqrt(m.sum()):.5f}")
        print(f"mod {q} {name:18s} " + "  ".join(out))

# sub-range stability of the ratio
edges = [LO, 2 * 10**5, 4 * 10**5, 7 * 10**5, X + 1] if X >= 10**6 else [LO, X + 1]
for lo, hi in zip(edges[:-1], edges[1:]):
    m = (Ns >= lo) & (Ns < hi)
    a = res0[m].mean(); b = -PPv[m].mean(); c = (res0[m] + PPv[m])
    print(f"[{lo},{hi}): mean(R-HL)={a:+.3f} mean(-PP)={b:+.3f} ratio={a/b:.3f}  mean(R-HL+PP)={c.mean():+.3f}±{c.std(ddof=1)/math.sqrt(m.sum()):.3f}  sd(res)/sqrtN={c.std()/math.sqrt(Ns[m].mean()):.3f}")

# closed form vs exact PP
print("closed form check (subsample):")
print("  mean PP exact       =", PPv[sub].mean())
print("  mean PP_asym coef 2 =", PPasym_sub.mean(), " coef 4 would be", 2 * PPasym_sub.mean())
print("  corr(PP exact, PP_asym) =", np.corrcoef(PPv[sub], PPasym_sub)[0, 1])
print("  OLS slope PP exact on PP_asym =", np.dot(PPv[sub], PPasym_sub) / np.dot(PPasym_sub, PPasym_sub))
print("  k=2 share of PP:", PP2v.mean() / PPv.mean())

np.savez("/home/ubuntu/pp_data.npz", Ns=Ns, R=R, HL=HL, PP=PPv, PPlog=PPlogv, BB=BBv)
