===== safe.py =====
"""Compute B_j = set of primes p > j such that some nonempty subset of {1..j}
has reciprocal sum whose reduced numerator is divisible by p.  (p is 'j-safe' iff p not in B_j.)
Writes minbad_J.txt: lines 'p j' with j = minimal level at which p in B_j (j<=J)."""
from fractions import Fraction
import sys

def primes_dividing(n):
    out = set(); d = 2
    while d * d <= n:
        while n % d == 0:
            out.add(d); n //= d
        d += 1
    if n > 1: out.add(n)
    return out

def B(j):
    sums = {Fraction(0)}
    for m in range(1, j + 1):
        sums |= {s + Fraction(1, m) for s in sums}
    sums.discard(Fraction(0))
    bad = set()
    for s in sums:
        bad |= {p for p in primes_dividing(s.numerator) if p > j}
    return sorted(bad)

if __name__ == "__main__":
    J = int(sys.argv[1]) if len(sys.argv) > 1 else 12
    minbad = {}
    for j in range(1, J + 1):
        b = B(j)
        for p in b:
            minbad.setdefault(p, j)
        print(j, len(b), b if len(b) < 40 else b[:40] + ['...'])
    # sanity: monotonicity B_{j-1} subset B_j (restricted to p>j)
    with open(f"minbad_{J}.txt", "w") as f:
        for p in sorted(minbad):
            f.write(f"{p} {minbad[p]}\n")

