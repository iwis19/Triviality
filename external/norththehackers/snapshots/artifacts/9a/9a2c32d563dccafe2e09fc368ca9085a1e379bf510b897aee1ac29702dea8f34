/* Part A: sweep N = 2..NMAX.  A gap<=2 counterexample S subset [n_1,N] (n_1,N in S, sum 1/n = 1)
   must have n_1 <= n1max(N) := max{n : H(N)-H(n-1) >= 1}.
   Forced-out elements (p-adic top-level lemma): m = a p with p prime, j = floor(N/p) <= J (so p^2 > N),
   p not in B_j ('j-safe'), 1 <= a <= j, n1max(N) <= m <= N.   Then m-1, m+1 are forced INTO S
   (gap<=2), and Q_l := l^{1+max_{n in S} v_l(n)} divides no element of S, hence none of these.
   cnt[l][t] = #{forced-in g : l^t | g}.  Q_l can only be an 'unblocked' power (cnt==0).
   Top-level parity/size: |T_l| >= 2 gives Q_2 <= 2N/3, Q_3 <= 3N/2.
   'closed_by_Q2'  : no unblocked 2^t <= 2N/3            => no counterexample with n_k = N.
   'closed_by_Q2Q3': every unblocked pair has Q_2*Q_3 <= N-n1max (violates CRT claim C-CRT) => closed.
   Usage: ./moduli NMAX J minbadfile [printevery] */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

static int J;
static unsigned char *minbad;  /* minimal j<=J with p in B_j, 0 if none (safe at all levels <= J) */
static char *comp;
static long NMAX;
static long cnt2[64], cnt3[64];
static inline int safe(long p,int j){ return minbad[p]==0 || minbad[p]>j; }

static void addelem(long g, int sgn){
  long x=g; int j=0; while(x%2==0){x/=2;j++;} for(int t=1;t<=j;t++) cnt2[t]+=sgn;
  x=g; j=0; while(x%3==0){x/=3;j++;} for(int t=1;t<=j;t++) cnt3[t]+=sgn;
}

int main(int argc,char**argv){
  NMAX=atol(argv[1]); J=atoi(argv[2]);
  long printevery = argc>4? atol(argv[4]) : 1;
  comp=calloc(NMAX+2,1); minbad=calloc(NMAX+2,1);
  for(long i=2;i*i<=NMAX;i++) if(!comp[i]) for(long k=i*i;k<=NMAX;k+=i) comp[k]=1;
  FILE*f=fopen(argv[3],"r"); long p; int j; while(fscanf(f,"%ld %d",&p,&j)==2) if(p<=NMAX) minbad[p]=j; fclose(f);
  long double *H=malloc(sizeof(long double)*(NMAX+2)); H[0]=0; for(long i=1;i<=NMAX;i++) H[i]=H[i-1]+1.0L/i;
  long n1max=1;
  long pend[64]; int npend=0;
  long stat_closed2=0, stat_small2=0, stat_Nkilled=0, stat_closed23=0, total=0;
  long maxres2=0, maxres2N=0; long bin_tot[9]={0}, bin_closed[9]={0}, bin_closed23[9]={0};
  long lastclosed=0, maxgap=0, maxgapN=0;
  for(long N=2;N<=NMAX;N++){
    for(int t=0;t<npend;t++) addelem(pend[t],+1); npend=0;
    int Nkilled=0;
    /* level events: N = j*p, p prime, j<=J  (p enters at j=1, leaves at j=J+1) */
    for(int jj=1;jj<=J+1;jj++){
      if(N%jj) continue; long q=N/jj; if(q<2||comp[q]) continue;
      if(q<=n1max && jj==1) continue; /* n1max<=... p=N>n1max always for N>=2 actually */
      if(jj==J+1){ /* p leaves: remove all current contributions if safe at level J */
        if(safe(q,J)) for(int a=1;a<=J;a++){ long m=(long)a*q; if(m>=n1max){ addelem(m-1,-1); addelem(m+1,-1);} }
        continue;
      }
      if(jj==1){ addelem(q-1,+1); pend[npend++]=q+1; Nkilled=1; continue; }
      int wasafe=safe(q,jj-1), nowsafe=safe(q,jj);
      if(wasafe && nowsafe){ addelem(N-1,+1); pend[npend++]=N+1; Nkilled=1; }
      else if(wasafe && !nowsafe){ for(int a=1;a<jj;a++){ long m=(long)a*q; if(m>=n1max){ addelem(m-1,-1); addelem(m+1,-1);} } }
    }
    /* n1max update: remove forced elements m in [old,new) */
    long old=n1max;
    while(n1max+1<=N && H[N]-H[n1max] >= 1.0L) n1max++;
    for(long m=old;m<n1max;m++){
      for(int a=1;a<=J;a++){ if(m%a) continue; long q=m/a; if(q<2||comp[q]) continue; int lev=N/q; if(lev>J||lev<a) continue;
        if(safe(q,lev)){ addelem(m-1,-1); addelem(m+1,-1);} }
    }
    if(N<(J+1)*(J+1)) continue;
    total++;
    long thr = (long)floorl(sqrtl((long double)(N-n1max)));
    long Q=2; int t=1; while(cnt2[t]>0){ t++; Q*=2; }
    long minQ2=Q; int res2=0; for(long q=Q;3*q<=2*N;q*=2) res2++;
    long Q3=3; t=1; while(cnt3[t]>0){ t++; Q3*=3; }
    long minQ3=Q3; int res3=0; for(long q=Q3;2*q<=3*N;q*=3) res3++;
    int b=0; for(long x=N;x>=10;x/=10) b++;
    bin_tot[b]++; if(res2==0) bin_closed[b]++;
    int ok=0; for(long q=minQ2;3*q<=2*N;q*=2) for(long r=minQ3;2*r<=3*N;r*=3) if(q*r>N-n1max) ok=1;
    if(!ok){stat_closed23++; bin_closed23[b]++;}
    if(res2==0) stat_closed2++;
    if(minQ2<=thr) stat_small2++;
    if(Nkilled) stat_Nkilled++;
    if(res2>maxres2){maxres2=res2;maxres2N=N;}
    if(res2==0||!ok||Nkilled){ if(N-lastclosed>maxgap){maxgap=N-lastclosed;maxgapN=N;} lastclosed=N; }
    if(N%printevery==0 || N<=120)
      printf("N=%ld n1max=%ld sqrt(N-n1max)=%ld Nkilled=%d minQ2=%ld res2=%d minQ3=%ld res3=%d closed23=%d\n",N,n1max,thr,Nkilled,minQ2,res2,minQ3,res3,!ok);
  }
  for(int b=0;b<9;b++) if(bin_tot[b]) printf("decade 10^%d: N=%ld closed_by_Q2=%ld (%.1f%%) closed_by_Q2Q3=%ld (%.1f%%)\n",b,bin_tot[b],bin_closed[b],100.0*bin_closed[b]/bin_tot[b],bin_closed23[b],100.0*bin_closed23[b]/bin_tot[b]);
  printf("SUMMARY NMAX=%ld J=%d analysed=%ld N_forced_out=%ld closed_by_Q2=%ld closed_by_Q2Q3=%ld minQ2<=sqrt(N-n1max)=%ld max_res2=%ld at N=%ld; longest run of N not closed by (Nkilled|Q2|Q2Q3): %ld ending at N=%ld\n",
    NMAX,J,total,stat_Nkilled,stat_closed2,stat_closed23,stat_small2,maxres2,maxres2N,maxgap-1,maxgapN-1);
  return 0;
}

===== survq.c (Part B) =====
/* Part B: enumerate all S subset [n1,N] with n1,N in S, no two consecutive integers missing (gap<=2),
   all forced-out elements (m=a p, p prime, j=floor(N/p)<=J, p j-safe, a<=j) excluded,
   sum_{S} 1/n in [0.5,2], and v_2(sum) >= 0.  For survivors tabulate Q_2, Q_3 and check
   Q_2*Q_3 > N-n1 (claim C-CRT) ; also report survivors with v_3>=0, v_5>=0 additionally.
   Usage: ./survq n1 N J minbadfile */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
typedef unsigned long long u64;
static int n1,N,J; static unsigned char minbad[100000]; static char comp[100000];
static char forcedout[4096]; static char inS[4096];
static u64 c2[4096]; static u64 c3[4096], c5[4096]; static u64 M2, M3, M5; static int e2,e3,e5;
static double rem[4096]; static double inv[4096];
static long leaves=0, surv2=0, surv23=0, surv235=0, crtviol=0;
static long histQ2[64], histQ3[64]; static long histQ2_23[64];
static u64 powmod(u64 b,u64 e,u64 m){u64 r=1;b%=m;while(e){if(e&1)r=(unsigned __int128)r*b%m;b=(unsigned __int128)b*b%m;e>>=1;}return r;}
static u64 inv2_64(u64 a){u64 x=a;for(int i=0;i<6;i++)x*=2-a*x;return x;} /* a odd */
static u64 invmod(u64 a,u64 m,u64 phi){return powmod(a,phi-1,m);}
static int vp(int n,int p){int v=0;while(n%p==0){n/=p;v++;}return v;}
static void leaf(){
  leaves++;
  u64 r2=0,r3=0,r5=0; double s=0; int a2=0,a3=0;
  for(int n=n1;n<=N;n++) if(inS[n]){ r2+=c2[n]; r3=(r3+c3[n])%M3; r5=(r5+c5[n])%M5; s+=inv[n]; int v=vp(n,2); if(v>a2)a2=v; v=vp(n,3); if(v>a3)a3=v; }
  if(s<0.5||s>2) return;
  if((r2 & (M2-1))!=0) return;
  surv2++; histQ2[a2+1]++; histQ3[a3+1]++;
  long Q2=1L<<(a2+1), Q3=1; for(int i=0;i<=a3;i++) Q3*=3;
  if(Q2*Q3<=N-n1){ crtviol++; }
  if(r3==0){ surv23++; histQ2_23[a2+1]++; if(r5==0) surv235++; }
}
static void dfs(int n,int prevExcluded,double s,double smax){
  /* smax = s + sum of inv over [n,N]; prune */
  if(smax<0.5) return;
  if(s>2) return;
  if(n==N){ inS[N]=1; leaf(); return; }
  if(!forcedout[n]){ inS[n]=1; dfs(n+1,0,s+inv[n],smax); }
  if(!prevExcluded){ inS[n]=0; dfs(n+1,1,s,smax-inv[n]); }
}
int main(int argc,char**argv){
  n1=atoi(argv[1]); N=atoi(argv[2]); J=atoi(argv[3]);
  for(int i=2;i*i<100000;i++) if(!comp[i]) for(int k=i*i;k<100000;k+=i) comp[k]=1;
  FILE*f=fopen(argv[4],"r"); long p; int j; while(fscanf(f,"%ld %d",&p,&j)==2) if(p<100000) minbad[p]=j; fclose(f);
  /* forced out */
  int nforced=0;
  for(int m=n1;m<=N;m++){ for(int a=1;a<=J;a++){ if(m%a) continue; int q=m/a; if(q<2||comp[q]) continue; int lev=N/q; if(lev>J) continue; if((long)q*q<=N) continue;
      if(minbad[q]==0||minbad[q]>lev){ forcedout[m]=1; } } if(forcedout[m]) nforced++; }
  if(forcedout[n1]||forcedout[N]){ printf("n1=%d N=%d: endpoint forced out -> no set\n",n1,N); return 0; }
  for(int m=n1;m<N;m++) if(forcedout[m]&&forcedout[m+1]){ printf("n1=%d N=%d: adjacent forced-out pair %d,%d -> no set\n",n1,N,m,m+1); return 0; }
  /* moduli */
  e2=0; while((1<<(e2+1))<=N) e2++; M2=1ULL<<e2;
  e3=0; {long t=3; while(t<=N){t*=3;e3++;}} M3=1; for(int i=0;i<e3;i++) M3*=3;
  e5=0; {long t=5; while(t<=N){t*=5;e5++;}} M5=1; for(int i=0;i<e5;i++) M5*=5;
  /* L_odd mod 2^64, L/3^e3 mod 3^e3, L/5^e5 mod 5^e5 */
  u64 Lodd=1, L3=1, L5=1;
  for(int q=2;q<=N;q++) if(!comp[q]){ long pk=q; while(pk*q<=N) pk*=q;
    if(q!=2) Lodd*= (u64)pk; if(q!=3) L3=(unsigned __int128)L3*pk%M3; if(q!=5) L5=(unsigned __int128)L5*pk%M5; }
  u64 phi3=M3/3*2, phi5=M5/5*4;
  for(int n=1;n<=N;n++){
    inv[n]=1.0/n;
    int v=vp(n,2); int nodd=n>>v; c2[n]=(Lodd*inv2_64(nodd))<<(e2-v);
    v=vp(n,3); int n3=n; for(int i=0;i<v;i++) n3/=3; { u64 t=(unsigned __int128)L3*invmod(n3%M3,M3,phi3)%M3; for(int i=0;i<e3-v;i++) t=t*3%M3; c3[n]=t; }
    v=vp(n,5); int n5=n; for(int i=0;i<v;i++) n5/=5; { u64 t=(unsigned __int128)L5*invmod(n5%M5,M5,phi5)%M5; for(int i=0;i<e5-v;i++) t=t*5%M5; c5[n]=t; }
  }
  double smax=0; for(int n=n1;n<=N;n++) smax+=inv[n];
  memset(inS,0,sizeof inS); inS[n1]=1;
  dfs(n1+1,0,inv[n1],smax);
  printf("n1=%d N=%d len=%d forcedout=%d leaves(gap<=2,forced,sum-pruned)=%ld surv_v2=%ld surv_v2v3=%ld surv_v2v3v5=%ld CRTviol=%ld\n",n1,N,N-n1,nforced,leaves,surv2,surv23,surv235,crtviol);
  printf("  Q2 hist (v2 survivors): "); for(int i=1;i<64;i++) if(histQ2[i]) printf("2^%d:%ld ",i,histQ2[i]); printf("\n");
  printf("  Q2 hist (v2&v3 survivors): "); for(int i=1;i<64;i++) if(histQ2_23[i]) printf("2^%d:%ld ",i,histQ2_23[i]); printf("\n");
  printf("  Q3 hist (v2 survivors): "); for(int i=1;i<64;i++) if(histQ3[i]) printf("3^%d:%ld ",i,histQ3[i]); printf("\n");
  return 0;
}

