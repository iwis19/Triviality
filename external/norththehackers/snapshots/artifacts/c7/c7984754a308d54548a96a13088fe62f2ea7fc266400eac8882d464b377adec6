#!/usr/bin/env python3
"""For each n, find the minimal k>=1 with n(n+1)...(n+k-1) | (n+k)...(n+2k-1).

Uses Legendre's formula: with A = (n+2k-1)!, B = (n+k-1)!, C = (n-1)!,
the ratio equals A*C/B^2 and divisibility <=> v_p(A)+v_p(C) >= 2 v_p(B) for all p.
"""
import sys
from math import isqrt

def primes_upto(N):
    s = bytearray([1]) * (N + 1)
    s[0:2] = b"\x00\x00"
    for i in range(2, isqrt(N) + 1):
        if s[i]:
            s[i*i::i] = bytearray(len(s[i*i::i]))
    return [i for i in range(N + 1) if s[i]]

def vfact(m, p):
    v = 0
    while m:
        m //= p
        v += m
    return v

def divides(n, k, primes):
    top = n + 2*k - 1
    for p in primes:
        if p > top:
            break
        if vfact(top, p) + vfact(n-1, p) < 2*vfact(n+k-1, p):
            return False, p
    return True, None

def min_k(n, kmax, primes):
    for k in range(1, kmax + 1):
        ok, _ = divides(n, k, primes)
        if ok:
            return k
    return None

if __name__ == "__main__":
    N = int(sys.argv[1]) if len(sys.argv) > 1 else 200
    KMAX = int(sys.argv[2]) if len(sys.argv) > 2 else 20000
    primes = primes_upto(N + 2*KMAX)
    for n in range(1, N + 1):
        k = min_k(n, KMAX, primes)
        print(n, k, (k/n if k else None), flush=True)
