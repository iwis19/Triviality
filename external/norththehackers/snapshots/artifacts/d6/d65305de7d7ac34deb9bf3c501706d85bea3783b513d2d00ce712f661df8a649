"""
Numerical checks for Erdős #699 hypothesis-generation.

L1 (prime-power middle lemma): for a prime p >= i with p | C(n,i) and p !| C(n,j)
    (1 <= i < j <= n/2), writing e = v_p(C(n,i)), n0 = n mod p, j0 = j mod p:
        j0 <= n0 < i   and   p^e | (n - 2j) - (n0 - 2*j0).
    Consequence C1: in a counterexample with d = n-2j >= i,
        V_i(n) := prod_{p>=i} p^{v_p(C(n,i))}  divides  prod_{|t|<i} (d - t).

L3 (parity lemma, near-middle): if n = 2j + d with 0 <= d < i, p prime, p > i,
    n0 = n mod p < i, p > n0 + d and floor(n/p) odd, then p | C(n,j).
    Consequence C4: in a near-middle counterexample every prime factor p>i of an odd
    member n-k (k<i) of the block satisfies p <= k + d.

Everything is checked by brute force using Kummer's theorem for v_p(C(n,k)).
"""
import sys
from math import comb, gcd

def sieve(N):
    spf = list(range(N + 1))
    for i in range(2, int(N ** 0.5) + 1):
        if spf[i] == i:
            for k in range(i * i, N + 1, i):
                if spf[k] == k:
                    spf[k] = i
    return spf

def vp_binom(n, k, p):
    """Kummer: number of carries adding k and n-k in base p."""
    a, b, carries, c = k, n - k, 0, 0
    while a or b or c:
        s = a % p + b % p + c
        c = 1 if s >= p else 0
        carries += c
        a //= p; b //= p
    return carries

def primes_upto(N):
    spf = sieve(N)
    return [p for p in range(2, N + 1) if spf[p] == p]

def check_L1(NMAX):
    primes = primes_upto(NMAX)
    tested = violations = 0
    for n in range(4, NMAX + 1):
        for i in range(1, n // 2 + 1):
            # primes p >= i dividing C(n,i): p>i iff n mod p < i; p == i iff v>=1
            P = []
            for p in primes:
                if p < i:
                    continue
                if p > n:
                    break
                e = vp_binom(n, i, p)
                if e > 0:
                    P.append((p, e))
            for j in range(i + 1, n // 2 + 1):
                for (p, e) in P:
                    if vp_binom(n, j, p) == 0:
                        tested += 1
                        n0, j0 = n % p, j % p
                        ok = (j0 <= n0 < i) and ((n - 2 * j) - (n0 - 2 * j0)) % (p ** e) == 0
                        if not ok:
                            violations += 1
                            print("L1 VIOLATION", n, i, j, p, e)
    return tested, violations

def check_C1_on_gt_variant(NMAX):
    """Counterexamples to the '>i' variant with d>=i: check V'_i(n) | prod_{|t|<i}(d-t)."""
    primes = primes_upto(NMAX)
    found = []
    for n in range(4, NMAX + 1):
        for i in range(2, n // 2 + 1):
            ci = comb(n, i)
            for j in range(i + 1, n // 2 + 1):
                g = gcd(ci, comb(n, j))
                # strip primes <= i
                h = g
                for p in primes:
                    if p > i: break
                    while h % p == 0: h //= p
                if h == 1:
                    d = n - 2 * j
                    # V' = part of C(n,i) on primes > i
                    V = ci
                    for p in primes:
                        if p > i: break
                        while V % p == 0: V //= p
                    prod = 1
                    for t in range(-(i - 1), i):
                        prod *= (d - t)
                    found.append((n, i, j, g, d, prod % V == 0 if d >= i else "d<i"))
    return found

def check_L3(NMAX):
    primes = primes_upto(NMAX)
    tested = violations = 0
    for n in range(6, NMAX + 1):
        for i in range(2, n // 2 + 1):
            for d in range(0, i):
                if (n - d) % 2: continue
                j = (n - d) // 2
                if j <= i: continue
                for p in primes:
                    if p <= i: continue
                    if p > n: break
                    n0 = n % p
                    if n0 < i and p > n0 + d and (n // p) % 2 == 1:
                        tested += 1
                        if vp_binom(n, j, p) == 0 or vp_binom(n, i, p) == 0:
                            violations += 1
                            print("L3 VIOLATION", n, i, d, j, p)
    return tested, violations

if __name__ == "__main__":
    N1 = int(sys.argv[1]) if len(sys.argv) > 1 else 300
    print("L1 (tested, violations):", check_L1(N1))
    print("L3 (tested, violations):", check_L3(N1))
    print("'>i' near-counterexamples n<=%d and C1 divisibility:" % N1)
    for row in check_C1_on_gt_variant(N1):
        print("  ", row)
    # Cong's larger examples of the '>i' variant, checked with Kummer directly
    big = [(512, 2, 147), (2048, 2, 713), (2188, 3, 1094), (1594324, 3, 797162)]
    for (n, i, j) in big:
        d = n - 2 * j
        ps = [p for p in primes_upto(2000) if p > i]
        # V' over primes >i dividing C(n,i): here only small n-k factors matter; factor directly
        V = 1
        block = 1
        for k in range(i): block *= (n - k)
        m = block
        f = 2
        fac = {}
        while f * f <= m:
            while m % f == 0:
                fac[f] = fac.get(f, 0) + 1; m //= f
            f += 1
        if m > 1: fac[m] = fac.get(m, 0) + 1
        for p in fac:
            if p > i:
                e = vp_binom(n, i, p)
                if e: V *= p ** e
        prod = 1
        for t in range(-(i - 1), i): prod *= (d - t)
        print("big example", (n, i, j), "d=", d, "V'=", V, "V' | prod:", (prod % V == 0) if d >= i else "d<i")
