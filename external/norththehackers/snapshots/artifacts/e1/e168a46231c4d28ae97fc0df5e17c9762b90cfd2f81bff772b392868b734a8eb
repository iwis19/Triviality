S40 /= np.linalg.norm(S40, axis=1, keepdims=True)
print("Sloane pack.5.40 antipodal:", is_antipodal(S40, tol=1e-4))
# distance distribution as isometry invariant
def inner_product_histogram(X):
    G = np.round(X @ X.T, 3)
    vals, cnt = np.unique(G[np.triu_indices(len(X), 1)], return_counts=True)
    return dict(zip(vals, cnt))
print("D5 ip histogram   :", inner_product_histogram(D5))
print("C5-40b ip histogram:", inner_product_histogram(C40b))
print("Sloane40 ip histogram:", inner_product_histogram(S40))


# augment-then-relax: maximise t s.t. <x_i,x_j> <= cos(t) via SLSQP on 41 points (smooth reformulation with slack s = max ip)
def relax(X0, iters=3000):
    N, n = X0.shape
    iu = np.triu_indices(N, 1)

    def unpack(z):
        X = z[:-1].reshape(N, n)
        return X, z[-1]

    def obj(z):
        return z[-1]  # minimise max inner product s

    def cons_ip(z):
        X, s = unpack(z)
        G = X @ X.T
        return s - G[iu]  # >= 0

    def cons_norm(z):
        X, s = unpack(z)
        return np.sum(X * X, axis=1) - 1  # == 0

    z0 = np.concatenate([X0.ravel(), [((X0 @ X0.T) - 2 * np.eye(N)).max()]])
    r = minimize(obj, z0, method="SLSQP",
                 constraints=[{"type": "ineq", "fun": cons_ip}, {"type": "eq", "fun": cons_norm}],
                 options={"maxiter": iters, "ftol": 1e-12})
    X, s = unpack(r.x)
    X /= np.linalg.norm(X, axis=1, keepdims=True)
    return gram_stats(X)[1], X


for name, X in (("D5", D5), ("C5-40b", C40b)):
    h, p = deepest_hole(X, starts=500)
    X41 = np.vstack([X, p])
    ang, _ = relax(X41)
    print(f"augment-then-relax from {name}+hole: 41-point min angle {ang:.4f} deg")
