    pass

rows = []
for line in open(sys.argv[1]):
    mo = re.match(r'k=(\d+) n=(\d+) m=(\d+)', line)
    if not mo: continue
    k, n, m = map(int, mo.groups())
    Fm, Fn = F(k, m), F(k, n)
    q = Fraction(Fm, Fn)
    assert is_square(q.numerator) and is_square(q.denominator), (k, n, m)  # hash collision check
    integer = (q.denominator == 1)
    admissible = (m >= n + k)
    rows.append((k, n, m, integer, admissible, q))

rows.sort()
print("k n m integer? admissible? ratio(sqrt if integer)")
for k, n, m, integer, adm, q in rows:
    if integer:
        print(k, n, m, "INT", "ADM" if adm else "overlap", "N=%d=%d^2" % (q.numerator, isqrt(q.numerator)))
    else:
        print(k, n, m, "rational", "ADM" if adm else "overlap", "ratio=%d/%d" % (q.numerator, q.denominator))
