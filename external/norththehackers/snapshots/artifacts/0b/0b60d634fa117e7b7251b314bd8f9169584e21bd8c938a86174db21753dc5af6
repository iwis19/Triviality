import sys, re
from fractions import Fraction
from math import isqrt, gcd

def F(k, t):
    p = 1
    for i in range(1, k+1):
        p *= (t+i)
    return p

def is_square(x):
    if x < 0: return False
    r = isqrt(x); return r*r == x

