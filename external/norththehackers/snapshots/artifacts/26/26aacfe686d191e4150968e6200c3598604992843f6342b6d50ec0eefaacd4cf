#!/usr/bin/env python3
r"""
Coverage of the e = V \ N[x] single-interval witness (idea b9c71c89) among T5-failures,
for all labelled graphs on n <= NMAX vertices WITHOUT isolated vertices.

For each (G,x) with T5(x) false we classify the witness needed:
  W    : c1 > c2 at e = V \ N[x]                         (the assigned idea's exact count)
  S1   : some single interval e' (x ∉ e') with |F∩up(e')∩F_{¬x}| > |F∩up(e')∩F_x|  (claim 6b3646f7 / U(x) fails)
  multi: no single interval works (Hall violator must be a union of >= 2 up-intervals)
Also checks that the sufficient criterion of claim 39e94af9 implies W, and reports the
smallest (G,x) with T5 false but W false.
"""
import itertools, sys
from check_exact_count import closure, nbr_mask, derived, matching_exists, submasks

NMAX = int(sys.argv[1]) if len(sys.argv) > 1 else 6

def fmt(S, n):
    return "{" + ",".join(str(v) for v in range(n) if (S >> v) & 1) + "}"

def main():
    stats = {}
    smallest = None
    crit_not_W = 0
    for n in range(2, NMAX + 1):
        pairs = list(itertools.combinations(range(n), 2))
        V = (1 << n) - 1
        st = dict(graphs=0, t5fail_pairs=0, W=0, S1_not_W=0, multi=0,
                  allfail=0, allfail_W=0, allfail_S1=0, allfail_crit=0)
        for mask in range(1 << len(pairs)):
            adj = [0] * n
            edges = []
            for i, (u, v) in enumerate(pairs):
                if (mask >> i) & 1:
                    adj[u] |= 1 << v; adj[v] |= 1 << u
                    edges.append((1 << u) | (1 << v))
            if any(a == 0 for a in adj):
                continue
            st['graphs'] += 1
            F = closure(edges)
            allfail = allW = allS1 = allcrit = True
            for x in range(n):
                bx = 1 << x
                Nx = adj[x]
                e = V & ~Nx & ~bx
                left = [A for A in F if not (A & bx)]
                right = [B for B in F if (B & bx)]
                t5 = matching_exists(left, right, lambda a, b: (a & b) == a)
                c1 = sum(1 for A in left if (A & e) == e)
                c2 = sum(1 for A in right if (A & e) == e)
                W = c1 > c2
                # sufficient criterion of claim 39e94af9
                crit = (e != 0 and (nbr_mask(adj, e) == e)
                        and all((adj[v] & e) for v in range(n) if (Nx >> v) & 1))
                if crit and not W:
                    crit_not_W += 1
                if t5:
                    allfail = False
                if not W:
                    allW = False
                if not crit:
                    allcrit = False
                if not t5:
                    st['t5fail_pairs'] += 1
                    if W:
                        st['W'] += 1
                    else:
                        # any single interval e' ⊆ V\{x}?
                        S1 = False
                        for ep in range(0, 1 << n):
                            if ep & bx:
                                continue
                            a = sum(1 for A in left if (A & ep) == ep)
                            b = sum(1 for B in right if (B & ep) == ep)
                            if a > b:
                                S1 = True; break
                        if S1:
                            st['S1_not_W'] += 1
                        else:
                            st['multi'] += 1
                            allS1 = False
                        if smallest is None or (n, len(F)) < smallest[0]:
                            smallest = ((n, len(F)), edges[:], x, c1, c2, S1)
            if allfail:
                st['allfail'] += 1
                if allW: st['allfail_W'] += 1
                if allS1: st['allfail_S1'] += 1
                if allcrit: st['allfail_crit'] += 1
        stats[n] = st
    for n, st in stats.items():
        print(f"n={n}: graphs(no isolated v)={st['graphs']}, (G,x) with T5 false={st['t5fail_pairs']}: "
              f"W={st['W']}, single-interval-but-not-W={st['S1_not_W']}, multi-interval needed={st['multi']}; "
              f"graphs failing T5 at all x={st['allfail']}: all-x explained by W={st['allfail_W']}, "
              f"by some single interval={st['allfail_S1']}, by the 39e94af9 criterion={st['allfail_crit']}")
    print(f"criterion(39e94af9) true but W false (must be 0): {crit_not_W}")
    if smallest:
        (n, fs), edges, x, c1, c2, S1 = smallest
        print(f"smallest (G,x) with T5(x) false but W(x) false: n={n}, |F|={fs}, x={x}, "
              f"edges={[fmt(e, n) for e in edges]}, c1={c1}, c2={c2}, single-interval witness elsewhere={S1}")

if __name__ == "__main__":
    main()


