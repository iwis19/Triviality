# sanity: every positive solution of s^2-3t^2=-2 with t<=10^6 lies in the orbit (1+sqrt3)(2+sqrt3)^i
from math import isqrt
orbit=set(); s,t=1,1
while t<=10**6:
    orbit.add((s,t)); s,t=2*s+3*t,s+2*t
bad=[(isqrt(3*t*t-2),t) for t in range(1,10**6+1) if (lambda r:(r*r==3*t*t-2))(isqrt(3*t*t-2)) and (isqrt(3*t*t-2),t) not in orbit]
print("solutions outside orbit (t<=1e6):",bad)
# k=3: T(n,3)=M/C(n+3,3) values
from math import gcd,comb
def M(n,k):
    v=1
    for x in range(n+1,n+k+1): v=v*x//gcd(v,x)
    return v
print("T(n,3) values n<10^5:",sorted(set(M(n,3)//comb(n+3,3) for n in range(10**5))))
