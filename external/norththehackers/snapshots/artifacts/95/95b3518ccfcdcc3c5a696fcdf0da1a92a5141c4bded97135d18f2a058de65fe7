0.23363417767348485, -0.13705907042078055], [0.28429537997362825, -0.16471610995000696], [0.32589931207142575, -0.19074377581982702]]}, {\"file\": \"run_sub1_s0.log\", \"n_vertices\": 8, \"L\": 1.9899113631260676, \"wild\": 0.03419983676649818, \"diam\": 0.9996931089184861, \"sep\": 0.9999949359569368, \"overlap\": 0.0, \"union_check\": 2.220446049250313e-16, \"feasible\": false, \"vertices\": [[0.3681028177257932, -0.21999539417346545], [0.7572477417511176, -0.44270538189626885], [1.135994757502955, -0.2021372601682848], [1.1185327787497346, 0.21071266646078704], [0.7669302069461218, 0.4373038991070348], [0.38791163826986663, 0.21655721711352882], [0.17970591063599967, 0.08923527350120357], [0.18584261801968838, -0.12119331953647194]]}, {\"file\": \"run_sub3_s1.log\", \"n_vertices\": 24, \"L\": 1.9908175783241862, \"wild\": 0.02891274958396972, \"diam\": 0.9999999989999997, \"sep\": 0.9999939063025476, \"overlap\": 0.0, \"union_check\": 2.220446049250313e-16, \"feasible\": false, \"vertices\": [[0.37621951705687395, -0.22085381691259695], [0.5097844307434113, -0.29511741300483785], [0.632945069988425, -0.36731545452355696], [0.7544882943304841, -0.44004784603310665], [0.8886865666230221, -0.3588006747595805], [1.0085908890371225, -0.29133186144927314], [1.1266135507645423, -0.22002406150928308], [1.1244569402441114, -0.07007262070808822], [1.1255548567935043, 0.08601658987174578], [1.1228802220004144, 0.21460569806069352], [0.9917444825046875, 0.2946764198218506], [0.869137392044963, 0.36926068709239884], [0.7613952583746295, 0.4349015482425295], [0.6398904452027391, 0.3674418750325657], [0.5153025832024801, 0.296669586995181], [0.38541409309661195, 0.21854603305587683], [0.32992870233570937, 0.18949623126526344], [0.2549391252370884, 0.14688548617327368], [0.18816715414873167, 0.10910061829354696], [0.15990432624448805, 0.035853395934382304], [0.16103411150356187, -0.042998212832091945], [0.1872205830436238, -0.10760640463002168], [0.2607656616314717, -0.1509078097314819], [0.3205415283145685, -0.18556640586977252]]}]", "README.txt": "Pritikin-type near-6-colouring experiment (2026-09-19).\nRun: pip install numpy scipy shapely; python3 ansatz.py; for a in '1 0' '2 0' '2 7' '3 1' '4 2'; do python3 optimize.py $a > run_sub${a/ /_s}.log; done; python3 finalize.py\nStage A (concentric-shrink ansatz, exact bisection): best s=0.436500 t=0.218475 wild density p=0.0357879 (1/p=27.9).\nStage B (free polygon, 6-fold symmetric, Nelder-Mead + kicks): best certified p=0.027957 (16 vertices, L=1.988561; 1/p=35.8);\n runs with 16/24/32 vertices plateau at p in [0.0280,0.0298].  Constraints re-checked: diam<=1, same-colour separation>=1,\n zero pairwise overlap, union area in fundamental domain == 6*area(T) to 1e-9.\n"}