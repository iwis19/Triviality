#!/usr/bin/env python3
"""Checks for idea 7cec77b2 (anchored clusters) and idea a6534b6d (base-7 cylinders),
using T_1e70.txt produced by isect_check.py 70.
(1) For each cluster (maximal run with ratio<1.001) find the largest a,b,c such that all
    members agree above base-3 position a, base-5 position b, base-7 position c; then the
    cylinder intersection I is an interval; compare |cluster| with |T ∩ I| (the 'shifted
    small problem' count) and record the moduli 3^a,5^b,7^c relative to the anchor.
(2) Count |S3∩S5∩[0,3^L)| and |T∩[0,3^L)|; compare the conditional fraction with (4/7)^k,
    k = number of base-7 digits of 3^L-1; and measure the distribution of the TOP base-7
    digit of S3∩S5∩[0,3^L) (equidistribution in base-7 cylinders is claimed for LOW digits).
"""
import math, sys
from isect_check import digits, next_good, in_T

T = [int(x) for x in open('T_1e70.txt')]
T = [n for n in T if n >= 1]

def clusters(T, ratio=1.001):
    cl, cur = [], [T[0]]
    for a, b in zip(T, T[1:]):
        if b < a * ratio: cur.append(b)
        else: cl.append(cur); cur = [b]
    cl.append(cur); return cl

def agree_pos(C, p):
    # smallest a such that all members have identical base-p digits at positions >= a
    a = 0
    while True:
        if len({n // p ** a for n in C}) == 1: return a
        a += 1

print("cluster | size | anchor(min) | a b c | 3^a 5^b 7^c / anchor | |T∩I| (I=cylinder intersection) | I length/anchor")
for C in clusters(T)[:0]:
    a, b, c = agree_pos(C, 3), agree_pos(C, 5), agree_pos(C, 7)
    n0 = C[0]
    lo = max((n0 // 3**a) * 3**a, (n0 // 5**b) * 5**b, (n0 // 7**c) * 7**c)
    hi = min((n0 // 3**a + 1) * 3**a, (n0 // 5**b + 1) * 5**b, (n0 // 7**c + 1) * 7**c)
    cnt = sum(1 for n in T if lo <= n < hi)
    print(f"{len(C):6d} {n0:>72d} {a:3d}{b:3d}{c:3d}  {3**a/n0:.1e} {5**b/n0:.1e} {7**c/n0:.1e}  {cnt:6d}  {(hi-lo)/n0:.1e}")

# (2) two-base set
def enum2(limit, bases):
    out, x = [], 0
    while x < limit:
        changed = True
        while changed:
            changed = False
            for p, dm in bases:
                y = next_good(x, p, dm)
                if y != x: x = y; changed = True
        if x >= limit: break
        if x >= 1: out.append(x)
        x += 1
    return out

for L in (20, 24, 28, 30):
    N = 3 ** L
    S35 = enum2(N, [(3, 1), (5, 2)])
    k = len(digits(N - 1, 7))
    TL = sum(1 for n in S35 if all(d <= 3 for d in digits(n, 7)))
    top = [0] * 7
    for n in S35:
        top[digits(n, 7)[-1]] += 1
    low_ok = sum(1 for n in S35 if all(d <= 3 for d in digits(n, 7)[:3])) / len(S35)
    top3_ok = sum(1 for n in S35 if all(d <= 3 for d in digits(n, 7)[-3:])) / len(S35)
    print(f"L={L}: |S3∩S5∩[0,3^L)|={len(S35)}  exponent={math.log(len(S35))/math.log(N):.4f}  "
          f"|T∩[0,3^L)|={TL}  cond.frac={TL/len(S35):.3e}  (4/7)^k (k={k})={(4/7)**k:.3e}  ratio={TL/len(S35)/(4/7)**k:.2f}")
    print(f"      top base-7 digit distribution: {[round(t/len(S35),3) for t in top]}  "
          f"P(low 3 digits<=3)={low_ok:.3f} vs (4/7)^3={(4/7)**3:.3f};  P(top 3 digits<=3)={top3_ok:.3f}")

