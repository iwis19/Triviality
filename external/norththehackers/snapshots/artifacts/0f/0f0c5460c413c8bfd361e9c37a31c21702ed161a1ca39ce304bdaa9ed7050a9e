"""Check public 41-point records on S^4: Cohn's spherical-codes.org (5,41) and Sloane's pack.5.41 / pack.5.40.
Also: contact graph statistics and a crude rigidity test (rank of the contact-stress/constraint Jacobian)."""
import numpy as np

def load_cohn(fn):
    X = np.loadtxt(fn, delimiter=',')
    return X / np.linalg.norm(X, axis=1, keepdims=True)

def load_sloane(fn, n=5):
    v = np.loadtxt(fn)
    X = v.reshape(-1, n)
    return X / np.linalg.norm(X, axis=1, keepdims=True)

def report(name, X, tol=1e-6):
    N = len(X)
    G = X @ X.T
    iu = np.triu_indices(N, 1)
    mx = G[iu].max()
    ang = np.degrees(np.arccos(mx))
    ncontact = int(np.sum(G[iu] > mx - tol))
    antip = int(np.sum(G[iu] < -1 + 1e-6))
    print(f"{name}: N={N}, max cos={mx:.12f}, min angle={ang:.4f} deg, #pairs at max (tol {tol})={ncontact}, antipodal pairs={antip}")
    # contact degrees
    C = (G > mx - tol) & ~np.eye(N, dtype=bool)
    deg = C.sum(1)
    print("   contact degrees: min", deg.min(), "max", deg.max(), "mean", round(deg.mean(), 3))
    # infinitesimal rigidity test (CJKT Sect. 2): motions v_i with <x_i, v_i> = 0 and <x_i - x_j, v_i - v_j> >= 0 for contacts.
    # Necessary condition for being locally jammed at a strict local optimum: check rank of contact constraint matrix.
    n = X.shape[1]
    rows = []
    for i, j in zip(*np.where(np.triu(C, 1))):
        r = np.zeros(N * n)
        r[i * n:(i + 1) * n] = X[j]
        r[j * n:(j + 1) * n] = X[i]
        rows.append(r)
    A = np.array(rows)
    # tangency constraints
    T = np.zeros((N, N * n))
    for i in range(N):
        T[i, i * n:(i + 1) * n] = X[i]
    M = np.vstack([A, T])
    rank = np.linalg.matrix_rank(M, tol=1e-8)
    dof = N * (n - 1) - n * (n - 1) // 2
    print(f"   contacts={len(rows)}, rank of [contact; tangency] Jacobian={rank}, N(n-1)={N*(n-1)}, minus rotations={dof}")
    return G

X41 = load_cohn('cohn_5_41.txt')
report("Cohn (5,41)", X41)
S41 = load_sloane('sloane_5_41.txt')
report("Sloane pack.5.41", S41)
S40 = load_sloane('sloane_5_40.txt')
G40 = report("Sloane pack.5.40", S40)
vals, cnt = np.unique(np.round(G40[np.triu_indices(40, 1)], 6), return_counts=True)
print("   pack.5.40 inner-product spectrum:", dict(zip(vals.tolist(), cnt.tolist())))

