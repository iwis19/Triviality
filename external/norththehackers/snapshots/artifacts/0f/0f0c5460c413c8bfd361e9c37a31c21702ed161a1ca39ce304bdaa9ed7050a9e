# symmetry group order via backtracking on Gram matrix
def symgroup_order(P, tol=1e-7):
    N = len(P); G = P @ P.T
    # choose a basis of 5 points (greedy independent)
    basis=[]; 
    for i in range(N):
        if np.linalg.matrix_rank(P[basis+[i]], tol=1e-6) == len(basis)+1: basis.append(i)
        if len(basis)==5: break
    B = P[basis]  # 5x5
    Binv = np.linalg.inv(B)
    count=0
    def rec(k, img):
        nonlocal count
        if k==5:
            # orthogonal map M with M B_i = P[img_i]: M = (P[img]^T) (B^T)^{-1}  (row conv: x M^T)
            M = np.linalg.solve(B, P[img])  # B M = P[img]
            Q = P @ M
            # check Q is a permutation of P
            D = np.linalg.norm(Q[:,None,:]-P[None,:,:],axis=2)
            if np.all(D.min(axis=1) < 1e-6): count+=1
            return
        for j in range(N):
            if j in img: continue
            if all(abs(G[basis[k],basis[m]]-G[j,img[m]])<tol for m in range(k)):
                rec(k+1, img+[j])
    rec(0, [])
    return count
"""Construct D5 and C5-40b (Leech / Cohn-Jiao-Kumar-Torquato 2011) kissing configurations on S^4,
list their inner-product spectra and estimate their covering radii (deepest holes)."""
import itertools
import numpy as np

r2 = np.sqrt(2.0)
# 24-cell: permutations of (+-1,+-1,0,0)/sqrt2
cell24 = []
for i, j in itertools.combinations(range(4), 2):
    for si in (1, -1):
        for sj in (1, -1):
            v = np.zeros(4); v[i] = si; v[j] = sj
            cell24.append(v / r2)
cell24 = np.array(cell24)
coset_a = np.array([s * np.eye(4)[i] for i in range(4) for s in (1, -1)])  # +-e_i
half = np.array([np.array(s) / 2.0 for s in itertools.product((1, -1), repeat=4)])
coset_b = np.array([w for w in half if np.prod(np.sign(w)) > 0])  # even number of minus signs
coset_c = np.array([w for w in half if np.prod(np.sign(w)) < 0])


def layered(E, A, B, cA=1 / r2, cB=-1 / r2):
    pts = [np.append(v, 0.0) for v in E]
    pts += [np.append(np.sqrt(1 - cA ** 2) * u, cA) for u in A]
    pts += [np.append(np.sqrt(1 - cB ** 2) * u, cB) for u in B]
    return np.array(pts)


D5 = layered(cell24, coset_a, coset_a)
C540b = layered(cell24, coset_a, coset_b)
for name,P in [("D5",D5),("C5-40b",C540b)]:
    P = P/np.linalg.norm(P,axis=1,keepdims=True)
    print(name, "symmetry group order (O(5) maps permuting the set):", symgroup_order(P))

