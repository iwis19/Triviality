### erdos677_support.py
#!/usr/bin/env python3
"""
Bounded experiment for Erdos #677, idea "reduce to same-prime-support".

Part A: exhaustive search for DISJOINT blocks of k consecutive integers with the
        same set of prime divisors, i.e. Supp(P_k(n)) = Supp(P_k(m)), m >= n+k,
        with both blocks inside [1, N]. Hash by the sorted tuple of primes.
Part B: for k=3..KMAX and n<=NB, count m in [n+k, 3(n+k)) with
        Supp(P_k(m)) SUBSET Supp(P_k(n)) (the relaxation that BSW remark says
        suffices for their Props 5.2 and 5.7; it is a necessary condition for
        M(m,k)=M(n,k) by I1's ratio bound m+k<3(n+k) and C3).
Part C: measure the counting inequality behind BSW Prop 5.2:
        omega'(P_k(m)) <= omega'(P_k(n)) where omega' counts distinct primes >k,
        and record min over n<=NB of max_{m in window} omega'(P_k(m)) - omega'(P_k(n)).
"""
import sys, time, math
from collections import defaultdict

N = int(sys.argv[1]) if len(sys.argv) > 1 else 10**6
KMAX = int(sys.argv[2]) if len(sys.argv) > 2 else 8
NB = int(sys.argv[3]) if len(sys.argv) > 3 else 2000

def spf_sieve(N):
    spf = list(range(N + 1))
    for i in range(2, int(N**0.5) + 1):
        if spf[i] == i:
            for j in range(i * i, N + 1, i):
                if spf[j] == j:
                    spf[j] = i
    return spf

t0 = time.time()
spf = spf_sieve(N + KMAX + 1)
print(f"sieve up to {N+KMAX+1} done in {time.time()-t0:.1f}s", flush=True)

def primes_of(x):
    s = set()
    while x > 1:
        p = spf[x]; s.add(p)
        while x % p == 0: x //= p
    return s

def block_supp(n, k):
    s = set()
    for i in range(1, k + 1):
        s |= primes_of(n + i)
    return s

def lcm_block(n, k):
    L = 1
    for i in range(1, k + 1):
        L = L * (n + i) // math.gcd(L, n + i)
    return L

# ---------- Part A ----------
print("\n=== Part A: disjoint same-support blocks, blocks inside [1,%d] ===" % N)
for k in range(2, KMAX + 1):
    t0 = time.time()
    table = defaultdict(list)
    # incremental support via multiset counts would be faster; direct is fine for N=1e6, k<=8
    cur = [primes_of(i) for i in range(1, k + 1)]  # supports of n+1..n+k for n=0
    cnt = defaultdict(int)
    for s in cur:
        for p in s: cnt[p] += 1
    sols = []
    for n in range(0, N - k + 1):
        key = tuple(sorted(cnt.keys()))
        for n0 in table[key]:
            if n - n0 >= k:
                sols.append((n0, n))
        table[key].append(n)
        # slide window: remove n+1, add n+k+1
        if n + k + 1 <= N:
            for p in cur[0]:
                cnt[p] -= 1
                if cnt[p] == 0: del cnt[p]
            cur.pop(0)
            s = primes_of(n + k + 1); cur.append(s)
            for p in s: cnt[p] += 1
    print(f"k={k}: {len(sols)} disjoint same-support pairs (n,m) with n<m, m>=n+k, m+k<={N}  [{time.time()-t0:.1f}s]")
    for (a, b) in sols[:40]:
        eq = lcm_block(a, k) == lcm_block(b, k)
        print(f"   n={a} m={b} supp={sorted(block_supp(a,k))} lcm_equal={eq} ratio(m+k)/(n+k)={(b+k)/(a+k):.3f}")
    if len(sols) > 40: print("   ...")
    # for k=2 compare with known family x=2^h-3, y=2^h(2^h-2)-1 and (74,1214)
    if k == 2:
        fam = set()
        h = 2
        while 2**h * (2**h - 2) - 1 + 2 <= N:
            fam.add((2**h - 3, 2**h * (2**h - 2) - 1)); h += 1
        fam.add((74, 1214))
        S = set(sols)
        print("   k=2 known family present:", fam <= S, " extra beyond known family:", sorted(S - fam))

# ---------- Part B & C ----------
print(f"\n=== Part B/C: n<=%d, m in [n+k, 3(n+k)), subset-support and omega' counts ===" % NB)
for k in range(3, KMAX + 1):
    t0 = time.time()
    M = 3 * (NB + k) + k
    supp = [frozenset(block_supp(m, k)) for m in range(0, M + 1)]
    om = [sum(1 for p in s if p > k) for s in supp]
    subset_hits = []
    pairs = surv_omega = surv_bigprimes = 0
    for n in range(0, NB + 1):
        Sn = supp[n]; wn = om[n]
        Sn_big = {p for p in Sn if p > k}
        for m in range(n + k, 3 * (n + k)):
            pairs += 1
            if om[m] <= wn: surv_omega += 1
            Sm_big = {p for p in supp[m] if p > k}
            if Sm_big <= Sn_big: surv_bigprimes += 1
            if supp[m] <= Sn:
                subset_hits.append((n, m, supp[m] == Sn))
    print(f"k={k}: pairs={pairs}; survivors of omega'(P_k(m))<=omega'(P_k(n)): {surv_omega} ({surv_omega/pairs:.3f}); "
          f"survivors of 'all primes>k of upper block divide lower block': {surv_bigprimes}; "
          f"full subset-support hits (n,m,equal?): {subset_hits[:20]}{' ...' if len(subset_hits)>20 else ''} total={len(subset_hits)}  [{time.time()-t0:.1f}s]", flush=True)


