"""Delsarte LP for spherical codes on S^{n-1} with inner products restricted to a domain D subset [-1,1).
Bound: min f(1) over f = 1 + sum_{k>=1} c_k G_k^{(n)}(t), c_k >= 0, f(t) <= 0 on D.
G_k^{(n)} = Gegenbauer C_k^{(n/2-1)} normalised to G_k(1) = 1.
"""
import numpy as np
from scipy.optimize import linprog
from scipy.special import eval_gegenbauer


def gegen(n, k, t):
    lam = n / 2.0 - 1.0
    return eval_gegenbauer(k, lam, t) / eval_gegenbauer(k, lam, 1.0)


def delsarte_lp(n, grid, deg=30):
    """grid: array of t-values in D (discretised). returns LP value (upper bound on code size for the discretised D;
    for a finite exact D it is the exact LP value)."""
    grid = np.asarray(grid, dtype=float)
    K = deg
    # variables c_1..c_K
    A = np.zeros((len(grid), K))
    for k in range(1, K + 1):
        A[:, k - 1] = gegen(n, k, grid)
    # 1 + A c <= 0  ->  A c <= -1
    res = linprog(c=np.ones(K), A_ub=A, b_ub=-np.ones(len(grid)), bounds=[(0, None)] * K, method="highs")
    if res.status != 0:
        return None, res
    return 1.0 + res.fun, res


def interval_grid(intervals, m=2001):
    pts = []
    for a, b in intervals:
        if b < a:
            continue
        if b == a:
            pts.append(a)
        else:
            pts.extend(np.linspace(a, b, max(3, int(m * (b - a) / 1.5))))
    return np.array(sorted(set(pts)))


if __name__ == "__main__":
    import sys
    n = 5
    print("full Delsarte LP n=5, deg 30:", delsarte_lp(5, interval_grid([(-1, 0.5)], 4001))[0])
    print("finite set {-1,-1/2,0,1/2}, deg 30:", delsarte_lp(5, [-1, -0.5, 0, 0.5], 30)[0])
    print("finite set {-1,-1/2,0,1/2}, deg 60:", delsarte_lp(5, [-1, -0.5, 0, 0.5], 60)[0])
    print("finite set {-1,-1/2,0,1/2} without -1 (no antipodes), deg 30:", delsarte_lp(5, [-0.5, 0, 0.5], 30)[0])
    S = [-1, -0.5, 0, 0.5]
    for eps in [0.01, 0.02, 0.05, 0.1, 0.15, 0.2, 0.25]:
        nb = [(max(-1, s - eps), min(0.5, s + eps)) for s in S]
        ga = interval_grid(nb, 4001)
        # complement inside [-1,0.5]
        comp = []
        lo = -1.0
        for a, b in nb:
            if a > lo:
                comp.append((lo, a))
            lo = max(lo, b)
        if lo < 0.5:
            comp.append((lo, 0.5))
        gb = interval_grid(comp, 4001) if comp else None
        va = delsarte_lp(5, ga, 30)[0]
        vb = delsarte_lp(5, gb, 30)[0] if gb is not None and len(gb) else float('nan')
        print(f"eps={eps}: (a) nbhd LP = {va:.4f}   (b) complement LP = {vb:.4f}   complement intervals={[(round(a,3),round(b,3)) for a,b in comp]}")
    # S^3 cap capacities (Musin Corollary 1) for t0 values
    print("S^3 LP capacities A(4, arccos((1/2-t0^2)/(1-t0^2))):")
    for t0 in [0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.9]:
        c = (0.5 - t0 ** 2) / (1 - t0 ** 2)
        v = delsarte_lp(4, interval_grid([(-1, c)], 4001), 30)[0]
        print(f"  t0={t0}: cos={c:.4f} LP={v:.4f} -> floor {int(np.floor(v + 1e-9))}")
    print("S^3 LP at cos 1/3 (contact degree):", delsarte_lp(4, interval_grid([(-1, 1 / 3)], 4001), 30)[0])
    print("S^3 LP at cos 1/2 (kappa(4)):", delsarte_lp(4, interval_grid([(-1, 0.5)], 4001), 30)[0])
