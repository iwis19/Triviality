"""Idea I4: search for 'prime-power-ratio-free' (PPR-free) distinct coverings: coverings
{a_m mod m} (moduli of any parity allowed) such that no used modulus n is a prime-power
multiple of another used modulus m (n/m = p^k, k>=1).  By the cyclotomic CRT computation
(cyclotomic_crt.py) these are exactly the coverings for which the Schinzel system
f = -x^{-r_m} (mod Phi_m) has no pairwise obstruction; via Schinzel's theorem (as stated in
Filaseta-Ford-Konyagin 2000) such an f would imply an odd covering exists.
Selfridge's antichain condition (erdosproblems.com/7, [Sc67]) is the special case where
no modulus divides another at all.
"""
import sys, time
from pysat.formula import IDPool
from pysat.card import CardEnc, EncType
from pysat.solvers import Cadical153
from sat_cover import divisors, sigma


def is_prime_power(n):
    if n < 2:
        return False
    p = 2
    while p * p <= n:
        if n % p == 0:
            while n % p == 0:
                n //= p
            return n == 1
        p += 1
    return True


def search(L, timeout=None):
    ds = [d for d in divisors(L)[0] if d > 1]
    pool = IDPool()
    clauses = []
    used = {}
    for d in ds:
        lits = [pool.id(('x', d, r)) for r in range(d)]
        clauses += CardEnc.atmost(lits, bound=1, vpool=pool, encoding=EncType.seqcounter).clauses
        u = pool.id(('u', d))
        used[d] = u
        for l in lits:
            clauses.append([-l, u])
        clauses.append([-u] + lits)
    for m in ds:
        for n in ds:
            if n > m and n % m == 0 and is_prime_power(n // m):
                clauses.append([-used[m], -used[n]])
    for x in range(L):
        clauses.append([pool.id(('x', d, x % d)) for d in ds])
    with Cadical153(bootstrap_with=clauses) as s:
        ok = s.solve()
        if ok:
            model = set(l for l in s.get_model() if l > 0)
            return [(d, r) for d in ds for r in range(d) if pool.id(('x', d, r)) in model]
        return None


if __name__ == '__main__':
    for L in map(int, sys.argv[1:]):
        t = time.time()
        res = search(L)
        print('L=%d %s sigma/L=%.3f : %s  (%.1fs)' % (L, divisors(L)[1], sigma(L) / L,
              'PPR-free covering FOUND: %s' % res if res else 'none (UNSAT)', time.time() - t), flush=True)
