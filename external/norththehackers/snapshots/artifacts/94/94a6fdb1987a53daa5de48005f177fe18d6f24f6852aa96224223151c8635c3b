# ===== enum_uc.c =====
// Enumerate all union-closed families on [N] (N<=5) as bitmasks over the 2^N subsets.
// Sets are processed in decreasing order of size so that all strict supersets of S
// are decided before S; including S then requires S|T present for every included T.
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#define N 5
#define M (1<<N)
static int order[M];
static uint32_t cur = 0;
static FILE *out;
static long long cnt = 0;
static int cmp(const void *a, const void *b) {
    int x = *(const int*)a, y = *(const int*)b;
    int px = __builtin_popcount(x), py = __builtin_popcount(y);
    if (px != py) return py - px;
    return x - y;
}
static void rec(int k) {
    if (k == M) { fwrite(&cur, 4, 1, out); cnt++; return; }
    int S = order[k];
    // exclude
    rec(k + 1);
    // include: check closure with all previously included sets
    uint32_t c = cur;
    int ok = 1;
    for (int T = 0; T < M && ok; T++) if (c >> T & 1) { if (!(c >> (S | T) & 1)) ok = 0; }
    if (ok) { cur |= 1u << S; rec(k + 1); cur &= ~(1u << S); }
}
int main(int argc, char **argv) {
    for (int i = 0; i < M; i++) order[i] = i;
    qsort(order, M, sizeof(int), cmp);
    out = fopen(argc > 1 ? argv[1] : "uc5.bin", "wb");
    rec(0);
    fclose(out);
    printf("%lld families (including the empty family)\n", cnt);
    return 0;
}

# ===== poonen_lp.py =====
"""Exact Poonen-criterion LP on [5] using the complete list of union-closed families (uc5.bin).

Two constraint classes are compared for a generator family A (given as a list of subsets of [5]):
  'poonen'  : UC families B subset P(X) with B ⊎ A ⊆ B  (Poonen 1992, Thm 1 as stated in
              Bruhn-Schaudt Thm 16 and Pulaj 2018 Thm 1); B need NOT contain A.
  'recalled': UC families H with A subset H subset P(X)  (the class described in idea c964f565).
X is either the universe U(A) ('universe') or all of [5] ('full').
Value t = max_c min_B ( sum_i c_i |B_i| - |B|/2 )      (unnormalised)
      tn = max_c min_B ( sum_i c_i |B_i|/|B| - 1/2 )   (normalised)
A is FC iff t >= 0 (Poonen), equivalently tn >= 0.
"""
import sys, itertools
import numpy as np
from scipy.optimize import linprog

N = 5
M = 1 << N
FAMS = np.fromfile('/home/ubuntu/crit/uc5.bin', dtype=np.uint32)
FAMS = FAMS[FAMS != 0]                       # drop the empty family
BITS = np.arange(M, dtype=np.uint32)
ELEM = [np.uint32(sum(1 << s for s in range(M) if s >> i & 1)) for i in range(N)]

def popcount(x):
    x = x.astype(np.uint64)
    return np.array([bin(v).count('1') for v in x]) if len(x) < 64 else _popc(x)

def _popc(x):
    x = x.astype(np.uint64)
    x = x - ((x >> np.uint64(1)) & np.uint64(0x5555555555555555))
    x = (x & np.uint64(0x3333333333333333)) + ((x >> np.uint64(2)) & np.uint64(0x3333333333333333))
    x = (x + (x >> np.uint64(4))) & np.uint64(0x0f0f0f0f0f0f0f0f)
    return ((x * np.uint64(0x0101010101010101)) >> np.uint64(56)).astype(np.int64)

def setmask(s):  # s: iterable of elements 1..5 -> bit index
    return sum(1 << (i - 1) for i in s)

def family_class(A, cls, uni):
    A = [setmask(s) for s in A]
    X = 0
    for s in A: X |= s
    if uni == 'full': X = M - 1
    allowed = np.uint32(sum(1 << s for s in range(M) if (s & ~X) == 0))
    fam = FAMS[(FAMS & ~allowed) == 0]
    if cls == 'recalled':
        Amask = np.uint32(sum(1 << s for s in A))
        return fam[(fam & Amask) == Amask]
    ok = np.ones(len(fam), dtype=bool)
    for S in A:
        for b in range(M):
            has_b = (fam >> np.uint32(b)) & 1
            has_bS = (fam >> np.uint32(b | S)) & 1
            ok &= ~((has_b == 1) & (has_bS == 0))
    return fam[ok]

def features(fam):
    cols = [_popc(fam & E) for E in ELEM]
    return np.stack(cols, axis=1).astype(float), _popc(fam).astype(float)

def solve(A, cls='poonen', uni='universe', normalised=False):
    fam = family_class(A, cls, uni)
    if len(fam) == 0:
        return None, None, fam, None
    Nmat, size = features(fam)
    if normalised:
        Nmat = Nmat / size[:, None]; rhs = np.full(len(fam), 0.5)
    else:
        rhs = size / 2
    n = N
    # variables: c_1..c_5, t ; maximise t  -> minimise -t
    cobj = np.zeros(n + 1); cobj[-1] = -1
    active = np.arange(min(len(fam), 200))
    bounds = [(0, None)] * n + [(None, None)]
    for it in range(200):
        Aub = np.hstack([-Nmat[active], np.ones((len(active), 1))])
        bub = -rhs[active]
        res = linprog(cobj, A_ub=Aub, b_ub=bub, A_eq=[[1] * n + [0]], b_eq=[1], bounds=bounds, method='highs')
        c = res.x[:n]; t = res.x[-1]
        margin = Nmat @ c - rhs
        worst = np.argsort(margin)[:50]
        if margin[worst[0]] >= t - 1e-9:
            return t, c, fam, margin
        active = np.union1d(active, worst)
    raise RuntimeError('no convergence')

def fmt(s): return ''.join(str(i) for i in s) if s else '∅'

if __name__ == '__main__':
    tests = {
        '{1}': [[1]], '{12}': [[1, 2]], '{123}': [[1, 2, 3]], '{123,124}': [[1, 2, 3], [1, 2, 4]],
        '{123,124,134}': [[1, 2, 3], [1, 2, 4], [1, 3, 4]],
        'four 3-subsets of [4]': [[1, 2, 3], [1, 2, 4], [1, 3, 4], [2, 3, 4]],
        '{123,124,135}': [[1, 2, 3], [1, 2, 4], [1, 3, 5]],
        '{123,145,245}': [[1, 2, 3], [1, 4, 5], [2, 4, 5]],
        '{123,345,1245}': [[1, 2, 3], [3, 4, 5], [1, 2, 4, 5]],
        '{123,145}': [[1, 2, 3], [1, 4, 5]], '{1234}': [[1, 2, 3, 4]],
        '{1234,1235,1245}': [[1, 2, 3, 4], [1, 2, 3, 5], [1, 2, 4, 5]],
        '{1234,1235,1245,1345,2345}': [[1, 2, 3, 4], [1, 2, 3, 5], [1, 2, 4, 5], [1, 3, 4, 5], [2, 3, 4, 5]],
        '{123,345}': [[1, 2, 3], [3, 4, 5]],
    }
    print(f"{'A':28s} {'cls':8s} {'uni':8s} {'#B':>8s} {'t':>9s} {'tn':>9s}  c")
    for name, A in tests.items():
        for cls in ['poonen', 'recalled']:
            for uni in ['universe', 'full']:
                t, c, fam, _ = solve(A, cls, uni)
                tn, cn, _, _ = solve(A, cls, uni, normalised=True)
                print(f"{name:28s} {cls:8s} {uni:8s} {len(fam):8d} {t:9.4f} {tn:9.4f}  {np.round(c,3)}")
        sys.stdout.flush()

