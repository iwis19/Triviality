# Check: union-closure of C_m edges == {S nonempty: every v in S has neighbour in S};
# count F ∩ up(e), e = V \ N[x], split by x; also m=4 count.
import itertools
def edge_closure(m):
    edges=[frozenset({i,(i+1)%m}) for i in range(m)]
    F=set(edges); 
    while True:
        new={a|b for a in F for b in F}-F
        if not new: break
        F|=new
    return F
def noiso(m):
    V=range(m); out=set()
    for r in range(1,m+1):
        for S in itertools.combinations(V,r):
            S=frozenset(S)
            if all(((v+1)%m in S) or ((v-1)%m in S) for v in S): out.add(S)
    return out
for m in range(3,13):
    F=edge_closure(m); G=noiso(m)
    assert F==G, m
    x=0
    Nx={(x-1)%m,x,(x+1)%m}
    e=frozenset(range(m))-Nx
    up=[A for A in F if e<=A]
    without=sum(1 for A in up if x not in A); withx=sum(1 for A in up if x in A)
    print(m, len(F), "|e|=",len(e), "up(e): avoid x =",without, "contain x =",withx)
