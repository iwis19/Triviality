import Mathlib

open Finset

/-- Notation matching the formal-conjectures statement of Erdős #686:
`N = (∏_{i=1}^k (m+i)) / (∏_{i=1}^k (n+i))` as rationals, with natural-number products. -/
def Erdos686Rep (N k n m : ℕ) : Prop :=
  (N : ℚ) = ((∏ i ∈ Icc 1 k, (m + i) : ℕ) : ℚ) / ((∏ i ∈ Icc 1 k, (n + i) : ℕ) : ℚ)

/-- Clearing denominators: a representation is the integer identity `N * ∏(n+i) = ∏(m+i)`. -/
theorem Erdos686Rep.eq_nat {N k n m : ℕ} (h : Erdos686Rep N k n m) :
    N * ∏ i ∈ Icc 1 k, (n + i) = ∏ i ∈ Icc 1 k, (m + i) := by
  unfold Erdos686Rep at h
  have hne : ((∏ i ∈ Icc 1 k, (n + i) : ℕ) : ℚ) ≠ 0 := by
    norm_cast
    exact Finset.prod_ne_zero_iff.mpr (fun i hi => by have := (Finset.mem_Icc.mp hi).1; omega)
  rw [eq_div_iff hne] at h
  exact_mod_cast h

/-- Prime-free window lemma: if `N = ∏(m+i)/∏(n+i)` and `p` is a prime with `p > n + k` and
`p ∤ N`, then `p` divides none of `m+1, …, m+k`. In particular, in any representation of a prime
power `N = q^e` with `m ≥ n + k ≥ 2`, all of `m+1, …, m+k` are composite. -/
theorem Erdos686Rep.not_dvd_window {N k n m p : ℕ} (h : Erdos686Rep N k n m)
    (hp : p.Prime) (hpN : ¬ p ∣ N) (hpn : n + k < p) :
    ¬ p ∣ ∏ i ∈ Icc 1 k, (m + i) := by
  intro hdiv
  rw [← h.eq_nat] at hdiv
  rcases (Nat.Prime.dvd_mul hp).mp hdiv with h1 | h2
  · exact hpN h1
  · obtain ⟨i, hi, hpi⟩ := (Prime.dvd_finset_prod_iff hp.prime _).mp h2
    have h3 := Nat.le_of_dvd (by have := (Finset.mem_Icc.mp hi).1; omega) hpi
    have h4 := (Finset.mem_Icc.mp hi).2
    omega

/-- Consequence: each `m + i` (1 ≤ i ≤ k) that is prime must divide `N`, provided `m + i > n + k`. -/
theorem Erdos686Rep.prime_in_window_dvd {N k n m i : ℕ} (h : Erdos686Rep N k n m)
    (hi : i ∈ Icc 1 k) (hprime : (m + i).Prime) (hbig : n + k < m + i) : (m + i) ∣ N := by
  by_contra hnd
  exact h.not_dvd_window hprime hnd hbig (Finset.dvd_prod_of_mem _ hi)

/-- Sanity examples in the same shape: `9 = 26·27·28/(12·13·14)` and `16 = 14·15·16/(5·6·7)`
(both with `k = 3`, `m ≥ n + 3`). -/
example : Erdos686Rep 9 3 11 25 := by
  unfold Erdos686Rep
  rw [show Icc 1 3 = ({1, 2, 3} : Finset ℕ) by decide]
  norm_num

example : Erdos686Rep 16 3 4 13 := by
  unfold Erdos686Rep
  rw [show Icc 1 3 = ({1, 2, 3} : Finset ℕ) by decide]
  norm_num
