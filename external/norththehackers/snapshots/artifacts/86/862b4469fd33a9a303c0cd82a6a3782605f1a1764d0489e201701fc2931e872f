"""Poonen-type LP test for FC-families on [5], using the exhaustive list of union-closed families on [5].
Criterion used (Poonen 1992, as we recall it; to be re-checked against the paper):
  G subset 2^[k] is FC  iff  exists c >= 0 on [k], sum c = 1, such that for every union-closed H with G subset H subset 2^[k],
  sum_{A in H} c(A) >= |H|/2.
We solve  max t  s.t.  cnt_H . c - |H|/2 >= t  for all H containing G,  sum c = 1, c >= 0,  by cutting planes.
Output: optimal t (G is FC iff t >= 0), the optimal weights, and the tight witness families H."""
import numpy as np, sys
from scipy.optimize import linprog

n = 5; N = 1 << n
fams = np.fromfile('/home/ubuntu/ucs/fam5.bin', dtype=np.uint32)
fams = fams[fams > 1]
bits = ((fams[:, None] >> np.arange(N, dtype=np.uint32)[None, :]) & 1).astype(np.int8)  # membership of each subset
elem = np.array([[ (s >> x) & 1 for x in range(n)] for s in range(N)], dtype=np.int8)
cnt = bits @ elem  # (#fams, n): cnt[x] = number of sets in H containing x
ksz = bits.sum(axis=1)

def setmask(*sets):
    m = 0
    for s in sets:
        b = 0
        for x in s: b |= 1 << (x - 1)
        m |= 1 << b
    return m

def poonen(G_sets, label):
    G = setmask(*G_sets)
    sel = (fams & np.uint32(G)) == np.uint32(G)
    C = cnt[sel].astype(float); K = ksz[sel].astype(float)
    idx = list(range(min(50, len(C))))
    for it in range(200):
        # variables: c_1..c_n, t ; maximize t
        A_ub = []; b_ub = []
        for i in idx:
            row = list(-C[i]) + [1.0]; A_ub.append(row); b_ub.append(-K[i] / 2)
        res = linprog(c=[0] * n + [-1], A_ub=A_ub, b_ub=b_ub, A_eq=[[1] * n + [0]], b_eq=[1],
                      bounds=[(0, None)] * n + [(None, None)], method='highs')
        c = res.x[:n]; t = res.x[n]
        slack = C @ c - K / 2
        worst = int(np.argmin(slack))
        if slack[worst] >= t - 1e-9: break
        idx.append(worst)
    tight = np.where(slack <= slack.min() + 1e-9)[0]
    ex = fams[sel][tight[0]]
    exs = [tuple(x + 1 for x in range(n) if (s >> x) & 1) for s in range(N) if (ex >> s) & 1]
    print(f"G={label}: #H containing G = {sel.sum()}, optimal t = {t:.4f} -> {'FC' if t >= -1e-9 else 'NOT FC'}; "
          f"weights c = {np.round(c, 4)}; #tight H = {len(tight)}; one tight H (|H|={len(exs)}): {exs}")

poonen([(1,)], "{1}")
poonen([(1, 2)], "{12}")
poonen([(1, 2, 3)], "{123}")
poonen([(1, 2, 3), (1, 2, 4)], "{123,124}")
poonen([(1, 2, 3), (1, 2, 4), (1, 3, 4)], "{123,124,134}")
poonen([(1, 2, 3), (1, 2, 4), (1, 3, 4), (2, 3, 4)], "all 3-subsets of [4]")
poonen([(1, 2, 3), (1, 4, 5)], "{123,145}")
poonen([(1, 2, 3), (1, 2, 4), (1, 3, 5)], "{123,124,135}")
poonen([(1, 2, 3), (1, 4, 5), (2, 4, 5)], "{123,145,245}")
poonen([(1, 2, 3), (3, 4, 5), (1, 2, 4, 5)], "{123,345,1245}")
poonen([(1, 2, 3, 4)], "{1234}")
poonen([(1, 2, 3, 4), (1, 2, 3, 5), (1, 2, 4, 5)], "{1234,1235,1245}")
