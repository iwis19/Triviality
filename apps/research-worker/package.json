{
  "name": "@triviality/research-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @triviality/database build",
    "dev": "tsx watch src/worker.ts",
    "start": "node dist/worker.js",
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@triviality/database": "workspace:*",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
