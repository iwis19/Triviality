# Copy this template to .env in this directory and fill in your credentials.
# Keep real API keys in .env only; this example file is tracked by Git.
# Each role has its own model dropdown. Configure only the providers you use.

# -----------------------------------------------------------------------------
# Model providers — credentials for the named role dropdown options
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Qwen / Alibaba Model Studio
QWEN_API_KEY=

# Devin — autonomous agent sessions
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_BASE_URL=https://api.devin.ai
# Maximum ACUs per Devin session (separate from the model token budget).
DEVIN_MAX_ACU=2
# Optional v3 session controls. Normal mode is the default autonomous agent.
DEVIN_MODE=normal
DEVIN_SESSION_TIMEOUT_SECONDS=840
DEVIN_POLL_INTERVAL_SECONDS=10
# Optional service-user attribution to a specific Devin user/plan.
DEVIN_CREATE_AS_USER_ID=

# Named providers already have their API addresses configured in the application.
# Optional overrides, only if needed (for example, your Qwen account's region):
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# -----------------------------------------------------------------------------
# WorkSwarm — orchestration shared by every research run
# -----------------------------------------------------------------------------
# WorkSwarm needs no separate API key. Role models come from the dropdowns.
# Default when a research request omits tokenBudget (UI allows 10,000–1,000,000).
# Research uses up to 65%; the remainder is reserved for proof writing/repair.
SWARM_TOKEN_BUDGET=60000
SWARM_MAX_OUTPUT_TOKENS=4096
SWARM_TIMEOUT_MS=900000
# Optional Python executable override; defaults to this project's .venv.
SWARM_PYTHON=
# Optional Lean executable override. Blank auto-detects Lean 4.19.0 installed by
# elan (including ELAN_HOME), then the local Windows toolchain, then PATH.
SWARM_LEAN_BIN=

# -----------------------------------------------------------------------------
# Local application and data services
# -----------------------------------------------------------------------------
TRIVIALITY_URL=http://localhost:3000
RESEARCH_API_PORT=3010
RESEARCH_API_URL=http://localhost:3010
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=triviality
REDIS_URL=redis://localhost:6379
ARTIFACT_ROOT=.data/object-storage

# Optional bounded experiment worker. Leave URL blank to disable experiment calls.
# For local service or an SSH tunnel to Vultr: http://127.0.0.1:8090
EXPERIMENT_API_URL=
# Same random secret as the remote service; keep this server-side.
EXPERIMENT_API_KEY=
# Optional hosted Lean checker; blank URL keeps local checking.
# experiments:worker configures both automatically through the same SSH tunnel.
LEAN_API_URL=
LEAN_API_KEY=

# -----------------------------------------------------------------------------
# Literature ingestion — OpenAlex
# -----------------------------------------------------------------------------
OPENALEX_EMAIL=
OPENALEX_WORKS_FILTER=type:article,primary_topic.field.id:26
OPENALEX_PER_PAGE=100
OPENALEX_AREA_LIMIT=0
OPENALEX_REQUEST_DELAY_MS=250
INGEST_INTERVAL_MINUTES=1440
RUN_ON_START=true

# -----------------------------------------------------------------------------
# Embeddings — literature indexing, separate from research role models
# -----------------------------------------------------------------------------
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
# Falls back to OPENAI_API_KEY when empty.
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# Legacy Lean checker settings — WorkSwarm uses SWARM_LEAN_BIN above
# -----------------------------------------------------------------------------
LEAN_PROJECT_DIR=external/norththehackers/lean
LEAN_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Imported MathLab backend — pnpm backend:dev (separate from the research API)
# -----------------------------------------------------------------------------
# Optional Python executable override; defaults to this project's .venv.
BACKEND_PYTHON=
MATHLAB_OWNER_API_KEY=change-me-owner-key
MATHLAB_DEVIN_PROVIDER=mock
MATHLAB_DEVIN_API_KEY=
MATHLAB_DEVIN_ORG_ID=
MATHLAB_DEVIN_CREATE_AS_USER_ID=
MATHLAB_DEVIN_MAX_ACU_LIMIT=5
MATHLAB_PUBLIC_BASE_URL=http://localhost:8000
MATHLAB_SCHEDULER_ENABLED=false
MATHLAB_SCHEDULER_INTERVAL_SECONDS=60
# The database, artifacts, and Lean project default to paths inside
# external/norththehackers. Leave them unset to use those defaults.
# MATHLAB_LEAN_PROJECT_DIR=  # Empty disables the optional Mathlib checker.
